---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  titulo: string;
  descricao: string;
  /** Sobrescreve a URL canônica. Por padrão usa a URL da própria página. */
  canonica?: string;
  /** Bloqueia indexação — usar em páginas de rascunho e de agradecimento. */
  semIndexar?: boolean;
  /** Objetos schema.org injetados como JSON-LD. */
  dadosEstruturados?: Record<string, unknown>[];
  imagem?: string;
  /** Header flutua por cima do primeiro bloco (usado só na home). */
  headerSobreposto?: boolean;
  /**
   * Sem o Header e o Footer do site — para telas que são APLICATIVO,
   * não página (o editor de mapas). A casca própria da tela assume a
   * navegação; head, fontes e analytics continuam daqui.
   */
  semCasca?: boolean;
}

/**
 * Imagem de compartilhamento padrao: 1200x630, JPG.
 *
 * JPG e nao PNG porque a arte tem fotografia — em PNG ela passava de 500 KB, e
 * acima de ~300 KB o WhatsApp desiste do preview grande. WebP nao serve: varios
 * scrapers de rede social nao leem o formato.
 */
const OG_PADRAO = "/og-padrao.jpg";

const {
  titulo,
  descricao,
  canonica,
  semIndexar = false,
  dadosEstruturados = [],
  imagem = OG_PADRAO,
  headerSobreposto = false,
  semCasca = false,
} = Astro.props;

const urlCanonica = canonica ?? new URL(Astro.url.pathname, Astro.site).href;
const urlImagem = new URL(imagem, Astro.site).href;

// O título da home não repete o nome do site.
const tituloCompleto =
  Astro.url.pathname === "/" ? titulo : `${titulo} | Comunidade Airsoft`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b0d09" />
    <meta name="color-scheme" content="dark" />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={urlCanonica} />
    {semIndexar && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Comunidade Airsoft" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagem} />
    {/*
      Largura e altura declaradas: sem elas o WhatsApp precisa baixar a imagem
      para descobrir o tamanho e, no meio disso, costuma cair no preview
      pequeno. Com elas, ele ja monta o cartao grande.

      So valem para a imagem padrao — anunciar 1200x630 para uma capa de outro
      tamanho e pior do que nao anunciar nada, porque o scraper acredita.
    */}
    {
      imagem === OG_PADRAO && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:image:alt" content={tituloCompleto} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={urlImagem} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Share+Tech+Mono&display=swap"
      rel="stylesheet"
    />

    {
      dadosEstruturados.map((dado) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(dado)}
        />
      ))
    }
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-DPZBLNXLEK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-DPZBLNXLEK");
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-fundo text-tinta">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-oliva-500 focus:px-5 focus:py-3 focus:text-fundo focus:font-display focus:uppercase"
    >
      Pular para o conteúdo
    </a>

    {!semCasca && <Header sobreposto={headerSobreposto} />}

    <main id="conteudo" class="flex-1">
      <slot />
    </main>

    {!semCasca && <Footer />}
  </body>
</html>
