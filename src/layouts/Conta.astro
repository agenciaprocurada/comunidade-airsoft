---
import Base from "./Base.astro";
import IconeNav from "../components/conta/IconeNav.astro";
import ItemNav from "../components/conta/ItemNav.astro";
import { EQUIPES_VISIVEIS } from "../lib/flags";

/**
 * Casca da área logada.
 *
 * Desktop: coluna lateral fixa. Separa os dois níveis — sair da conta
 * para o site continua sendo o Header — e aguenta a lista crescer.
 *
 * Celular: a mesma lista virou UM seletor de seção. A tentativa
 * anterior espalhava os itens numa grade que quebrava em linha e
 * ocupava quatro fileiras irregulares antes do título da página; para
 * quem modera, sete. Duas navegações empilhadas (o MENU do site e a
 * nuvem de atalhos da conta) logo na primeira dobra, e a única pista
 * de "onde eu estou" era um fundo escuro quase igual ao da página.
 *
 * Agora a barra mostra a seção atual e abre a lista inteira por cima
 * do conteúdo — uma linha em vez de quatro, o mesmo gesto do menu do
 * site, e nenhum item escondido. Feito com <details>: abre sem
 * JavaScript, que aqui é decisão de acesso e não de gosto (muita
 * gente abre o site no campo, com sinal ruim).
 */
interface Props {
  titulo: string;
  descricao: string;
  /** Texto curto abaixo do título da página. */
  resumo?: string;
}

const { titulo, descricao, resumo } = Astro.props;
const { usuario, perfil, admin, paginas } = Astro.locals;

/**
 * Ordem do menu. "Painel" e "Meu perfil" viraram um item só: o painel
 * era um índice de coisas que já estão na navegação ao lado, então
 * duplicava a própria barra.
 *
 * `href: null` = seção anunciada mas ainda não construída.
 *
 * "Minhas páginas" só entra para quem já teve alguma reivindicação
 * aprovada — quem não tem campo nem loja não precisa da seção.
 */
const secoes = [
  { href: "/conta", texto: "Meu perfil", icone: "perfil" as const },
  // Equipes está escondida (src/lib/flags.ts). Volta ao menu quando a flag voltar.
  ...(EQUIPES_VISIVEIS
    ? [{ href: "/conta/equipes", texto: "Equipes", icone: "equipes" as const }]
    : []),
  // Réplicas viraram uma seção dentro de Meu perfil (/conta#replicas).
  // "Minhas operações" e não "Meus eventos": o produto se apresenta como
  // Organizador de Operações (/organizador-de-operacoes) e o vocabulário do
  // site é operação. Só o rótulo mudou — URL, banco e schema seguem iguais.
  { href: "/conta/operacoes", texto: "Minhas operações", icone: "operacoes" as const },
  { href: "/conta/mapas", texto: "Meus mapas", icone: "mapas" as const },
  ...(paginas > 0
    ? [{ href: "/conta/reivindicacoes", texto: "Minhas páginas", icone: "paginas" as const }]
    : []),
];

const moderacao = admin
  ? [
      { href: "/conta/admin/reivindicacoes", texto: "Reivindicações", icone: "moderacao" as const },
      { href: "/conta/admin/diretorio", texto: "Diretório", icone: "paginas" as const },
      { href: "/conta/admin/usuarios", texto: "Usuários", icone: "usuarios" as const },
    ]
  : [];

const atual = Astro.url.pathname;
const ativo = (href: string | null) =>
  href === null ? false : href === "/conta" ? atual === "/conta" : atual.startsWith(href);

/**
 * O que a barra do celular mostra fechada. Telas fora do menu
 * (/conta/completar, um formulário solto) caem no rótulo genérico em
 * vez de mentir que estão numa seção.
 */
const secaoAtual = [...secoes, ...moderacao].find((secao) => ativo(secao.href)) ?? {
  texto: "Minha conta",
  icone: "perfil" as const,
};

const nome = perfil?.nome ?? usuario?.email ?? "jogador";
const inicial = nome.trim().charAt(0).toUpperCase();

const CLASSE_SAIR =
  "flex w-full cursor-pointer items-center text-texto-2 transition-colors duration-150 " +
  "hover:text-alerta focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-oliva-300";

const CLASSE_GRUPO = "font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2";
---

<Base titulo={titulo} descricao={descricao} semIndexar={true}>
  <div class="mx-auto max-w-[1240px] px-5 md:px-12">
    <div class="lg:grid lg:grid-cols-[14.5rem_minmax(0,1fr)] lg:gap-12">
      <!-- ================= Celular: seletor de seção ================= -->
      <nav aria-label="Minha conta" class="relative z-20 pt-5 lg:hidden">
        <details class="group relative sm:max-w-[24rem]" data-menu-conta>
          <summary
            class="flex cursor-pointer list-none items-center gap-3 border border-borda-forte bg-papel px-4 py-3 text-[1rem] leading-tight text-tinta transition-colors duration-150 hover:border-oliva-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oliva-300 [&::-webkit-details-marker]:hidden"
          >
            <IconeNav nome={secaoAtual.icone} class="h-[1.3rem] w-[1.3rem] text-oliva-300" />
            <span class="min-w-0 flex-1 truncate font-semibold">{secaoAtual.texto}</span>

            {
              perfil?.foto_url ? (
                <img
                  src={perfil.foto_url}
                  alt=""
                  width="28"
                  height="28"
                  referrerpolicy="no-referrer"
                  class="octogono h-7 w-7 shrink-0 bg-oliva-050 object-cover"
                />
              ) : (
                <span class="octogono flex h-7 w-7 shrink-0 items-center justify-center bg-oliva-050 text-[0.8125rem] font-semibold text-hud">
                  {inicial}
                </span>
              )
            }

            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-4 w-4 shrink-0 text-texto-2 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="square"></path>
            </svg>
          </summary>

          <div
            class="absolute inset-x-0 top-[calc(100%+0.375rem)] z-20 border border-borda-forte bg-papel shadow-[0_20px_60px_rgba(0,0,0,0.6)]"
          >
            <!-- Quem está logado. Sai da página e vem para cá, junto do
                 "sair": é onde as pessoas procuram as duas coisas. -->
            <div class="flex items-center gap-3 border-b border-borda px-4 py-3">
              {
                perfil?.foto_url ? (
                  <img
                    src={perfil.foto_url}
                    alt=""
                    width="36"
                    height="36"
                    referrerpolicy="no-referrer"
                    class="octogono h-9 w-9 shrink-0 bg-oliva-050 object-cover"
                  />
                ) : (
                  <span class="octogono flex h-9 w-9 shrink-0 items-center justify-center bg-oliva-050 text-[0.9375rem] font-semibold text-hud">
                    {inicial}
                  </span>
                )
              }
              <div class="min-w-0 flex-1">
                <p class="truncate text-[0.9375rem] font-semibold leading-tight text-tinta">
                  {nome}
                </p>
                <p class="truncate text-[0.8125rem] leading-tight text-texto-2">
                  {usuario?.email}
                </p>
              </div>
            </div>

            <ul class="py-1">
              {
                secoes.map((secao) => (
                  <li>
                    <ItemNav {...secao} ativo={ativo(secao.href)} />
                  </li>
                ))
              }
            </ul>

            {
              moderacao.length > 0 && (
                <div class="border-t border-borda pb-1 pt-2">
                  <p class:list={[CLASSE_GRUPO, "px-4 pb-1"]}>Moderação</p>
                  <ul>
                    {moderacao.map((secao) => (
                      <li>
                        <ItemNav {...secao} ativo={ativo(secao.href)} />
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <!-- Fora da lista de seções e por último: sair não é um
                 lugar para ir. Antes ficava no alto da tela, colado no
                 MENU do site — o pior canto possível para um botão que
                 derruba a sessão. -->
            <form method="POST" action="/auth/sair" class="border-t border-borda">
              <button type="submit" class:list={[CLASSE_SAIR, "gap-3 px-4 py-3.5 text-[1rem]"]}>
                <IconeNav nome="sair" class="h-[1.3rem] w-[1.3rem]" />
                Sair da conta
              </button>
            </form>
          </div>
        </details>
      </nav>

      <!-- ================= Desktop: coluna lateral ================= -->
      <div class="hidden lg:sticky lg:top-24 lg:block lg:self-start lg:py-12">
        <div class="flex items-center gap-3 pb-6">
          {
            perfil?.foto_url ? (
              <img
                src={perfil.foto_url}
                alt=""
                width="44"
                height="44"
                referrerpolicy="no-referrer"
                class="octogono h-11 w-11 shrink-0 bg-oliva-050 object-cover"
              />
            ) : (
              <span class="octogono flex h-11 w-11 shrink-0 items-center justify-center bg-oliva-050 text-[1.0625rem] font-semibold text-hud">
                {inicial}
              </span>
            )
          }
          <div class="min-w-0 flex-1">
            <p class="truncate text-[0.9375rem] font-semibold leading-tight text-tinta">
              {nome}
            </p>
            <p class="truncate text-[0.8125rem] leading-tight text-texto-2">
              {usuario?.email}
            </p>
          </div>
        </div>

        <nav aria-label="Minha conta" class="mt-2">
          <ul class="flex flex-col gap-0.5">
            {
              secoes.map((secao) => (
                <li>
                  <ItemNav {...secao} ativo={ativo(secao.href)} denso />
                </li>
              ))
            }

            {
              moderacao.length > 0 && (
                <>
                  <li aria-hidden="true" class="mb-1 mt-4 h-px w-full bg-borda" />
                  <li>
                    <p class:list={[CLASSE_GRUPO, "px-3 pb-1"]}>Moderação</p>
                  </li>
                  {moderacao.map((secao) => (
                    <li>
                      <ItemNav {...secao} ativo={ativo(secao.href)} denso />
                    </li>
                  ))}
                </>
              )
            }
          </ul>
        </nav>

        <form method="POST" action="/auth/sair" class="mt-6 border-t border-borda pt-4">
          <button type="submit" class:list={[CLASSE_SAIR, "gap-2.5 px-3 py-1 text-[0.9375rem]"]}>
            <IconeNav nome="sair" class="h-[1.15rem] w-[1.15rem]" />
            Sair da conta
          </button>
        </form>

        <!-- Convite para o grupo oficial: só no desktop, onde a coluna
             tem espaço sobrando embaixo da navegação. No celular quem
             faz esse convite é a barra fixa do rodapé. -->
        <div class="mt-8 border border-borda bg-gradient-to-b from-oliva-050 to-papel/40 p-4">
          <p class="text-[0.9375rem] font-semibold leading-snug text-tinta">
            Faça parte da comunidade
          </p>
          <p class="mt-1.5 text-[0.8125rem] leading-snug text-texto-2">
            Participe de discussões, compartilhe experiências e evolua no jogo.
          </p>
          <a
            href="https://chat.whatsapp.com/GbZdm2rFiTD6vLi0FpLpfW"
            target="_blank"
            rel="noopener"
            class="mt-3.5 inline-flex items-center gap-2 border border-oliva-500 px-3 py-2 font-dado text-[0.75rem] font-semibold uppercase leading-none tracking-[0.1em] text-oliva-300 transition-colors duration-150 hover:bg-oliva-050 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oliva-300"
          >
            Ir para a comunidade
          </a>
        </div>
      </div>

      <!-- ================= Conteúdo ================= -->
      <div class="min-w-0 py-8 lg:py-12">
        <header>
          <h1
            class="font-display text-[1.75rem] font-bold uppercase leading-none tracking-[0.01em] text-tinta md:text-[2rem]"
          >
            {titulo}
          </h1>
          {
            resumo && (
              <p class="mt-3 max-w-[68ch] text-[1.0625rem] leading-relaxed text-texto-2">
                {resumo}
              </p>
            )
          }
        </header>

        <slot />
      </div>
    </div>
  </div>
</Base>

<script>
  /*
   * Enfeite em cima do <details>, que já abre e fecha sozinho: fechar
   * tocando fora e no Esc. Sem isso a gaveta continua funcionando —
   * fecha tocando na barra de novo.
   */
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu-conta]");

  if (menu) {
    document.addEventListener("click", (evento) => {
      if (menu.open && !menu.contains(evento.target as Node)) menu.open = false;
    });

    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
