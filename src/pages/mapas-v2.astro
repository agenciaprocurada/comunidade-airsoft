---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Botao from "../components/Botao.astro";
import exemploSatelite from "../assets/mapas/exemplo-mapa-tatico-airsoft-satelite.webp";
import exemploIlustrado from "../assets/mapas/exemplo-mapa-tatico-airsoft-ilustrado.webp";
import capaVideo from "../assets/mapas/video-criador-de-mapas-airsoft.webp";
import terrenoAereo from "../assets/mapas/terreno-aereo-mapas-v2.webp";
import { FORMATOS, LIMITE_MAPAS } from "../lib/mapa";
import { SIMBOLOS } from "../lib/simbolos";

const passos = [
  { titulo: "Encontre seu campo", texto: "Busque o local ou cole as coordenadas. Ajuste o zoom e gire a imagem de satélite para enquadrar o terreno." },
  { titulo: "Marque o plano de jogo", texto: "Desenhe áreas, trace rotas e posicione safe, respawn e objetivos. Use a grade para combinar posições pelo rádio." },
  { titulo: "Leve para o briefing", texto: "Exporte em PNG, envie no grupo ou imprima. O projeto fica salvo na conta para você preparar o próximo jogo." },
];
const perguntas = [
  { p: "É gratuito mesmo?", r: "Sim. O criador e a conta da Comunidade Airsoft são gratuitos. Você não precisa informar cartão." },
  { p: "O que preciso para começar?", r: "Entre com o Google, complete seu perfil e cadastre ao menos uma réplica. Essas etapas liberam as ferramentas da comunidade. Se você já fez isso, o botão abre o editor." },
  { p: "Posso criar pelo celular?", r: "O editor abre no celular, mas foi pensado para telas grandes. Recomendamos o computador para desenhar e organizar o mapa. Depois, você pode consultar e compartilhar o PNG pelo celular." },
  { p: "Preciso saber desenhar ou instalar algum programa?", r: "Não. A ferramenta funciona no navegador e já traz a imagem de satélite. Você marca os cantos das áreas, traça rotas e posiciona os símbolos com as ferramentas do editor." },
  { p: "Posso salvar e editar depois?", r: `Sim. Você pode manter até ${LIMITE_MAPAS} mapas na sua conta e reabrir o projeto para alterar áreas, rotas e objetivos. O PNG exportado é a imagem para compartilhar; para continuar editando, use o projeto salvo.` },
  { p: "Como compartilho com os jogadores?", r: "Exporte o mapa em PNG e envie a imagem pelo WhatsApp ou imprima para o briefing. Os jogadores não precisam de conta para visualizar a imagem que você enviou." },
];
const destaques = [
  { nome: "Safe", simbolo: SIMBOLOS.safe },
  { nome: "Respawn", simbolo: SIMBOLOS.respawn },
  { nome: "CQB", simbolo: SIMBOLOS.cqb },
  { nome: "Base", simbolo: SIMBOLOS.base },
];
---

<Base titulo="Criador de mapas táticos de airsoft — versão 2" descricao="Prepare o briefing com um mapa do seu campo: marque áreas, rotas e objetivos sobre o satélite e compartilhe em PNG. Gratuito, no navegador." semIndexar semConviteWhatsApp>
  <div class="mapas-v2">
    <section class="hero" aria-labelledby="titulo-mapas">
      <div class="hero-backdrop" aria-hidden="true"><Image src={terrenoAereo} alt="" widths={[640, 960, 1536]} sizes="100vw" loading="eager" /></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Criador de mapas táticos / Gratuito</p>
          <h1 id="titulo-mapas">O campo é real.<br /><span>O plano é seu.</span></h1>
          <p class="intro">Mostre onde começa, por onde avança e qual é o objetivo. Monte seu mapa sobre a imagem de satélite e mande no grupo antes do jogo.</p>
          <div class="actions">
            <Botao href="/mapa">Criar meu mapa grátis <span aria-hidden="true">→</span></Botao>
            <a class="text-link" href="#demonstracao"><span aria-hidden="true">▷</span> Ver demonstração de 15s</a>
          </div>
          <p class="access-note">Acesso com Google, perfil completo e uma réplica cadastrada. <a href="#acesso">Entenda as etapas</a>.</p>
          <div class="hero-notes"><span>Sem instalar nada</span><span>Melhor no computador</span></div>
        </div>
        <figure class="hero-map">
          <div class="frame-top"><span><span class="status-dot" aria-hidden="true"></span> Seu próximo plano de jogo</span><span>Prévia de resultado</span></div>
          <div class="map-switch" hidden aria-label="Escolher exemplo de mapa"><button type="button" data-map-view="satelite" aria-pressed="true" aria-controls="preview-satelite">Satélite</button><button type="button" data-map-view="ilustrado" aria-pressed="false" aria-controls="preview-ilustrado">Ilustrado</button><span>Explore os exemplos <span aria-hidden="true">↙</span></span></div>
          <div id="preview-satelite" data-map-panel="satelite">
          <a href={exemploSatelite.src} target="_blank" rel="noopener" class="map-open" aria-label="Ampliar exemplo de mapa de satélite em nova aba">
            <Image src={exemploSatelite} alt="Imagem de satélite com grade de setores, rotas com setas e áreas de safezone, respawn, trincheira e CQB." widths={[640, 960, 1280]} sizes="(min-width: 1000px) 57vw, 100vw" loading="eager" fetchpriority="high" />
            <span class="zoom-label">Ampliar mapa <span aria-hidden="true">↗</span></span>
          </a>
          </div>
          <div id="preview-ilustrado" data-map-panel="ilustrado" hidden><a href={exemploIlustrado.src} target="_blank" rel="noopener" class="map-open" aria-label="Ampliar exemplo ilustrado em nova aba"><Image src={exemploIlustrado} alt="Campo ilustrado com árvores, construções, setores e áreas da operação demarcadas." widths={[640, 960, 1280]} sizes="(min-width: 1000px) 57vw, 100vw" loading="lazy" /><span class="zoom-label">Ampliar mapa ↗</span></a></div>
          <figcaption><span class="map-coordinate" aria-hidden="true">G8</span><span><strong>“Equipe, avancem pelo setor G8.”</strong><br />Uma referência clara. Todo mundo no mesmo mapa.</span><span class="north-mark" aria-hidden="true">N<br />↑</span></figcaption>
        </figure>
      </div>
      <div class="wrap hero-bottom"><span class="hero-bottom-title">Do planejamento<br /><strong>para o campo.</strong></span><span><strong>01</strong> Localize o terreno</span><span><strong>02</strong> Desenhe a operação</span><span><strong>03</strong> Compartilhe o plano</span><a href="#como-funciona" aria-label="Conhecer as etapas de criação">↓</a></div>
    </section>

    <nav class="section-nav" aria-label="Nesta página">
      <div class="wrap nav-inner"><span class="nav-label">Prepare a próxima operação</span><div><a href="#como-funciona">Como funciona</a><a href="#recursos">Recursos</a><a href="#acesso">Como acessar</a><a href="#duvidas">Dúvidas</a></div></div>
    </nav>

    <section id="como-funciona" class="process-section" aria-labelledby="titulo-passos"><div class="wrap section">
      <div class="section-heading"><div><p class="eyebrow">01 / Do terreno ao plano</p><h2 id="titulo-passos">Seu próximo briefing<br />começa aqui.</h2></div><p>Da localização do campo à imagem que vai para o grupo. Tudo no navegador.</p></div>
      <ol class="steps">{passos.map((passo, i) => <li><div class="step-art" aria-hidden="true"><span class="step-number">0{i + 1}</span><svg viewBox="0 0 160 88" fill="none"><path class="art-grid" d="M0 22h160M0 44h160M0 66h160M32 0v88M64 0v88M96 0v88M128 0v88" />{i === 0 ? <><path d="M48 12h-20v20M112 12h20v20M28 56v20h20M132 56v20h-20" /><path d="M80 63s17-17 17-29a17 17 0 0 0-34 0c0 12 17 29 17 29Z" /><circle cx="80" cy="33" r="6" /></> : i === 1 ? <><path d="m22 24 40-10 14 35-42 14Z" /><path d="m91 17 43 10-11 30-32-6Z" /><path d="M48 49c4 30 40 31 67 14m-12-4 12 4-5 11" stroke-dasharray="5 4" /></> : <><rect x="33" y="10" width="60" height="67" /><path d="m43 57 13-18 13 12 12-21M104 44h32m-11-11 11 11-11 11M45 22h23" /></>}</svg></div><h3>{passo.titulo}</h3><p>{passo.texto}</p></li>)}</ol>
      <div class="demo" id="demonstracao">
        <div class="demo-copy"><p class="eyebrow">Veja antes de entrar</p><h3>Do satélite<br />ao mapa pronto.</h3><p>Uma demonstração de 15 segundos para visualizar o resultado.</p><p class="muted">Sem áudio. Você controla a reprodução.</p></div>
        <div><video controls playsinline preload="none" poster={capaVideo.src} aria-label="Demonstração visual do criador de mapas" aria-describedby="descricao-video"><source src="/video/criador-de-mapas-airsoft.mp4" type="video/mp4" /><a href="/video/criador-de-mapas-airsoft.mp4">Abrir demonstração em vídeo</a></video><p id="descricao-video" class="video-description">No vídeo: enquadrar o campo, alinhar a imagem, marcar áreas e preparar a exportação.</p></div>
      </div>
    </div></section>

    <section id="recursos" class="resources-section" aria-labelledby="titulo-recursos">
      <div class="wrap section">
        <div class="section-heading"><div><p class="eyebrow">02 / Feito para airsoft</p><h2 id="titulo-recursos">Menos dúvida no rádio.<br />Mais clareza no campo.</h2></div><p>Organize as informações que os jogadores precisam consultar durante a operação.</p></div>
        <div class="resources-grid">
          <figure class="second-map"><a href={exemploIlustrado.src} target="_blank" rel="noopener" aria-label="Ampliar exemplo ilustrado em nova aba"><Image src={exemploIlustrado} alt="Mapa ilustrado de um campo com vegetação, construções, grade de setores e marcações coloridas." widths={[480, 800, 1280]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" /><span class="zoom-label">Ampliar exemplo ↗</span></a><figcaption>Uma referência visual para apresentar o terreno e a operação.</figcaption></figure>
          <div class="feature-list">
            <article><span class="feature-index" aria-hidden="true">A1</span><div><h3>Uma posição que todos entendem</h3><p>Use a grade de letras e números para identificar setores e combinar referências no briefing.</p></div></article>
            <article><span class="feature-index" aria-hidden="true">B2</span><div><h3>Cada área com seu papel</h3><p>Destaque safe, respawn e objetivos. Trace rotas com setas e acrescente textos para explicar a missão.</p><div class="symbol-list">{destaques.map(({ nome, simbolo }) => <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d={simbolo.desenho} /></svg>{nome}</span>)}</div><p class="muted">{Object.keys(SIMBOLOS).length} símbolos prontos no editor.</p></div></article>
            <article><span class="feature-index" aria-hidden="true">C3</span><div><h3>Pronto para o grupo e o próximo jogo</h3><p>Exporte em PNG e compartilhe pelo WhatsApp. Salve até {LIMITE_MAPAS} projetos na conta para editar depois.</p></div></article>
          </div>
        </div>
        <details class="technical"><summary>Ver formatos de exportação <span aria-hidden="true">+</span></summary><div class="format-list">{Object.values(FORMATOS).map(formato => <p><strong>{formato.rotulo}</strong><span>{formato.ajuda}</span></p>)}</div></details>
      </div>
    </section>

    <section id="acesso" class="wrap section access-section" aria-labelledby="titulo-acesso">
      <div><p class="eyebrow">03 / Comece pela sua conta</p><h2 id="titulo-acesso">Gratuito.<br />Do cadastro ao mapa.</h2><p class="access-intro">O criador faz parte das ferramentas da Comunidade Airsoft. No primeiro acesso, você precisa concluir estas etapas.</p><ol class="access-steps"><li><span aria-hidden="true">1</span><div><h3>Entre com o Google</h3><p>Use sua conta Google para acessar a comunidade.</p></div></li><li><span aria-hidden="true">2</span><div><h3>Complete seu perfil</h3><p>Informe WhatsApp, cidade e aceite os termos do cadastro.</p></div></li><li><span aria-hidden="true">3</span><div><h3>Cadastre uma réplica</h3><p>Com o perfil completo e ao menos uma réplica cadastrada, as ferramentas são liberadas.</p></div></li></ol></div>
      <aside class="start-panel" aria-label="Começar a criar"><p class="eyebrow">Seu campo. Seu plano.</p><h3>Prepare o mapa<br />do próximo jogo.</h3><p>Já tem o cadastro completo? Vá direto para o editor e comece pelo seu campo.</p><Botao href="/mapa" class="w-full">Criar meu mapa grátis <span aria-hidden="true">→</span></Botao><p class="start-meta">Sem cartão · Sem instalação</p><div class="device-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4h18v13H3zM8 21h8M12 17v4" /></svg><p><strong>Crie no computador.</strong><br />Use o celular para consultar e compartilhar o mapa exportado.</p></div></aside>
    </section>

    <section id="duvidas" class="faq-section" aria-labelledby="titulo-duvidas"><div class="wrap section faq-grid"><div><p class="eyebrow">Antes de começar</p><h2 id="titulo-duvidas">Dúvidas<br />resolvidas.</h2></div><div class="faq-list">{perguntas.map(({ p, r }) => <details><summary>{p}<span aria-hidden="true">+</span></summary><p>{r}</p></details>)}</div></div></section>
  </div>
</Base>

<script>
  const switcher = document.querySelector<HTMLElement>(".map-switch");
  if (switcher) {
    switcher.hidden = false;
    const buttons = switcher.querySelectorAll<HTMLButtonElement>("[data-map-view]");
    const panels = document.querySelectorAll<HTMLElement>("[data-map-panel]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
        panels.forEach((panel) => { panel.hidden = panel.dataset.mapPanel !== button.dataset.mapView; });
      });
    });
  }
</script>

<style>
  .mapas-v2 { --section-space: 100px; --color-oliva-300: #c2d397; --color-oliva-400: #a6bc76; --color-oliva-500: #a6bc76; --color-texto: #d7dacd; --color-texto-2: #a6ae9d; --sand: #e8e3d5; background: #0c100d; }
  .wrap { width: min(1240px, calc(100% - 64px)); margin-inline: auto; }
  .section { padding-block: var(--section-space); }
  section[id], #demonstracao { scroll-margin-top: 28px; }
  .eyebrow { font-family: var(--font-dado); font-size: 12px; line-height: 1.5; text-transform: uppercase; letter-spacing: .11em; color: var(--color-oliva-300); }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 700; }
  h1 { font-size: clamp(58px, 5.7vw, 82px); line-height: .98; letter-spacing: -.025em; text-transform: uppercase; font-weight: 800; margin-top: 28px; }
  h1 span { color: var(--color-oliva-300); }
  h2 { font-size: clamp(40px, 4.4vw, 60px); line-height: 1; letter-spacing: -.015em; text-transform: uppercase; margin-top: 14px; }
  h3 { font-size: 26px; line-height: 1.15; }
  p { color: var(--color-texto); }
  .hero { position: relative; isolation: isolate; overflow: hidden; border-bottom: 1px solid var(--color-borda); background: #10170f; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(9 14 10 / .96) 0%, rgb(9 14 10 / .84) 38%, rgb(9 14 10 / .3) 100%), linear-gradient(0deg, #0c100d 0%, transparent 40%); }
  .hero-backdrop { position: absolute; inset: 0; z-index: -2; }
  .hero-backdrop img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 40px; align-items: center; padding-block: 94px 76px; }
  .hero-copy .eyebrow { display: flex; align-items: center; gap: 9px; }
  .status-dot { display: inline-block; width: 6px; height: 6px; background: var(--color-oliva-300); flex-shrink: 0; }
  .intro { max-width: 47ch; font-size: 19px; line-height: 1.55; margin-top: 24px; }
  .actions { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 30px; }
  .text-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; font-size: 16px; text-underline-offset: 5px; }
  .text-link:hover { text-decoration: underline; color: var(--color-oliva-300); }
  .access-note { font-size: 14px; line-height: 1.6; color: var(--color-texto-2); margin-top: 18px; max-width: 50ch; }
  .access-note a { color: var(--color-texto); text-decoration: underline; text-underline-offset: 3px; }
  .hero-notes { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 22px; font-size: 14px; color: var(--color-texto-2); }
  .hero-notes span::before { content: '✓'; color: var(--color-oliva-300); margin-right: 7px; }
  .hero-map { position: relative; border: 1px solid #687451; background: #111811; box-shadow: 0 32px 80px rgb(0 0 0 / .5), 10px 10px 0 rgb(166 188 118 / .1); transform: rotate(-1.5deg); }
  .hero-map::before { content: ''; position: absolute; width: 64px; height: 3px; background: var(--color-oliva-300); top: -2px; left: 20px; }
  .frame-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding: 14px 16px; font-family: var(--font-dado); font-size: 11px; text-transform: uppercase; color: var(--color-texto-2); border-bottom: 1px solid var(--color-borda); }
  .frame-top > span:first-child { display: flex; align-items: center; gap: 8px; color: var(--color-oliva-300); }
  .map-open, .second-map a { position: relative; display: block; }
  .hero-map img { width: 100%; height: auto; aspect-ratio: 1280/650; object-fit: contain; background: #0a0e09; }
  .zoom-label { display: inline-block; background: var(--color-fundo); color: var(--color-tinta); padding: 9px 12px; font-size: 13px; border: 1px solid var(--color-borda-forte); }
  .map-open .zoom-label { position: absolute; right: 10px; top: 10px; }
  a:hover .zoom-label { color: var(--color-oliva-300); border-color: var(--color-oliva-300); }
  .hero-map figcaption { display: flex; gap: 16px; align-items: center; padding: 20px; font-size: 14px; line-height: 1.6; color: var(--color-texto-2); border-top: 1px solid var(--color-borda); }
  figcaption strong { color: var(--color-tinta); font-weight: 500; }
  .map-coordinate { font: 28px var(--font-dado); color: var(--color-oliva-300); border: 1px solid var(--color-borda-forte); padding: 12px; }
  .section-nav { border-bottom: 1px solid var(--color-borda); }
  .nav-inner { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .nav-label { font-family: var(--font-dado); text-transform: uppercase; font-size: 11px; letter-spacing: .08em; color: var(--color-texto-2); }
  .nav-inner > div { display: flex; gap: 28px; }
  .nav-inner a { padding-block: 20px; font-size: 15px; color: var(--color-texto); }
  .nav-inner a:hover { color: var(--color-oliva-300); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 36px; margin-bottom: 40px; }
  .section-heading > p { max-width: 35ch; color: var(--color-texto-2); }
  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .steps li { padding: 0 24px 0 0; border-right: 1px solid #c6c9b9; }
  .steps li:last-child { border-right: 0; }
  .step-number { font: 15px var(--font-dado); color: var(--color-oliva-300); }
  .steps h3 { margin-top: 16px; }
  .steps p { margin-top: 12px; color: var(--color-texto-2); }
  .demo { display: grid; grid-template-columns: .7fr 1.3fr; gap: 40px; padding: 36px; background: #141c14; color: #f0f2e9; border: 1px solid #303e2a; margin-top: 48px; align-items: center; box-shadow: 0 16px 32px rgb(22 30 14 / .12); }
  .demo h3 { font-size: 36px; text-transform: uppercase; margin-block: 16px; }
  .demo-copy p { max-width: 33ch; }
  .muted { font-size: 14px; color: var(--color-texto-2); margin-top: 12px; }
  video { display: block; width: 100%; aspect-ratio: 16/9; background: var(--color-fundo); }
  .video-description { font-size: 13px; margin-top: 10px; color: var(--color-texto-2); }
  .resources-section { background: #111810; border-block: 1px solid var(--color-borda); position: relative; }
  .resources-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .second-map img { width: 100%; height: auto; border: 1px solid var(--color-borda-forte); box-shadow: 14px 14px 0 #1d2718; }
  .second-map .zoom-label { position: absolute; right: 12px; bottom: 12px; }
  .second-map figcaption { font-size: 14px; color: var(--color-texto-2); margin-top: 12px; }
  .feature-list article { display: flex; gap: 20px; padding-block: 24px; border-bottom: 1px solid var(--color-borda); }
  .feature-list article:first-child { padding-top: 0; }
  .feature-list p { margin-top: 10px; color: var(--color-texto-2); }
  .feature-index { font: 14px var(--font-dado); color: var(--color-oliva-300); padding-top: 6px; }
  .symbol-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .symbol-list > span { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--color-borda-forte); padding: 7px 9px; font-size: 13px; color: var(--color-texto); }
  .symbol-list svg { width: 18px; height: 18px; color: var(--color-oliva-300); }
  .technical { margin-top: 36px; border-block: 1px solid var(--color-borda-forte); }
  summary { cursor: pointer; list-style: none; display: flex; gap: 20px; align-items: center; justify-content: space-between; padding-block: 22px; font-size: 18px; font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  summary > span { font-size: 24px; color: var(--color-oliva-300); transition: transform .2s; }
  details[open] > summary > span { transform: rotate(45deg); }
  .format-list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; padding-bottom: 24px; }
  .format-list p { font-size: 15px; }
  .format-list strong, .format-list span { display: block; }
  .format-list span { color: var(--color-texto-2); }
  .access-section { display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 100px; }
  .access-intro { max-width: 48ch; margin-top: 22px; }
  .access-steps { margin-top: 30px; list-style: none; padding: 0; }
  .access-steps li { display: flex; gap: 18px; margin-top: 24px; }
  .access-steps li > span { width: 32px; height: 32px; border: 1px solid var(--color-borda-forte); display: grid; place-items: center; flex-shrink: 0; font: 15px var(--font-dado); color: var(--color-oliva-300); }
  .access-steps h3 { font-size: 23px; }
  .access-steps p { font-size: 16px; margin-top: 5px; color: var(--color-texto-2); }
