  /* ============================================================
     Banda de cadastro — desenho do mockup desta seção.
     ============================================================ */

  /* Escurece a foto de fundo: quase opaca à esquerda (onde está o
     texto), abre à direita (onde está o operador), fecha nas bordas. */
  .cta-vinheta {
    background:
      linear-gradient(
        to right,
        var(--color-fundo) 0%,
        rgba(11, 13, 9, 0.96) 38%,
