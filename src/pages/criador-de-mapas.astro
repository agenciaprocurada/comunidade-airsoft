        rgba(11, 13, 9, 0.7) 0%,
        transparent 30%,
        transparent 65%,
        rgba(11, 13, 9, 0.92) 100%
      );
  }

  /* Card de passo com chanfro em cantos opostos ao do CTA primário
     (que corta em cima-esquerda / baixo-direita). Clip-path também
     corta a borda, então a borda é o fundo da camada de fora e o
     conteúdo é uma camada de dentro 1px menor, com o mesmo corte. */
  .card-passo {
    --corte: 16px;
    padding: 1px;
    background: var(--color-oliva-700);
    clip-path: polygon(
      0 0,
      calc(100% - var(--corte)) 0,
      100% var(--corte),
      100% 100%,
      var(--corte) 100%,
      0 calc(100% - var(--corte))
    );
  }
  .card-passo-miolo {
    background: rgba(20, 24, 15, 0.94);
    clip-path: polygon(
      0 0,
      calc(100% - var(--corte) + 1px) 0,
      100% calc(var(--corte) - 1px),
      100% 100%,
      calc(var(--corte) - 1px) 100%,
      0 calc(100% - var(--corte) + 1px)
    );
  }

  /* Emblema hexagonal do passo — mesma técnica de duas camadas. */
  .hexagono {
    --hex: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    padding: 1.5px;
    background: var(--color-oliva-500);
    clip-path: var(--hex);
  }
  .hexagono-miolo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-fundo);
    color: var(--color-oliva-300);
    clip-path: var(--hex);
  }

  /* Brilho do CTA. Vai no invólucro porque o chanfro do botão é
     clip-path, que cortaria um box-shadow; drop-shadow segue a
     silhueta recortada. */
  .cta-brilho {
    filter: drop-shadow(0 6px 18px rgba(169, 189, 102, 0.4));
  }

  /* Listra de detalhe sob o título da seção — eco miúdo da
     faixa-perigo, em oliva. */
  .listra-mini {
    width: 64px;
    height: 7px;
    background: repeating-linear-gradient(
      -55deg,
