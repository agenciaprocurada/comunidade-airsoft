<style>
  /* ============================================================
     Coordenada de seção — a convenção da quadrícula ("B4 no rádio")
     aplicada à navegação da própria página.
     ============================================================ */
  .tag-setor {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: 1px solid var(--color-borda-forte);
    font-family: var(--font-dado);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--color-oliva-400);
  }

  /* Chip da bandeja de símbolos: no hover, a borda assume a cor do
     próprio símbolo — o mesmo feedback do editor. */
  .chip-simbolo {
    transition: border-color 150ms ease;
  }
  .chip-simbolo:hover {
    border-color: var(--cor-simbolo);
  }

  /* ============================================================
     O mapa do hero se desenha no carregamento.

     Regra de robustez: o estado BASE de cada camada é o mapa pronto.
     Toda animação parte de "invisível" no `from` e termina no estado
     base — se ela não rodar (reduced motion, navegador antigo), o
     visitante vê o mapa completo, nunca um quadro vazio.
     ============================================================ */

  /* Camada 1 — a quadrícula surge primeiro, como no editor. */
  .mapa-grade {
    animation: cm-surgir 600ms ease-out 200ms both;
  }

  /* Camada 2 — áreas de traço sólido se desenham pelo contorno
     (pathLength="1" normaliza o perímetro) e só então preenchem. */
  .mapa-traco {
    stroke-dasharray: 1;
    fill-opacity: 0.2;
    animation:
      cm-tracar 900ms ease-in-out both,
      cm-preencher 500ms ease-out both;
  }
  .mapa-traco-1 {
    animation-delay: 700ms, 1400ms;
  }
  .mapa-traco-2 {
    animation-delay: 1900ms, 2600ms;
  }

  /* Camada 3 — contorno tracejado e rota entram por revelação
     (tracejado não se desenha por dashoffset sem perder o padrão). */
  .mapa-revela {
    animation: cm-revelar 800ms ease-in-out both;
  }
  .mapa-revela-cqb {
    animation-delay: 1300ms;
  }
  .mapa-revela-rota {
    animation-delay: 2500ms;
    animation-duration: 1000ms;
  }

  /* Depois de pronta, a rota segue marchando devagar — o único
     movimento que fica, e é o movimento de uma rota. */
  .mapa-marcha {
    animation: cm-marchar 2.4s linear 3.5s infinite;
  }

  /* Camada 4 — símbolos pousam logo após a área deles. */
  .mapa-simbolo {
    transform-box: fill-box;
    transform-origin: center;
    animation: cm-pousar 350ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .mapa-simbolo-1 {
    animation-delay: 1800ms;
  }
  .mapa-simbolo-2 {
    animation-delay: 2300ms;
  }
  .mapa-simbolo-3 {
    animation-delay: 2900ms;
  }

  /* Última entrada: o chamado de rádio. */
  .mapa-chamado {
    animation: cm-chamar 400ms ease-out 3600ms both;
  }

  /* O ponto "gravando" da barra do quadro. */
  .mapa-pulso {
    animation: cm-pulsar 2s ease-in-out 4s infinite;
  }

  @keyframes cm-surgir {
    from {
      opacity: 0;
    }
  }

  @keyframes cm-tracar {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes cm-preencher {
    from {
      fill-opacity: 0;
    }
  }

  @keyframes cm-revelar {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes cm-marchar {
    to {
      stroke-dashoffset: -20;
    }
  }

  @keyframes cm-pousar {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes cm-chamar {
    from {
      opacity: 0;
      transform: translateX(6px);
    }
  }

  @keyframes cm-pulsar {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mapa-grade,
    .mapa-traco,
    .mapa-revela,
    .mapa-marcha,
    .mapa-simbolo,
    .mapa-chamado,
    .mapa-pulso,
    .chip-simbolo {
      animation: none;
      transition: none;
    }
  }
</style>
