  /* ============================================================
     A bandeja de símbolos — desenho do mockup desta seção: painel
     arredondado com respiro de luz nas bordas horizontais. Exceção
     local e consciente à regra de canto reto do DS.
     ============================================================ */
  .painel-simbolos {
    position: relative;
    border: 1px solid var(--color-borda-forte);
    border-radius: 14px;
    background: var(--color-fundo);
    box-shadow: 0 0 60px -28px rgba(125, 145, 57, 0.55);
  }

  /* O brilho: uma linha de luz centrada em cada borda horizontal. */
  .painel-simbolos::before,
  .painel-simbolos::after {
    content: "";
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 44%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(169, 189, 102, 0.9),
      transparent
    );
    box-shadow: 0 0 12px 1px rgba(169, 189, 102, 0.4);
    pointer-events: none;
  }
  .painel-simbolos::before {
    top: -1px;
  }
  .painel-simbolos::after {
    bottom: -1px;
  }

  /* Esquadros de HUD nos cantos de baixo do painel. */
  .painel-canto {
    position: absolute;
    bottom: -1px;
    width: 22px;
    height: 22px;
    border-bottom: 2px solid var(--color-oliva-700);
    pointer-events: none;
  }
  .painel-canto-esq {
    left: -1px;
    border-left: 2px solid var(--color-oliva-700);
    border-bottom-left-radius: 14px;
  }
  .painel-canto-dir {
    right: -1px;
    border-right: 2px solid var(--color-oliva-700);
    border-bottom-right-radius: 14px;
  }

  /* ============================================================
     O mapa do hero se desenha no carregamento.

     Regra de robustez: o estado BASE de cada camada é o mapa pronto.
     Toda animação parte de "invisível" no `from` e termina no estado
     base — se ela não rodar (reduced motion, navegador antigo), o
     visitante vê o mapa completo, nunca um quadro vazio.
     ============================================================ */

  /* Camada 1 — a quadrícula surge primeiro, como no editor. */
  .mapa-grade {
    animation: cm-surgir 600ms ease-out 200ms both;
  }

  /* Camada 2 — áreas de traço sólido se desenham pelo contorno
     (pathLength="1" normaliza o perímetro) e só então preenchem. */
  .mapa-traco {
    stroke-dasharray: 1;
    fill-opacity: 0.2;
    animation:
      cm-tracar 900ms ease-in-out both,
      cm-preencher 500ms ease-out both;
  }
  .mapa-traco-1 {
    animation-delay: 700ms, 1400ms;
  }
  .mapa-traco-2 {
    animation-delay: 1900ms, 2600ms;
  }

  /* Camada 3 — contorno tracejado e rota entram por revelação
     (tracejado não se desenha por dashoffset sem perder o padrão). */
  .mapa-revela {
    animation: cm-revelar 800ms ease-in-out both;
  }
  .mapa-revela-cqb {
    animation-delay: 1300ms;
  }
  .mapa-revela-rota {
    animation-delay: 2500ms;
    animation-duration: 1000ms;
  }

  /* Depois de pronta, a rota segue marchando devagar — o único
     movimento que fica, e é o movimento de uma rota. */
  .mapa-marcha {
    animation: cm-marchar 2.4s linear 3.5s infinite;
  }

  /* Camada 4 — símbolos pousam logo após a área deles. */
  .mapa-simbolo {
    transform-box: fill-box;
    transform-origin: center;
    animation: cm-pousar 350ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .mapa-simbolo-1 {
    animation-delay: 1800ms;
  }
  .mapa-simbolo-2 {
    animation-delay: 2300ms;
  }
  .mapa-simbolo-3 {
    animation-delay: 2900ms;
  }

  /* Última entrada: o chamado de rádio. */
  .mapa-chamado {
    animation: cm-chamar 400ms ease-out 3600ms both;
  }

  /* O ponto "gravando" da barra do quadro. */
  .mapa-pulso {
    animation: cm-pulsar 2s ease-in-out 4s infinite;
  }

  @keyframes cm-surgir {
    from {
      opacity: 0;
    }
  }

  @keyframes cm-tracar {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes cm-preencher {
    from {
      fill-opacity: 0;
    }
  }

  @keyframes cm-revelar {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes cm-marchar {
    to {
      stroke-dashoffset: -20;
    }
  }

  @keyframes cm-pousar {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes cm-chamar {
    from {
      opacity: 0;
      transform: translateX(6px);
    }
  }

  @keyframes cm-pulsar {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mapa-grade,
    .mapa-traco,
    .mapa-revela,
    .mapa-marcha,
    .mapa-simbolo,
    .mapa-chamado,
    .mapa-pulso,
    .chip-simbolo {
      animation: none;
      transition: none;
    }
  }
</style>
