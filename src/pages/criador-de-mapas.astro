<script>
  // Lightbox dos mapas de exemplo. O <dialog> nativo cuida do foco,
  // do Esc e do fundo; aqui só se liga abrir e fechar.
  document.querySelectorAll<HTMLButtonElement>("[data-abrir-mapa]").forEach((botao) => {
    const id = botao.dataset.abrirMapa;
    const alvo = id ? (document.getElementById(id) as HTMLDialogElement | null) : null;
    if (!alvo) return;
    botao.addEventListener("click", () => alvo.showModal());
  });

  document.querySelectorAll<HTMLDialogElement>("dialog[data-lightbox-mapa]").forEach((dialogo) => {
    dialogo.querySelector("[data-fechar]")?.addEventListener("click", () => dialogo.close());
    // Clique no fundo escurecido fecha: fora do conteúdo, o alvo do
    // evento é o próprio <dialog>.
    dialogo.addEventListener("click", (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  });
</script>

<style>
