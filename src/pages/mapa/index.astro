                   class="mt-2 w-full accent-oliva-500" data-grade-opacidade />
          </div>
          </div>

          <div class="hidden min-h-0 flex-1 space-y-5 overflow-y-auto p-3.5" data-painel-aba="satelite">

          <!--
            Fundo do mapa: satélite (padrão) ou uma imagem que o usuário
            envia — planta do campo, foto de drone. Com imagem própria,
            escala, norte, aproximação e busca somem: seriam mentira
