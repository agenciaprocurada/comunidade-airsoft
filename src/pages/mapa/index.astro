---
// Renderizada no servidor: o middleware exige sessao para abrir o editor.
export const prerender = false;

import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { ENTRADA } from "../../lib/estilos-form";
import {
  CORES,
  GRADE_MAX,
  GRADE_MIN,
  GRADE_PADRAO,
  TRACOS,
  ZOOM_MIN,
  ZOOM_PADRAO,
} from "../../lib/mapa";
import { GRUPOS_SIMBOLOS, SIMBOLOS } from "../../lib/simbolos";

/**
 * Editor de mapa de operação — uma janela só.
 *
 * A primeira versão era um assistente de três passos (encontrar,
 * alinhar, desenhar) numa página de conteúdo. Funcionava e era ruim de
 * usar: o mapa ficava com 638 px numa tela de 1600, começava depois de
 * 659 px de rolagem, e trocar o local exigia voltar dois passos.
 *
 * Agora é uma tela de trabalho: barra de comando no topo, ferramentas à
 * esquerda, camadas e ajustes à direita, símbolos embaixo, e o mapa
 * ocupando o resto. Reposicionar o satélite virou um painel que abre
 * sobre a tela, não um passo para trás.
 *
 * Continua ESTÁTICA e indexável, e a ferramenta inteira funciona sem
 * conta — só guardar exige login. O texto de SEO ficou depois do
 * editor: quem chegou do Google rola para ler, quem veio trabalhar já
 * está na ferramenta.
 *
 * Fabric e Leaflet NÃO entram no bundle desta página: `ferramenta.ts`
 * os carrega por `import()` quando são necessários.
 */

const CHAVE_NAVEGADOR = import.meta.env.PUBLIC_GOOGLE_MAPS_BROWSER_KEY ?? "";

const TITULO = "Criador de mapa de operação";
const DESCRICAO =
  "Monte o mapa do seu campo de airsoft sobre a imagem de satélite: grade de setores, " +
  "áreas marcadas, rotas e símbolos. Gratuito, direto no navegador.";

/** Barra da esquerda. `atalho` aparece na dica e vale no teclado. */
const FERRAMENTAS = [
  { acao: "selecionar", rotulo: "Selecionar", atalho: "V", icone: "M5 3l14 8-6 1.5L10 19z" },
  // A mão existe para toque e para quem não conhece o atalho; no
  // desktop, espaço+arraste e o botão do meio fazem o mesmo sem
  // trocar de ferramenta.
  { acao: "mover", rotulo: "Mover", atalho: "H", icone: "M12 4v16M4 12h16M9 7l3-3 3 3M9 17l3 3 3-3M7 9l-3 3 3 3M17 9l3 3-3 3" },
  { acao: "area", rotulo: "Área", atalho: "A", icone: "M4 8l6-4 10 5-3 10-9 2z" },
  { acao: "linha", rotulo: "Linha", atalho: "L", icone: "M4 20L20 4M4 20h4M20 4v4" },
  { acao: "rota", rotulo: "Rota", atalho: "R", icone: "M4 19c6 0 4-7 9-7h6M15 8l4 4-4 4" },
  { acao: "texto", rotulo: "Texto", atalho: "T", icone: "M5 5h14M12 5v14M9 19h6" },
  { acao: "marcacao", rotulo: "Ponto", atalho: "P", icone: "M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11zM12 8v4M12 14.5v.5" },
] as const;

const ACOES = [
  { acao: "desfazer", rotulo: "Desfazer", atalho: "Ctrl+Z", icone: "M9 7L4 12l5 5M4 12h10a5 5 0 0 1 0 10h-2" },
  { acao: "refazer", rotulo: "Refazer", atalho: "Ctrl+Y", icone: "M15 7l5 5-5 5M20 12H10a5 5 0 0 0 0 10h2" },
  { acao: "excluir", rotulo: "Excluir", atalho: "Del", icone: "M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14M10 11v6M14 11v6" },
] as const;

/** Classe comum dos botões da barra vertical. Compactos de propósito:
 *  são 10 na coluna, e cada pixel de altura aqui é altura que a barra
 *  precisa rolar em notebook baixo. */
const BOTAO_LATERAL =
  "group flex w-full flex-col items-center gap-0.5 border border-transparent px-1 py-1.5 " +
  "text-[10px] font-dado uppercase tracking-[0.1em] text-texto-2 transition-colors duration-150 " +
  "hover:border-borda-forte hover:bg-oliva-050 hover:text-tinta " +
  "focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-oliva-300 " +
  "aria-pressed:border-oliva-700 aria-pressed:bg-oliva-050 aria-pressed:text-oliva-300 " +
  "disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:border-transparent " +
  "disabled:hover:bg-transparent";

const ROTULO_PAINEL =
  "font-dado text-[10px] uppercase tracking-[0.16em] text-texto-2";

/**
 * Aba de painel encaixado, à la Photoshop: faixa escura, aba ativa com
 * o fundo do painel e texto oliva. `flex-1 truncate` divide a faixa
 * por igual e corta rótulo comprido em vez de quebrar a linha.
 */
const ABA_PAINEL =
  "flex-1 min-w-0 truncate border-b-2 border-transparent px-1 py-2.5 font-dado text-[10px] " +
  "uppercase tracking-[0.1em] text-texto-2 transition-colors duration-150 " +
  "hover:text-tinta aria-pressed:border-oliva-500 aria-pressed:text-oliva-300 " +
  "focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-oliva-300";

/** Linha rótulo + valor dos controles deslizantes, como no mockup. */
const LINHA_CONTROLE = "flex items-baseline justify-between gap-3";
const VALOR_CONTROLE = "font-dado text-[0.8125rem] text-oliva-300";
---

<Base titulo={TITULO} descricao={DESCRICAO} semCasca={true}>
  <div data-editor data-chave={CHAVE_NAVEGADOR}>
    <!-- ============================================================
         Barra do aplicativo — o editor tem casca própria (semCasca no
         Base): navegação do site aqui seria ruído numa tela de
         trabalho. "Sair do editor" é o caminho de volta.
         ============================================================ -->
    <header class="flex items-center gap-4 border-b border-borda bg-fundo px-4 py-2.5 md:px-6">
      <a href="/" class="shrink-0" aria-label="Comunidade Airsoft — início">
        <Logo class="h-8 w-auto" />
      </a>
      <span class="hidden font-dado text-[11px] uppercase tracking-[0.2em] text-oliva-300 sm:block">
        Editor de mapas
      </span>

      <div class="ml-auto flex items-center gap-2">
        <a href="#ajuda" class="botao-barra">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 1 1 3.6 2.4c-.8.35-1.1.9-1.1 1.8M12 16.6v.6" stroke-linecap="square"/></svg>
          Ajuda
        </a>
        <a href="/" class="botao-barra">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M14 4h6v16h-6M13 12H4M8 8l-4 4 4 4"/></svg>
          Sair do editor
        </a>
        <button type="button" class="botao-barra" data-telacheia>
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg>
          Tela cheia
        </button>
      </div>
    </header>

    <!-- ============================================================
         Barra de comando — voltar, nome do mapa, busca, ações
         ============================================================ -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-borda px-4 py-2.5 md:px-6">
      <a href="/conta/mapas" class="botao-barra shrink-0">
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        Meus mapas
      </a>

      <!--
        O nome do mapa É o título da tela, editável no lugar — como um
        documento. O lápis só dá o foco: o campo já é sempre editável.
      -->
      <div class="flex min-w-0 items-center gap-1.5">
        <input
          type="text"
          maxlength="80"
          placeholder="Mapa sem nome"
          aria-label="Nome do mapa"
          class="titulo-mapa"
          data-nome-mapa
        />
        <button type="button" class="shrink-0 p-1 text-texto-2 transition-colors hover:text-oliva-300" data-editar-nome aria-label="Renomear mapa">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M4 20l.8-3.2L15.6 6l2.4 2.4L7.2 19.2zM14 7.6l2.4 2.4M17 4.6l2.4 2.4"/></svg>
        </button>
      </div>

      <form class="relative mx-auto min-w-[15rem] max-w-[34rem] flex-1" data-busca>
        <label class="sr-only" for="busca-local">Endereço, nome do sítio ou coordenada</label>
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-texto-2" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4-4" stroke-linecap="square"/></svg>
        <input
          id="busca-local"
          name="q"
          type="search"
          autocomplete="off"
          enterkeyhint="search"
          placeholder="Buscar endereço, sítio, CEP ou coordenada…"
          class={`${ENTRADA} !mt-0 !py-2 !pl-9 !pr-9`}
        />
        <button type="button" class="absolute right-2 top-1/2 hidden -translate-y-1/2 p-1 text-texto-2 hover:text-tinta" data-limpar-busca aria-label="Limpar busca">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <!--
          A lista flutua em z-[1200]: a pilha do Leaflet vai até 1000 no
          `.leaflet-top`, e empatar com ela perde pela ordem do DOM.
        -->
        <ul
          class="absolute inset-x-0 top-[calc(100%+0.35rem)] z-[1200] hidden max-h-[24rem] overflow-y-auto rounded-lg border border-borda-forte bg-papel shadow-[0_18px_50px_-12px_rgba(0,0,0,0.9)]"
          data-resultados
        >
        </ul>
      </form>

      <!--
        Travar mapa: achou o enquadramento, trava — e nenhum gesto
        desloca mais a foto enquanto se desenha por cima. O antigo
        "Reposicionar" (mapa arrastável em painel) vive no menu ⋮.
      -->
      <button
        type="button"
        class="botao-barra shrink-0"
        data-travar
        aria-pressed="false"
        title="Impede que a foto de satélite se desloque"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><rect x="5" y="11" width="14" height="9"/><path d="M8 11V7a4 4 0 0 1 8 0v4M12 14.5v2.5"/></svg>
        <span data-travar-rotulo>Travar mapa</span>
      </button>

      <button type="button" class="botao-salvar shrink-0" data-salvar>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M5 4h11l3 3v13H5zM8 4v5h7V4M8 20v-6h8v6"/></svg>
        Salvar mapa
      </button>

      <div class="relative shrink-0">
        <button type="button" class="botao-barra !px-2" data-menu aria-haspopup="menu" aria-expanded="false" aria-label="Mais ações">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
        </button>
        <div
          class="absolute right-0 top-[calc(100%+6px)] z-[1300] hidden w-52 overflow-hidden rounded-lg border border-borda-forte bg-papel py-1 shadow-[0_18px_50px_-12px_rgba(0,0,0,0.9)]"
          data-menu-lista
          role="menu"
        >
          <button type="button" class="item-menu" data-novo role="menuitem">Novo mapa</button>
          <button type="button" class="item-menu" data-duplicar role="menuitem">Duplicar mapa</button>
          <button type="button" class="item-menu" data-abrir-local role="menuitem">
            Reposicionar satélite
          </button>
          <a href="/conta/mapas" class="item-menu" role="menuitem">Meus mapas</a>
          <span class="my-1 block h-px bg-borda"></span>
          <button type="button" class="item-menu" data-baixar role="menuitem">Exportar PNG</button>
          <button type="button" class="item-menu" data-imprimir role="menuitem">PDF / Imprimir</button>
          <span class="my-1 block h-px bg-borda"></span>
          <button type="button" class="item-menu !text-alerta-texto" data-excluir role="menuitem">Excluir mapa</button>
        </div>
      </div>
    </div>

    <p
      class="mx-4 mt-3 hidden rounded-lg border border-alerta bg-alerta-bg px-4 py-2.5 text-[0.9375rem] leading-snug text-alerta-texto md:mx-6"
      data-aviso
      role="status"
    >
    </p>

    <!-- ============================================================
         Área de trabalho
         ============================================================ -->
    <!--
      Altura fixa na LINHA, não em cada coluna.

      Sem isto o grid assume a altura do item mais alto — a coluna de
      ajustes, que tem uns 850 px — e a paleta de símbolos era empurrada
      para fora da janela. O efeito colateral era pior que o vazio:
      clicar num símbolo dava foco a um botão fora da viewport, o
      navegador rolava a página, e o mapa saía de vista bem na hora de
      posicionar o que acabou de ser criado.

      Agora as colunas rolam por dentro e a tela inteira cabe.

      `grid-rows-[minmax(0,1fr)]` é a metade que faltava — e faltou uma
      vez, com painel por cima de painel em janela baixa. Fixar a altura
      do CONTÊINER não fixa a da LINHA: linha implícita de grid é
      dimensionada pelo conteúdo (`auto`), então as colunas cresciam até
      669px dentro de um contêiner de 416px e vazavam por cima da seção
      de símbolos. Com a linha em minmax(0,1fr), ela ocupa exatamente o
      espaço do contêiner e cada coluna rola por dentro.
    -->
    <div
      class="grid gap-3 px-4 py-3 md:px-6 xl:h-[clamp(26rem,72vh,52rem)] xl:grid-cols-[4.5rem_minmax(0,1fr)_19rem] xl:grid-rows-[minmax(0,1fr)]"
    >
      <!-- ----- Ferramentas ----- -->
      <!--
        `xl:overflow-y-auto`, nunca visible: numa janela baixa a barra
        tem mais botões do que altura, e com overflow solto ela pintava
        por cima da paleta de símbolos. Rolar dentro da própria barra é
        o comportamento certo — e com os botões compactos quase nunca é
        necessário.
      -->
      <div
        class="flex gap-1 overflow-x-auto border border-borda bg-papel/50 p-1 xl:flex-col xl:gap-0.5 xl:overflow-y-auto xl:overflow-x-hidden"
        role="toolbar"
        aria-label="Ferramentas de desenho"
      >
        {
          FERRAMENTAS.map((f) => (
            <button
              type="button"
              class={`${BOTAO_LATERAL} shrink-0`}
              data-ferramenta={f.acao}
              aria-pressed={f.acao === "selecionar" ? "true" : "false"}
              title={`${f.rotulo} (${f.atalho})`}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="square" aria-hidden="true" class="h-4 w-4">
                <path d={f.icone} />
              </svg>
              {f.rotulo}
            </button>
          ))
        }

        <span class="my-1 hidden h-px w-full bg-borda xl:block"></span>

        {
          ACOES.map((a) => (
            <button
              type="button"
              class={`${BOTAO_LATERAL} shrink-0`}
              data-acao={a.acao}
              title={`${a.rotulo} (${a.atalho})`}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                   stroke-linecap="square" aria-hidden="true" class="h-4 w-4">
                <path d={a.icone} />
              </svg>
              {a.rotulo}
            </button>
          ))
        }
      </div>

      <!-- ----- Palco ----- -->
      <div class="flex min-h-0 min-w-0 flex-col xl:overflow-hidden">
        <!--
          O palco é RECORTADO na proporção do documento (dimensionarPalco
          na ferramenta): o maior retângulo 4:3 — ou o formato escolhido —
          que cabe no espaço. Assim "ajustar" enche a moldura por inteiro
          e a foto ocupa toda a área visível, sem faixa de mesa nas
          laterais. A moldura externa só centraliza.
        -->
        <div class="relative flex min-h-0 flex-1 items-center justify-center" data-moldura-palco>
        <div
          class="relative overflow-hidden border border-borda-forte bg-[#070a06]"
          style="min-height: 14rem; min-width: 16rem"
          data-palco
        >
          <!--
            O canvas preenche o palco. O documento vive DENTRO dele, pela
            matriz de viewport do Fabric — é isso que dá zoom nítido e
            deslocamento por arrasto. `absolute inset-0` porque o Fabric
            embrulha o canvas num container próprio ao montar.
          -->
          <canvas class="absolute inset-0" data-canvas></canvas>

          <div
            class="pointer-events-none absolute inset-0 hidden place-content-center bg-black/70 text-center"
            data-carregando
          >
            <p class="font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-300">
              Carregando satélite…
            </p>
          </div>

          <!-- Faixa-guia do modo de enquadrar. Aparece só com ele ativo. -->
          <div
            class="pointer-events-none absolute left-1/2 top-2 z-10 hidden max-w-[92%] -translate-x-1/2 border border-oliva-700 bg-fundo/90 px-3 py-1.5 text-center font-dado text-[10px] uppercase tracking-[0.12em] leading-relaxed text-oliva-300"
            data-faixa-encaixe
          >
            Arraste para posicionar a foto · role o mouse para dimensionar · a grade não se move
          </div>
        </div>
        </div>

        <!-- Rodapé do palco: zoom da vista e dica da ferramenta -->
        <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2">
          <div class="flex items-center gap-1">
            <button type="button" class="botao-hud" data-vista="menos" aria-label="Afastar">−</button>
            <span class="w-14 text-center font-dado text-[0.8125rem] text-texto-2" data-vista-valor>
              100%
            </span>
            <button type="button" class="botao-hud" data-vista="mais" aria-label="Aproximar">+</button>
            <button type="button" class="botao-hud" data-vista="ajustar">Ajustar</button>
          </div>

          <p class="text-[0.8125rem] leading-snug text-texto-2" data-dica>
            Clique para selecionar e arraste para mover.
          </p>

          <p
            class="font-dado text-[0.6875rem] uppercase tracking-[0.1em] text-texto-2"
            data-resumo-local
          >
          </p>


        </div>
      </div>

      <!--
        Encaixe de painéis com abas, no espírito do Photoshop.

        DOIS grupos empilhados, não um só, e a divisão não é estética:
        quem está soltando símbolos precisa de cor e traço AO MESMO
        TEMPO — num grupo único, cada troca de aba esconderia o outro
        painel e o fluxo viraria pingue-pongue. Em cima fica o CONTEÚDO
        do mapa (camadas e os três grupos de símbolos); embaixo, os
        AJUSTES (traço, grade, satélite).

        A antiga faixa inferior da página morreu aqui: tudo que vivia
        nela virou aba, e a altura que ela ocupava voltou para o mapa.
      -->
      <div class="flex min-h-0 min-w-0 flex-col gap-3">
        <!-- Grupo de cima: o que está NO mapa -->
        <section class="flex min-h-0 flex-1 flex-col border border-borda bg-papel/50" data-grupo-abas>
          <div class="flex shrink-0 border-b border-borda bg-fundo/70" role="tablist">
            <button type="button" class={ABA_PAINEL} data-aba="camadas" aria-pressed="true">
              Camadas <span data-conta-camadas>0</span>
            </button>
            {
              GRUPOS_SIMBOLOS.map((grupo) => (
                <button type="button" class={ABA_PAINEL} data-aba={grupo.chave} aria-pressed="false">
                  {grupo.rotulo}
                </button>
              ))
            }
          </div>

          <div class="min-h-0 flex-1 overflow-y-auto" data-painel-aba="camadas">
            <ul data-camadas></ul>
            <div class="flex flex-col items-center gap-3 px-6 py-10 text-center" data-camadas-vazio>
              <svg viewBox="0 0 24 24" class="h-9 w-9 text-texto-2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l9 5-9 5-9-5z" />
                <path d="M3 12.5l9 5 9-5M3 17l9 5 9-5" opacity="0.55" />
              </svg>
              <p class="max-w-[26ch] text-[0.8125rem] leading-relaxed text-texto-2">
                Nada desenhado ainda. Escolha uma ferramenta à esquerda e clique no
                mapa para criar áreas, rotas ou pontos.
              </p>
            </div>
          </div>

          {
            GRUPOS_SIMBOLOS.map((grupo) => (
              <div
                class="hidden min-h-0 flex-1 space-y-1 overflow-y-auto p-2"
                data-painel-aba={grupo.chave}
              >
                {grupo.itens.map((chave) => {
                  const s = SIMBOLOS[chave];
                  return (
                    <button
                      type="button"
                      class="flex w-full items-center gap-2.5 border border-borda bg-papel px-2.5 py-2 text-left text-[0.875rem] leading-none text-tinta transition-colors duration-150 hover:border-oliva-500 hover:bg-oliva-050 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-oliva-300"
                      data-simbolo={chave}
                    >
                      <span
                        class="grid h-6 w-6 shrink-0 place-content-center rounded-full"
                        style={`background:${s.cor}`}
                      >
                        <svg viewBox="0 0 24 24" fill="none" stroke="#0b0d09" stroke-width="1.8"
                             stroke-linecap="square" aria-hidden="true" class="h-4 w-4">
                          <path d={s.desenho} />
                        </svg>
                      </span>
                      {s.rotulo}
                    </button>
                  );
                })}
              </div>
            ))
          }
        </section>

        <!-- Grupo de baixo: como o mapa é desenhado -->
        <section class="flex min-h-0 flex-1 flex-col border border-borda bg-papel/50" data-grupo-abas>
          <div class="flex shrink-0 border-b border-borda bg-fundo/70" role="tablist">
            <button type="button" class={ABA_PAINEL} data-aba="traco" aria-pressed="true">
              Traço
            </button>
            <button type="button" class={ABA_PAINEL} data-aba="grade" aria-pressed="false">
              Grade
            </button>
            <button type="button" class={ABA_PAINEL} data-aba="satelite" aria-pressed="false">
              Satélite
            </button>
          </div>

          <div class="min-h-0 flex-1 space-y-4 overflow-y-auto p-3" data-painel-aba="traco">
            <div class="flex flex-wrap gap-2">
              {
                CORES.map((c, i) => (
                  <button
                    type="button"
                    class="h-8 w-8 border-2 border-transparent transition-transform hover:scale-110 aria-pressed:border-tinta focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-oliva-300"
                    style={`background:${c.valor}`}
                    data-cor={c.valor}
                    aria-pressed={i === 0 ? "true" : "false"}
                    title={c.rotulo}
                  >
                    <span class="sr-only">{c.rotulo}</span>
                  </button>
                ))
              }
            </div>

            <div class="grid grid-cols-2 gap-1">
              {
                Object.entries(TRACOS).map(([chave, t]) => (
                  <button type="button" class="botao-hud" data-traco={chave}
                          aria-pressed={chave === "tracejado" ? "true" : "false"}>
                    {t.rotulo}
                  </button>
                ))
              }
            </div>

            <div>
              <label class="block text-[0.8125rem] text-texto-2" for="espessura">
                Espessura <span class="font-dado" data-espessura-valor>3</span>
              </label>
              <input id="espessura" type="range" min="1" max="10" value="3"
                     class="mt-2 w-full accent-oliva-500" data-espessura />
            </div>

            <button type="button" class="botao-barra w-full" data-circulo>
              Adicionar círculo
            </button>
          </div>

          <div class="hidden min-h-0 flex-1 space-y-4 overflow-y-auto p-3.5" data-painel-aba="grade">

          <!--
            Canvas de tamanho FIXO, pedido explícito: quadrado ou
            retangular, e nada de acompanhar a tela. Retangular = 16:9 (pedido dele),
            proporcao de tela e projetor; o valor gravado e o `largo`
            do enum existente, sem mexer no banco.
          -->
          <div class="space-y-2">
            <span class="block text-[0.8125rem] font-semibold text-tinta">Formato do mapa</span>
            <div class="grid grid-cols-2 gap-1">
              <button type="button" class="botao-hud" data-formato="largo" aria-pressed="true">
                Retangular
              </button>
              <button type="button" class="botao-hud" data-formato="quadrado" aria-pressed="false">
                Quadrado
              </button>
            </div>
          </div>


          <div class="space-y-2">
            <label class="flex cursor-pointer items-center justify-between text-[0.9375rem] text-tinta">
              Mostrar grade
              <input type="checkbox" checked class="accent-oliva-500" data-grade-ligada />
            </label>
            <label class="flex cursor-pointer items-center justify-between text-[0.9375rem] text-tinta">
              Letras (A–J)
              <input type="checkbox" checked class="accent-oliva-500" data-grade-letras />
            </label>
            <label class="flex cursor-pointer items-center justify-between text-[0.9375rem] text-tinta">
              Números (1–10)
              <input type="checkbox" checked class="accent-oliva-500" data-grade-numeros />
            </label>
            <label class="flex cursor-pointer items-center justify-between text-[0.9375rem] text-tinta">
              Marca na célula
              <input type="checkbox" checked class="accent-oliva-500" data-grade-rotulos />
            </label>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[0.8125rem] text-texto-2" for="colunas">Colunas</label>
              <input id="colunas" type="number" min={GRADE_MIN} max={GRADE_MAX}
                     value={GRADE_PADRAO.colunas} class={ENTRADA} data-grade-colunas />
            </div>
            <div>
              <label class="block text-[0.8125rem] text-texto-2" for="linhas">Linhas</label>
              <input id="linhas" type="number" min={GRADE_MIN} max={GRADE_MAX}
                     value={GRADE_PADRAO.linhas} class={ENTRADA} data-grade-linhas />
