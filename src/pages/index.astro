---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
import fundoHero from "../assets/fundo.png";
import Base from "../layouts/Base.astro";
import BuscaCampos from "../components/BuscaCampos.astro";
import Botao from "../components/Botao.astro";
import { NOME_UF } from "../lib/uf";

const campos = await getCollection("campos", ({ data }) => data.status === "publicado");
const guias = await getCollection("guias", ({ data }) => !data.rascunho);

const estados = [...new Set(campos.map((c) => c.data.uf))]
  .map((uf) => ({ sigla: uf, nome: NOME_UF[uf] ?? uf }))
  .sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR"));

const organizacao = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Comunidade Airsoft",
  url: Astro.site?.href,
  description:
    "Diretório de campos, lojas, operações e equipes de airsoft no Brasil.",
};

const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Comunidade Airsoft",
  url: Astro.site?.href,
  inLanguage: "pt-BR",
};

/**
 * Foto de fundo do hero. O PNG original tem 1,7 MB — passa pelo
 * pipeline do Astro para sair em WebP com hash de cache.
 * Trocar src/assets/fundo.png troca o hero.
 */
const heroLargura = await getImage({
  src: fundoHero,
  format: "webp",
  width: 1920,
  quality: 68,
});
const heroEstreito = await getImage({
  src: fundoHero,
  format: "webp",
  width: 900,
  quality: 62,
});
---

<Base
  titulo="Comunidade Airsoft — campos, lojas e operações de airsoft no Brasil"
  descricao="Onde jogar, onde comprar e com quem jogar airsoft no Brasil. Diretório gratuito de campos, lojas, operações e equipes, com guias para quem está começando."
  dadosEstruturados={[organizacao, site]}
  headerSobreposto
>
  <!-- ==========================================================
       HERO
       A foto vem de src/assets/fundo.png, otimizada para WebP.
       A vinheta é o que garante contraste do texto sobre ela.
       ========================================================== -->
  <section class="relative isolate overflow-hidden bg-fundo">
    <div class="hero-fundo absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="vinheta absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="grade-tatica absolute inset-0 -z-10 opacity-30" aria-hidden="true"></div>

    <!-- Radar decorativo — canto superior esquerdo -->
    <svg
      aria-hidden="true"
      viewBox="0 0 200 200"
      class="pointer-events-none absolute -left-24 top-16 -z-10 hidden h-72 w-72 text-oliva-500/15 lg:block"
      fill="none"
      stroke="currentColor"
    >
      <circle cx="100" cy="100" r="88" stroke-width="1.5" stroke-dasharray="6 5" />
      <circle cx="100" cy="100" r="58" stroke-width="1" />
      <circle cx="100" cy="100" r="28" stroke-width="1" />
      <path d="M100 4v34M100 162v34M4 100h34M162 100h34" stroke-width="1.5" />
    </svg>

    <!-- Coordenadas decorativas — canto inferior esquerdo -->
    <p
      aria-hidden="true"
      class="pointer-events-none absolute bottom-6 left-6 -z-10 hidden font-dado text-[11px] leading-6 tracking-[0.18em] text-oliva-400/50 lg:block"
      set:html={`23&deg; 33' 45&quot; S<br />46&deg; 38' 10&quot; W`}
    />

    <div
      class="mx-auto flex min-h-[640px] max-w-[1240px] items-center px-5 pb-24 pt-36 md:min-h-[760px] md:px-12 md:pb-32 md:pt-44"
    >
      <div class="grid w-full items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]">
        <div>
          <h1
            class="desgaste font-display text-[52px] font-extrabold uppercase italic leading-[0.88] tracking-[0.01em] drop-shadow-[0_4px_24px_rgba(0,0,0,0.85)] md:text-[104px]"
          >
            Onde jogar<br />
            <span class="text-oliva-500">airsoft</span> no<br />
            Brasil
          </h1>

          <p class="mt-7 max-w-[52ch] text-lg leading-relaxed text-texto">
            Campo, operação, loja, equipe e gente para jogar — reunidos em um
            lugar só, <span class="text-oliva-300">de graça</span>. Sem cadastro
            para consultar.
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            <Botao href="/campos">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-[1.15em] w-[1.15em]"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="7" />
                <path d="M12 1v4M12 19v4M1 12h4M19 12h4" stroke-linecap="square" />
              </svg>
              Encontrar um campo
            </Botao>
            <Botao href="/guias/guia-do-iniciante" variante="secundario" seta>
              Estou começando
            </Botao>
          </div>
        </div>

        <nav
          aria-label="Campos por estado"
          class="moldura-tatica border border-borda-forte bg-fundo/80 backdrop-blur-sm"
        >
          <h2 class="rotulo flex items-center gap-2 border-b border-borda p-4">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            Campos por estado
          </h2>

          <ul class="divide-y divide-borda">
            {
              estados.map((estado) => (
                <li>
                  <a
                    href={`/campos/${estado.sigla.toLowerCase()}`}
                    class="group flex items-center justify-between px-4 py-3.5 transition-colors hover:bg-oliva-050"
                  >
                    <span class="font-display text-lg font-bold uppercase tracking-[0.03em] group-hover:text-oliva-300">
                      {estado.nome}
                    </span>
                    <span class="flex items-center gap-2 font-dado text-[11px] tracking-[0.16em] text-oliva-400">
                      {estado.sigla}
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        class="h-3.5 w-3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path d="m9 5 7 7-7 7" stroke-linecap="square" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>

          <a
            href="/campos"
            class="block border-t border-borda p-4 text-center font-display text-base font-bold uppercase tracking-[0.08em] text-oliva-500 transition-colors hover:bg-oliva-050 hover:text-oliva-300"
          >
            Ver todos
          </a>
        </nav>
      </div>
    </div>

    <div class="faixa-perigo absolute inset-x-0 bottom-0" aria-hidden="true"></div>
  </section>

  <!-- ==========================================================
       CAMPOS CADASTRADOS
       ========================================================== -->
  <section class="mx-auto max-w-[1240px] px-5 py-16 md:px-12 md:py-20">
    <div class="flex items-center gap-4">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-6 w-6 shrink-0 text-oliva-500"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <circle cx="12" cy="12" r="7" />
        <path d="M12 1v4M12 19v4M1 12h4M19 12h4" stroke-linecap="square" />
      </svg>
      <h2 class="font-display text-3xl font-bold uppercase tracking-[0.04em]">
        Encontre um campo
      </h2>
      <div class="h-px flex-1 bg-borda"></div>
      <a
        href="/campos"
        class="flex shrink-0 items-center gap-2 font-display text-base font-bold uppercase tracking-[0.08em] text-oliva-500 transition-colors hover:text-oliva-300"
      >
        <span aria-hidden="true" class="text-[10px]">&#9673;</span>
        Ver todos
      </a>
    </div>

    <BuscaCampos campos={campos} quantidade={6} />
  </section>

  <!-- ==========================================================
       GUIAS
       ========================================================== -->
  {
    guias.length > 0 && (
      <section class="mx-auto max-w-[1240px] px-5 pb-20 md:px-12">
        <div class="flex items-center gap-4">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-6 w-6 shrink-0 text-oliva-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M5 3h11l3 3v15H5z" /><path d="M9 9h7M9 13h7M9 17h4" stroke-linecap="square" />
          </svg>
          <h2 class="font-display text-3xl font-bold uppercase tracking-[0.04em]">
            Para quem está começando
          </h2>
          <div class="h-px flex-1 bg-borda" />
        </div>

        <ul class="mt-9 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {guias.slice(0, 4).map((guia) => (
            <li class="moldura-tatica flex flex-col border border-borda bg-papel transition-colors hover:border-oliva-500">
              {guia.data.imagem && (
                <a href={`/guias/${guia.id}`} class="block">
                  <Image
                    src={guia.data.imagem}
                    alt=""
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
                    class="aspect-[16/9] w-full border-b border-borda object-cover"
                    loading="lazy"
                  />
                </a>
              )}
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-xl font-bold uppercase leading-tight tracking-[0.02em]">
                  <a href={`/guias/${guia.id}`} class="transition-colors hover:text-oliva-300">
                    {guia.data.titulo}
                  </a>
                </h3>
                <p class="mt-2 leading-relaxed text-texto-2">{guia.data.resumo}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style
  define:vars={{
    heroLargo: `url('${heroLargura.src}')`,
    heroEstreito: `url('${heroEstreito.src}')`,
  }}
>
  /* A foto do hero é background para poder receber vinheta e grade por
     cima sem empilhar mais elementos. Duas larguras: o celular não
     baixa a versão de 1920px. */
  .hero-fundo {
    background-image: var(--heroEstreito);
    background-size: cover;
    background-position: 62% center;
    background-repeat: no-repeat;
  }

  @media (min-width: 900px) {
    .hero-fundo {
      background-image: var(--heroLargo);
      background-position: center;
    }
  }
</style>
