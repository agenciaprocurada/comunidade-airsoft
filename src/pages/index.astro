---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Botao from "../components/Botao.astro";
import hero from "../assets/home/equipe-em-campo-home-v2.webp";
import campo from "../assets/home/onde-jogar.webp";
import loja from "../assets/home/onde-comprar.webp";
import oficina from "../assets/home/onde-arrumar.webp";
import iniciante from "../assets/guias/guia-do-iniciante.webp";
import mapa from "../assets/mapas/exemplo-mapa-tatico-airsoft-satelite.webp";
import { NOME_UF } from "../lib/uf";
import { EQUIPES_VISIVEIS } from "../lib/flags";
import { carregarUltimosAchados } from "../lib/achados-build";
import CarrosselAchados from "../components/CarrosselAchados.astro";

const [campos, lojas, armeiros, guias, achados] = await Promise.all([
  getCollection("campos", ({ data }) => data.status === "publicado"),
  getCollection("lojas", ({ data }) => data.status === "publicado"),
  getCollection("armeiros", ({ data }) => data.status === "publicado"),
  getCollection("guias", ({ data }) => !data.rascunho),
  // Lidos no build: a faixa muda no próximo deploy (ver achados-build.ts).
  carregarUltimosAchados(5),
]);
const numero = (valor: number) => valor.toLocaleString("pt-BR");
const estados = [...new Set(campos.map(({ data }) => data.uf))]
  .map((uf) => ({ uf, nome: NOME_UF[uf] ?? uf, total: campos.filter(({ data }) => data.uf === uf).length }))
  .sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR"));
const estadosDestaque = [...estados].sort((a, b) => b.total - a.total).slice(0, 5);
const diretorios = [
  { href: "/campos", titulo: "Seu próximo campo.", categoria: "Onde jogar", texto: "Explore terrenos, estrutura e contatos para escolher onde será o próximo jogo.", foto: campo, total: campos.length, unidade: "campos no diretório", acao: "Encontrar campos", icone: "M12 21s7-6 7-12A7 7 0 0 0 5 9c0 6 7 12 7 12ZM9 9a3 3 0 1 0 6 0 3 3 0 0 0-6 0" },
  { href: "/lojas", titulo: "O próximo equipamento.", categoria: "Onde comprar", texto: "Encontre lojas físicas e online para pesquisar réplicas, acessórios e consumíveis.", foto: loja, total: lojas.length, unidade: "lojas no diretório", acao: "Explorar lojas", icone: "M4 8h16l-1 13H5L4 8ZM8 8V6a4 4 0 0 1 8 0v2" },
  { href: "/armeiros", titulo: "Sua réplica em dia.", categoria: "Manutenção e upgrade", texto: "Consulte profissionais, serviços oferecidos e formas de entrar em contato.", foto: oficina, total: armeiros.length, unidade: "armeiros no diretório", acao: "Encontrar armeiros", icone: "M14 3a5 5 0 0 0-5 7L3 16v5h5l6-6a5 5 0 0 0 7-5l-4 2-3-3 2-6Z" },
];
const prioridades = ["como-escolher-a-primeira-replica-de-airsoft", "baterias-para-airsoft-lipo-e-nimh", "upgrade-de-aeg-por-onde-comecar"];
const guiasDestaque = [...guias].filter(({ data }) => data.imagem).sort((a, b) => {
  const ordem = (id: string) => prioridades.includes(id) ? prioridades.indexOf(id) : prioridades.length;
  return ordem(a.id) - ordem(b.id) || b.data.publicado_em.getTime() - a.data.publicado_em.getTime();
}).slice(0, 3);
const whatsapp = "https://chat.whatsapp.com/GbZdm2rFiTD6vLi0FpLpfW";

/**
 * Organization e WebSite ficam no layout Base (src/lib/entidade.ts).
 *
 * As seções principais declaradas como ItemList dão ao Google a chance de
 * montar sitelinks — sem isso ele escolhe sozinho.
 */
const navegacao = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Ferramentas da Comunidade Airsoft",
  itemListElement: [
    { href: "/campos", titulo: "Onde jogar", descricao: "Campos de airsoft por estado e cidade, com estrutura e contatos." },
    { href: "/lojas", titulo: "Onde comprar", descricao: "Lojas físicas e online de réplicas, acessórios e consumíveis." },
    { href: "/armeiros", titulo: "Manutenção e upgrade", descricao: "Armeiros e oficinas para manter a réplica em dia." },
    { href: "/organizador-de-operacoes", titulo: "Organizador de operações", descricao: "Tire sua operação do grupo de WhatsApp: lista, confirmação e briefing." },
    { href: "/criador-de-mapas", titulo: "Criador de mapas táticos", descricao: "Marque safe, respawn, rotas e objetivos sobre o satélite e exporte em PNG." },
    { href: "/calculadora-de-fps", titulo: "Calculadora de FPS", descricao: "Converta FPS e joules e confira o limite do campo." },
    { href: "/guias", titulo: "Guias de airsoft", descricao: "Conteúdo para começar e evoluir no airsoft." },
  ].map((porta, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: porta.titulo,
    description: porta.descricao,
    url: new URL(porta.href, Astro.site).href,
  })),
};
---

<Base titulo="Comunidade Airsoft — campos, lojas, operações e ferramentas de airsoft" descricao="Encontre campos, lojas e armeiros de airsoft no Brasil. Prepare seu jogo com mapas, ferramentas gratuitas e guias para começar e evoluir." dadosEstruturados={[navegacao]} semConviteWhatsApp>
  <div class="home-v2">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-photo" aria-hidden="true"><Image src={hero} alt="" widths={[640, 960, 1536]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
      <div class="wrap hero-content">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span> De jogador para jogador / Brasil</p>
        <h1 id="home-title">O airsoft conecta.<br /><span>O próximo jogo<br />começa aqui.</span></h1>
        <p class="hero-intro">Encontre onde jogar, prepare seu equipamento e leve um plano para o campo. Tudo em uma comunidade feita para quem vive o airsoft.</p>
        <div class="actions"><Botao href="#encontre-seu-campo">Encontrar onde jogar <span aria-hidden="true">↗</span></Botao><a href="/primeiro-jogo-de-airsoft" class="text-link">Nunca jogou? Comece aqui <span aria-hidden="true">→</span></a></div>
        <p class="hero-note">Campos, lojas e guias abertos para consulta. Sem cadastro.</p>
        <a href="#organize-sua-operacao" class="organizer-shortcut">Organiza jogos? <strong>Tire sua operação do WhatsApp</strong> <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-caption" aria-hidden="true"><span>01 / Conexão em campo</span><span>O melhor do jogo é quem joga com você.</span></div>
    </section>


    {/* O mesmo carrossel dos guias e das fichas — um visual só para manter. */}
    {achados.length > 0 && <section id="achados" class="deals-section" aria-label="Últimos achadinhos"><div class="wrap"><CarrosselAchados achados={achados} posicao="home" titulo="Últimos achadinhos" /></div></section>}

    <section id="encontre-seu-campo" class="finder-section" aria-labelledby="finder-title">
      <div class="wrap finder">
        <div class="finder-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="7"/><path d="M12 1v5M12 18v5M1 12h5M18 12h5"/></svg><div><p class="eyebrow">Encontre seu lugar no jogo</p><h2 id="finder-title">Por onde você joga?</h2></div></div>
        <form class="state-form" data-state-form hidden action="/campos" method="get"><div><label for="home-state">Escolha seu estado</label><select id="home-state" name="estado"><option value="">Todo o Brasil</option>{estados.map(({ uf, nome }) => <option value={uf.toLowerCase()}>{nome}</option>)}</select></div><button type="submit">Ver campos <span aria-hidden="true">→</span></button></form>
        <a class="finder-fallback text-link" data-state-fallback href="/campos">Explorar todos os campos →</a>
        <div class="state-shortcuts"><span>Explore também</span>{estadosDestaque.map(({ uf, nome }) => <a href={`/campos/${uf.toLowerCase()}`}>{nome}</a>)}<a href="/campos">Todos os estados ↗</a></div>
      </div>
    </section>

    <section id="explorar" class="wrap section" aria-labelledby="explore-title">
      <div class="heading"><div><p class="eyebrow">01 / Encontre o que precisa</p><h2 id="explore-title">Menos procura.<br /><span>Mais tempo de jogo.</span></h2></div><p>Do campo à bancada de manutenção, encontre os contatos que fazem parte da sua rotina de jogador.</p></div>
      <div class="directory-grid">{diretorios.map((item) => <a href={item.href} class="directory-card"><div class="directory-image"><Image src={item.foto} alt="" widths={[420, 840]} sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" loading="lazy" /><span class="directory-category"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d={item.icone}/></svg>{item.categoria}</span><span class="card-arrow" aria-hidden="true">↗</span></div><div class="directory-copy"><p class="eyebrow">{item.total > 0 ? `${numero(item.total)} ${item.unidade}` : "Explore o diretório"}</p><h3>{item.titulo}</h3><p>{item.texto}</p><span class="card-action">{item.acao}<span aria-hidden="true">→</span></span></div></a>)}</div>
      <div class="catalog-note"><span class="dot" aria-hidden="true"></span> Consulta gratuita. O contato é direto com cada campo, loja ou profissional.</div>
    </section>

    <section id="ferramentas" class="tools-section" aria-labelledby="tools-title"><div class="wrap section">
      <div class="heading"><div><p class="eyebrow">02 / Prepare o próximo jogo</p><h2 id="tools-title">O briefing começa<br /><span>antes de chegar.</span></h2></div><p>Ferramentas gratuitas para transformar as ideias da equipe em um jogo organizado.</p></div>
      <article id="organize-sua-operacao" class="operation-feature" aria-labelledby="operation-title">
        <div class="operation-copy">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Organizador de operações · Gratuito</p>
          <h3 id="operation-title">Tire sua operação<br />do grupo de<br /><span>WhatsApp.</span></h3>
          <p>Chega de procurar confirmações no meio das mensagens. Crie a operação, mande um link no grupo e acompanhe as inscrições em um só lugar.</p>
          <ul><li>Vagas e confirmações por lado</li><li>Lista de espera automática</li><li>Controle de quem pagou e quem chegou</li></ul>
          <Botao href="/organizador-de-operacoes">Quero organizar minha operação <span aria-hidden="true">↗</span></Botao>
          <p class="operation-note">Sem mensalidade nem taxa por inscrição. Funciona no celular.</p>
        </div>
        <div class="operation-preview" role="img" aria-label="Exemplo ilustrativo do painel: operação com 38 de 40 vagas preenchidas, três pessoas na espera e inscrições organizadas por lado.">
          <div class="operation-preview-top"><span>Painel do organizador</span><span>Exemplo ilustrativo</span></div>
          <div class="operation-preview-body">
            <p class="eyebrow">Próxima missão</p><h4>Operação Fronteira</h4>
            <div class="operation-stats"><div><strong>38<span>/40</span></strong><span>Vagas preenchidas</span></div><div><strong>03</strong><span>Na espera</span></div></div>
            <div class="team-row"><span><i class="team-dot" aria-hidden="true"></i> Equipe Alfa</span><strong>18 / 20</strong></div><div class="team-progress" aria-hidden="true"><span style="width:90%"></span></div>
            <div class="team-row"><span><i class="team-dot bravo" aria-hidden="true"></i> Equipe Bravo</span><strong>20 / 20</strong></div><div class="team-progress bravo" aria-hidden="true"><span style="width:100%"></span></div>
            <div class="operation-notice"><span aria-hidden="true">✓</span><p>Lado cheio? A próxima inscrição<br />entra na lista de espera.</p></div>
            <div class="operation-preview-footer"><span>Inscrições</span><span>Pagamentos</span><span>Presenças</span></div>
          </div>
        </div>
      </article>
      <article class="map-feature"><div class="map-copy"><p class="pill">Criador de mapas táticos</p><h3>Seu campo.<br />Sua estratégia.</h3><p>Marque safe, respawn, rotas e objetivos sobre o satélite. Exporte o mapa em PNG e envie no grupo antes da operação.</p><a href="/mapas-v2" class="dark-button">Conhecer o criador de mapas <span aria-hidden="true">↗</span></a><p class="access-note">Para editar: Google, perfil completo e uma réplica cadastrada.</p></div><figure class="map-preview"><div class="preview-bar"><span class="dot" aria-hidden="true"></span> Do terreno ao plano <span>Exemplo de mapa</span></div><a href="/mapas-v2" aria-label="Conhecer o criador de mapas e seus exemplos"><Image src={mapa} alt="Mapa de satélite com grade de setores, setas e áreas de safezone, respawn e CQB demarcadas." widths={[640, 960, 1280]} sizes="(min-width: 900px) 55vw, 100vw" loading="lazy" /></a><figcaption><span>LOCALIZAR</span><span aria-hidden="true">→</span><span>PLANEJAR</span><span aria-hidden="true">→</span><span>COMPARTILHAR</span></figcaption></figure></article>
      <div class="small-tools"><a href="/calculadora-de-fps"><span class="tool-icon" aria-hidden="true">FPS<span>↔ J</span></span><div><p class="eyebrow">Calculadora de FPS</p><h3>Conheça os números da sua réplica.</h3><p>Converta FPS e joules considerando o peso da BB.</p></div><span class="tool-arrow" aria-hidden="true">↗</span></a></div>
    </div></section>

    <section class="wrap section beginner" aria-labelledby="beginner-title"><div class="beginner-photo"><Image src={iniciante} alt="Jogador iniciante recebe orientação de um participante experiente na área de preparação do campo." widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" /><div class="photo-label"><span class="dot" aria-hidden="true"></span> Todo jogador já teve um primeiro dia.</div></div><div class="beginner-copy"><p class="eyebrow">03 / Seu primeiro jogo</p><h2 id="beginner-title">Você não precisa<br />chegar sabendo.<br /><span>Só começar.</span></h2><p>O que vestir, o que levar e como funciona uma partida. Entenda o básico antes de escolher o campo e comprar equipamento.</p><ul><li><span aria-hidden="true">01</span> Entenda o dia de jogo</li><li><span aria-hidden="true">02</span> Saiba o que perguntar sobre aluguel</li><li><span aria-hidden="true">03</span> Prepare-se para a primeira experiência</li></ul><Botao href="/primeiro-jogo-de-airsoft">Quero jogar pela primeira vez <span aria-hidden="true">→</span></Botao></div></section>

    {guiasDestaque.length > 0 && <section class="guides-section" aria-labelledby="guides-title"><div class="wrap section"><div class="heading"><div><p class="eyebrow">04 / Repertório para o jogo</p><h2 id="guides-title">Aprenda fora.<br /><span>Aproveite em campo.</span></h2></div><a href="/guias" class="text-link">Explorar os {numero(guias.length)} guias <span aria-hidden="true">↗</span></a></div><div class="guides-grid">{guiasDestaque.map((guia) => <article class="guide-card"><a href={`/guias/${guia.id}`}><div class="guide-image">{guia.data.imagem && <Image src={guia.data.imagem} alt={guia.data.imagem_alt ?? ""} widths={[420, 840]} sizes="(min-width: 900px) 33vw, 100vw" loading="lazy" />}<span class="guide-category">{guia.data.categoria}</span></div><div class="guide-copy"><h3>{guia.data.titulo}</h3><p>{guia.data.resumo}</p><span class="card-action">Ler guia <span aria-hidden="true">↗</span></span></div></a></article>)}</div></div></section>}

    <section class="community-section" aria-labelledby="community-title"><div class="wrap section community"><div class="community-copy"><p class="eyebrow">A comunidade continua fora do campo</p><h2 id="community-title">O jogo é melhor<br /><span>com gente junto.</span></h2><p>Encontre outros jogadores, troque experiências e acompanhe as conversas da Comunidade Airsoft no grupo oficial.</p><Botao href={whatsapp} target="_blank" rel="noopener noreferrer">Entrar no grupo do WhatsApp <span aria-hidden="true">↗</span></Botao><p class="external-note">Abre o grupo oficial no WhatsApp.</p></div><div class="community-paths">{EQUIPES_VISIVEIS && <a href="/equipes"><span class="path-number" aria-hidden="true">01</span><div><h3>Encontre sua equipe</h3><p>Conheça os times da comunidade e veja quem está recrutando.</p></div><span aria-hidden="true">↗</span></a>}<a href="/enviar-campo"><span class="path-number" aria-hidden="true">02</span><div><h3>Seu campo ainda não está aqui?</h3><p>Envie as informações para avaliação e ajude o diretório a crescer.</p></div><span aria-hidden="true">↗</span></a><a href="/conta"><span class="path-number" aria-hidden="true">03</span><div><h3>Monte sua ficha de jogador</h3><p>Acesse sua conta e as ferramentas da comunidade.</p></div><span aria-hidden="true">↗</span></a></div></div></section>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-state-form]");
  const select = document.querySelector<HTMLSelectElement>("#home-state");
  const fallback = document.querySelector<HTMLElement>("[data-state-fallback]");
  if (form && select) {
    form.hidden = false;
    if (fallback) fallback.hidden = true;
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const uf = select.value;
      window.location.assign(uf ? `/campos/${encodeURIComponent(uf)}` : "/campos");
    });
  }
</script>

<style>
  .home-v2 { --accent: #bbcd91; --muted: #aab29f; --sand: #e8e3d5; --color-oliva-500: #afc580; --color-oliva-400: #c4d99c; --color-oliva-300: #c4d99c; background: #0d120e; color: #f1f2e9; }
  .wrap { width: min(1240px, calc(100% - 64px)); margin-inline: auto; }
  .section { padding-block: 96px; }
  section[id] { scroll-margin-top: 112px; }
  .eyebrow { font: 12px/1.5 var(--font-dado); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .dot { display: inline-block; width: 6px; height: 6px; background: var(--accent); flex-shrink: 0; }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 700; }
  h1 { font-size: clamp(62px, 6.7vw, 96px); text-transform: uppercase; line-height: .94; letter-spacing: -.025em; font-weight: 800; margin-top: 26px; }
  h1 > span, h2 > span { color: var(--accent); }
  h2 { font-size: clamp(40px, 4.3vw, 60px); line-height: 1; text-transform: uppercase; letter-spacing: -.015em; margin-top: 14px; }
  h3 { font-size: 28px; line-height: 1.1; }
  p { color: #d2d8c9; }
  a, button { -webkit-tap-highlight-color: transparent; }
  .hero { position: relative; isolation: isolate; overflow: hidden; background: #172014; }
  .hero-photo { position: absolute; inset: 0; z-index: -2; }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 18%; }
  .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(7 14 9 / .92), rgb(7 14 9 / .62) 42%, rgb(7 14 9 / .05) 76%), linear-gradient(0deg, #101810, transparent 38%); }
  .hero-content { padding-block: 88px 92px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 10px; }
  .hero-intro { font-size: 19px; max-width: 45ch; line-height: 1.6; margin-top: 26px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 32px; }
  .text-link { display: inline-flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; font-size: 16px; font-weight: 600; text-underline-offset: 5px; }
  .text-link:hover { color: var(--accent); text-decoration: underline; }
  .hero-note { font-size: 14px; color: #b8c1ac; margin-top: 18px; }
  .hero-caption { position: absolute; right: max(32px, calc((100vw - 1240px) / 2)); bottom: 40px; display: grid; gap: 8px; text-align: right; border-right: 2px solid var(--accent); padding-right: 16px; }
  .hero-caption span:first-child { font: 11px var(--font-dado); letter-spacing: .1em; color: var(--accent); text-transform: uppercase; }
  .hero-caption span:last-child { font-size: 14px; color: #d4d9ca; }
  .deals-section { background: #121a10; border-bottom: 1px solid #303e26; padding-block: 8px; }
  .finder-section { background: #1c2719; border-block: 1px solid #405237; }
  .finder { display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; padding-block: 30px 22px; }
  .finder-title { display: flex; align-items: center; gap: 20px; }
  .finder-title > svg { width: 40px; height: 40px; color: var(--accent); }
  .finder h2 { font-size: 32px; text-transform: none; margin-top: 5px; }
  .state-form { display: flex; gap: 12px; align-items: end; }
  .state-form[hidden], [data-state-fallback][hidden] { display: none; }
  .state-form > div { flex: 1; }
  .state-form label { display: block; font-size: 13px; color: #c4ceb9; margin-bottom: 6px; }
  .state-form select { width: 100%; height: 50px; padding: 0 38px 0 15px; background: #111a0f; border: 1px solid #78876a; color: #e9eedf; font-size: 16px; }
  .state-form button { height: 50px; display: flex; align-items: center; gap: 22px; padding-inline: 22px; background: var(--accent); color: #131c0c; font: 700 18px var(--font-display); text-transform: uppercase; cursor: pointer; }
  .state-form button:hover { background: #d0e0ad; }
  .state-shortcuts { grid-column: 1 / -1; display: flex; align-items: center; flex-wrap: wrap; gap: 8px 20px; margin-top: 22px; border-top: 1px solid #39462f; padding-top: 14px; }
  .state-shortcuts > span { color: #a0ae91; font-size: 13px; margin-right: 4px; }
  .state-shortcuts a { min-height: 36px; display: inline-flex; align-items: center; font-size: 14px; color: #d1dbc4; text-underline-offset: 4px; }
  .state-shortcuts a:hover { text-decoration: underline; color: white; }
  .heading { display: flex; align-items: end; justify-content: space-between; gap: 36px; margin-bottom: 40px; }
  .heading > p { max-width: 38ch; color: var(--muted); }
  .directory-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .directory-card { display: flex; flex-direction: column; border: 1px solid #34422a; background: #151d12; transition: border-color .2s; }
  .directory-card:hover { border-color: var(--accent); }
  .directory-image { position: relative; overflow: hidden; }
  .directory-image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, #151d12, transparent 55%); pointer-events: none; }
  .directory-image img { width: 100%; aspect-ratio: 1.5; object-fit: cover; object-position: center 55%; transition: transform .4s; }
  .directory-card:hover img { transform: scale(1.035); }
  .directory-category { position: absolute; bottom: 18px; left: 24px; z-index: 1; display: flex; align-items: center; gap: 10px; font: 700 24px var(--font-display); text-transform: uppercase; }
