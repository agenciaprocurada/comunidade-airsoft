---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import heroDesktop from "../assets/hero-fundo.webp";
import heroMobile from "../assets/hero-fundo-mobile.webp";
import Base from "../layouts/Base.astro";
import BuscaCampos from "../components/BuscaCampos.astro";
import Botao from "../components/Botao.astro";
import { EQUIPES_VISIVEIS } from "../lib/flags";

const campos = await getCollection("campos", ({ data }) => data.status === "publicado");
const lojas = await getCollection("lojas", ({ data }) => data.status === "publicado");
const armeiros = await getCollection("armeiros", ({ data }) => data.status === "publicado");
const guias = await getCollection("guias", ({ data }) => !data.rascunho);

/** Quantos guias a home mostra antes do botao para o catalogo completo. */
const GUIAS_NA_HOME = 3;

/**
 * A lista do subtitulo do hero segue a flag, nao uma string fixa.
 *
 * Enquanto EQUIPES_VISIVEIS for false nao existe porta de entrada para
 * equipes no site: prometer no hero o que o visitante nao acha e pior do
 * que nao prometer. Ligou a flag, a palavra volta sozinha e ninguem
 * precisa lembrar de vir editar este paragrafo.
 */
const oQueTem = [
  "Campos",
  "operações",
  "lojas",
  "armeiros",
  ...(EQUIPES_VISIVEIS ? ["equipes"] : []),
  "guias",
  "ferramentas",
  "informações",
];

const listaHero = `${oQueTem.slice(0, -1).join(", ")} e ${oQueTem.at(-1)}`;

/**
 * Sorteio no build — o mesmo criterio dos campos. Site estatico sorteado so
 * aqui daria os mesmos tres guias para todo visitante ate o proximo deploy,
 * entao o script abaixo do <ul> reembaralha no navegador. O sorteio no build
 * existe para o HTML indexavel tambem variar.
 */
const sorteioGuias = [...guias];
for (let i = sorteioGuias.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [sorteioGuias[i], sorteioGuias[j]] = [sorteioGuias[j], sorteioGuias[i]];
}

/**
 * Contagem so vira rotulo quando existe. Diretorio que nasce vazio — o de
 * armeiros e assim — anunciaria "0 armeiros" no cartao, que e pior do que
 * nao dizer numero nenhum.
 */
const contagem = (total: number, singular: string, plural: string, vazio: string) =>
  total > 0 ? `${total} ${total === 1 ? singular : plural}` : vazio;

/**
 * Fundos dos cartoes — OPCIONAIS de proposito.
 *
 * Um `import` direto de imagem que nao existe quebra o build inteiro. Como
 * as fotos entram uma de cada vez (e podem nunca entrar), o glob varre a
 * pasta e devolve so o que esta la: cartao sem foto renderiza no fundo
 * escuro e ninguem percebe falta. Basta soltar o .webp com o nome certo em
 * src/assets/home/ que ele aparece no proximo build, sem tocar neste arquivo.
 */
const arquivosFundo = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/home/*.webp",
  { eager: true },
);

const fundo = (nome: string): ImageMetadata | undefined =>
  arquivosFundo[`../assets/home/${nome}.webp`]?.default;

/**
 * ==========================================================
 * GATEWAY — as seis portas do site
 * ==========================================================
 * A home nao tenta ser uma das ferramentas: ela pergunta o que o jogador
 * veio fazer e entrega. O criador de mapa vem primeiro porque e a unica
 * coisa aqui que nao existe em nenhum outro lugar.
 *
 * Os rotulos repetem a pergunta do jogador ("onde arrumar"), nao o nome
 * interno da secao ("armeiros"). As URLs, essas, estao congeladas: mudar
 * rotulo e de graca, mudar URL custa ranking.
 */
const portas = [
  {
    href: "/criador-de-mapas",
    titulo: "Criador de mapa estratégico",
    descricao:
      "Desenhe o mapa da sua operação: áreas, símbolos e objetivos sobre o satélite do campo.",
    dado: "Ferramenta grátis",
    acao: "Criar mapa",
    fundo: fundo("criador-de-mapa"),
    icone: `<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z" /><path d="M9 4v14M15 6v14" />`,
  },
  {
    /*
      Segunda porta de proposito: as duas ferramentas ficam lado a lado.
      Entrou no lugar de /operacoes, que segue no rodape e na ficha dos
      campos.
    */
    href: "/calculadora-de-fps",
    titulo: "Calculadora de FPS",
    descricao:
      "Converta FPS em joules, veja quanto sua réplica marca com cada BB e confira se passa no limite do campo.",
    dado: "Ferramenta grátis",
    acao: "Calcular",
    fundo: fundo("calculadora-de-fps"),
    // Cronografo: a caixa com o tunel e o mostrador.
    icone: `<path d="M3 8h18v9H3z" /><circle cx="15.5" cy="12.5" r="2.5" /><path d="M6 11v3M9 11v3" stroke-linecap="square" />`,
  },
  {
    href: "/campos",
    titulo: "Onde jogar",
    descricao:
      "Encontre campos de airsoft perto de você, com estrutura, preço e contato de cada um.",
    dado: contagem(campos.length, "campo", "campos", "Diretório nacional"),
    acao: "Ver campos",
    fundo: fundo("onde-jogar"),
    icone: `<circle cx="12" cy="12" r="7" /><path d="M12 1v4M12 19v4M1 12h4M19 12h4" stroke-linecap="square" />`,
  },
  {
    href: "/lojas",
    titulo: "Onde comprar",
    descricao:
      "O acervo mais completo de lojas de airsoft do Brasil — online e de porta aberta.",
    dado: contagem(lojas.length, "loja", "lojas", "Diretório nacional"),
    acao: "Ver lojas",
    fundo: fundo("onde-comprar"),
    icone: `<path d="M4 8h16l-1.2 13H5.2z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" />`,
  },
  {
    href: "/armeiros",
    titulo: "Onde arrumar",
    descricao:
      "A lista dos armeiros do Brasil: quem abre a sua réplica, o que faz e quem recebe pelo correio.",
    dado: contagem(armeiros.length, "armeiro", "armeiros", "Manutenção e upgrade"),
    acao: "Ver armeiros",
    fundo: fundo("onde-arrumar"),
    icone: `<path d="M15.5 3.5a5 5 0 0 0-6 6.6L3 16.6V21h4.4l6.5-6.5a5 5 0 0 0 6.6-6l-3.1 3.1-2.9-.6-.6-2.9z" />`,
  },
  {
    href: "/guias",
    titulo: "Guia de airsoft",
    descricao:
      "Aprenda do básico ao avançado: primeira réplica, bateria, FPS, manutenção e regras de jogo.",
    dado: contagem(guias.length, "guia", "guias", "Do básico ao avançado"),
    acao: "Ver guias",
    fundo: fundo("guia-de-airsoft"),
    icone: `<path d="M5 3h11l3 3v15H5z" /><path d="M9 9h7M9 13h7M9 17h4" stroke-linecap="square" />`,
  },
];

/**
 * Selos — a barra que fecha o gateway. Promessa do site, nao metrica: o
 * unico numero que aparece ali e "100%", que e figura de linguagem. Numero
 * de verdade envelhece e vira mentira sozinho.
 */
const selos = [
  {
    texto: "Conteúdo confiável e atualizado",
    icone: `<path d="M12 2.5 4 5.5v6.2c0 4.6 3.3 8.2 8 9.8 4.7-1.6 8-5.2 8-9.8V5.5z" /><path d="m8.6 12 2.4 2.4 4.4-4.6" stroke-linecap="square" />`,
  },
  {
    texto: "Comunidade ativa",
    icone: `<circle cx="9" cy="8" r="3.2" /><path d="M2.8 20a6.2 6.2 0 0 1 12.4 0" /><path d="M16.2 5.4a3.2 3.2 0 0 1 0 5.2M18 20a6.2 6.2 0 0 0-2.6-5" />`,
  },
  {
    texto: "Focado em jogabilidade e experiência real",
    icone: `<circle cx="12" cy="12" r="7" /><path d="M12 1v4M12 19v4M1 12h4M19 12h4" stroke-linecap="square" />`,
  },
  {
    texto: "100% feito para airsofters",
    icone: `<path d="M5 10.5h14V21H5z" /><path d="M8.2 10.5V7a3.8 3.8 0 0 1 7.6 0v3.5" />`,
  },
];

/**
 * Organization e WebSite nao ficam mais aqui: o layout Base emite a entidade
 * (src/lib/entidade.ts) em toda pagina, com o mesmo @id.
 *
 * O gateway declarado como ItemList e o que da ao Google a chance de montar
 * sitelinks para as seis secoes — sem isso ele escolhe sozinho.
 */
const navegacao = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Ferramentas da Comunidade Airsoft",
  itemListElement: portas.map((porta, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: porta.titulo,
    description: porta.descricao,
    url: new URL(porta.href, Astro.site).href,
  })),
};
---

<Base
  titulo="Comunidade Airsoft — campos, lojas, operações e ferramentas de airsoft"
  descricao="Tudo de airsoft no Brasil em um lugar só: onde jogar, onde comprar, onde arrumar sua réplica, a agenda de operações, os guias e o criador de mapa tático. De graça, sem cadastro para consultar."
  dadosEstruturados={[navegacao]}
  headerSobreposto
>
  <!-- ==========================================================
       HERO
       A foto vem de src/assets/hero-fundo.webp (e -mobile.webp).
       A arte ja vem escurecida de fabrica, entao nao ha vinheta por cima.

       Sem botao de CTA aqui: o gateway logo abaixo E o CTA, e repetir
       "encontrar um campo" dois blocos seguidos so rouba o clique de si mesmo.
       ========================================================== -->
  <section class="relative isolate overflow-hidden bg-fundo">
    <div class="hero-fundo absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="grade-tatica absolute inset-0 -z-10 opacity-30" aria-hidden="true"></div>

    <!-- Radar decorativo — canto superior esquerdo -->
    <svg
      aria-hidden="true"
      viewBox="0 0 200 200"
      class="pointer-events-none absolute -left-24 top-16 -z-10 hidden h-72 w-72 text-oliva-500/15 lg:block"
      fill="none"
      stroke="currentColor"
    >
      <circle cx="100" cy="100" r="88" stroke-width="1.5" stroke-dasharray="6 5" />
      <circle cx="100" cy="100" r="58" stroke-width="1" />
      <circle cx="100" cy="100" r="28" stroke-width="1" />
      <path d="M100 4v34M100 162v34M4 100h34M162 100h34" stroke-width="1.5" />
    </svg>

    <!-- Coordenadas decorativas — canto inferior esquerdo -->
    <p
      aria-hidden="true"
      class="pointer-events-none absolute bottom-6 left-6 -z-10 hidden font-dado text-[11px] leading-6 tracking-[0.18em] text-oliva-400/50 lg:block"
      set:html={`23&deg; 33' 45&quot; S<br />46&deg; 38' 10&quot; W`}
    />

    <div
      class="mx-auto flex min-h-[640px] max-w-[1240px] items-center px-5 pb-24 pt-64 md:min-h-[760px] md:px-12 md:pb-32 md:pt-44"
    >
      <div class="w-full max-w-[880px]">
        <h1
          class="desgaste font-display text-[30px] font-extrabold uppercase italic leading-[0.94] tracking-[0.01em] drop-shadow-[0_4px_24px_rgba(0,0,0,0.85)] md:text-[54px] lg:text-[62px]"
        >
          A maior plataforma de informações e descoberta do <span class="text-oliva-500">airsoft</span> no Brasil
        </h1>

        <p class="mt-7 max-w-[62ch] text-lg leading-relaxed text-texto drop-shadow-[0_2px_10px_rgba(0,0,0,0.95)]">
          {listaHero} para quem joga ou quer começar no airsoft.
        </p>
      </div>
    </div>

    <div class="faixa-perigo absolute inset-x-0 bottom-0" aria-hidden="true"></div>
  </section>

  <!-- ==========================================================
       GATEWAY — o bloco principal da home
       ========================================================== -->
  <section class="relative isolate overflow-hidden bg-fundo py-16 md:py-24">
    <div class="grade-tatica absolute inset-0 -z-10 opacity-25" aria-hidden="true"></div>

    <div class="mx-auto max-w-[1240px] px-5 md:px-12">
      <p class="rotulo flex items-center justify-center gap-3">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-3.5 w-3.5 shrink-0 text-oliva-500"
          fill="currentColor"
        >
          <rect x="2" y="2" width="8.5" height="8.5" />
          <rect x="13.5" y="2" width="8.5" height="8.5" />
          <rect x="2" y="13.5" width="8.5" height="8.5" />
          <rect x="13.5" y="13.5" width="8.5" height="8.5" />
        </svg>
        Tudo que você precisa
      </p>

      {/*
        Os tracos que ladeiam o titulo sao um SVG so, espelhado no eixo X
        para o lado direito. Decorativo: some abaixo de lg, onde nao ha
        largura para eles sem espremer o titulo.
      */}
      <div class="mt-5 flex items-center justify-center gap-8">
        <svg
          aria-hidden="true"
          viewBox="0 0 168 26"
          class="hidden h-6 w-[168px] shrink-0 text-oliva-700 lg:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M0 7h104l10 10h54" />
          <path d="M40 24h64l10-10h54" opacity="0.45" />
        </svg>

        <h2
          class="text-center font-display text-[34px] font-extrabold uppercase leading-[0.95] tracking-[0.01em] md:text-[64px]"
        >
          O que você veio <span class="text-oliva-500">fazer?</span>
        </h2>

        <svg
          aria-hidden="true"
          viewBox="0 0 168 26"
          class="hidden h-6 w-[168px] shrink-0 -scale-x-100 text-oliva-700 lg:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M0 7h104l10 10h54" />
          <path d="M40 24h64l10-10h54" opacity="0.45" />
        </svg>
      </div>

      <p class="mx-auto mt-5 max-w-[64ch] text-center text-lg leading-relaxed text-texto-2">
        Explore ferramentas, locais, lojas e conteúdos para viver o airsoft ao
        máximo.
      </p>

      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          portas.map((porta) => (
            <li class="chanfro-moldura group flex bg-borda-forte/70 transition-colors focus-within:bg-oliva-500 hover:bg-oliva-500">
              <div class="chanfro-miolo relative isolate flex w-full flex-col overflow-hidden bg-papel p-6 md:p-7">
                {porta.fundo && (
                  <>
                    <Image
                      src={porta.fundo}
                      alt=""
                      widths={[420, 840]}
                      sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
                      class="absolute inset-0 -z-20 h-full w-full object-cover"
                      loading="lazy"
                    />
                    <div class="vinheta-cartao absolute inset-0 -z-10" aria-hidden="true" />
                  </>
                )}

                <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center border border-oliva-700 bg-fundo/60 transition-colors group-hover:border-oliva-500">
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    class="h-7 w-7 text-oliva-300"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    set:html={porta.icone}
                  />
                </span>

                <p class="rotulo mt-6">{porta.dado}</p>

                <h3 class="mt-2 font-display text-[26px] font-bold uppercase leading-[1.05] tracking-[0.02em] [text-shadow:0_2px_12px_rgba(11,13,9,0.95)]">
                  <a
                    href={porta.href}
                    class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-oliva-300"
                  >
                    {porta.titulo}
                  </a>
                </h3>

                <p class="mt-3 flex-1 leading-relaxed text-texto-2 [text-shadow:0_1px_9px_rgba(11,13,9,0.98)]">{porta.descricao}</p>

                {/* Decorativo: o ::after do titulo ja faz o cartao inteiro clicavel. */}
                <span
                  aria-hidden="true"
                  class="mt-7 inline-flex items-center gap-2 font-display text-sm font-bold uppercase tracking-[0.12em] text-oliva-500 transition-colors group-hover:text-oliva-300"
                >
                  {porta.acao}
                  <svg
                    viewBox="0 0 24 24"
                    class="h-[1.1em] w-[1.1em] transition-transform group-hover:translate-x-1"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path d="M4 12h15m-6-6 6 6-6 6" stroke-linecap="square" />
                  </svg>
                </span>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- Barra de selos — fecha o gateway -->
      <div class="chanfro-moldura mt-5 bg-borda-forte/70">
        <ul
          class="chanfro-miolo grid gap-y-7 bg-papel/50 px-6 py-8 sm:grid-cols-2 md:px-10 lg:grid-cols-4"
        >
          {
            selos.map((selo, i) => (
              <li
                class:list={[
                  "flex items-center gap-4 lg:px-6",
                  // Divisor so entre colunas, e so onde as quatro estao na
                  // mesma linha — em duas colunas a linha cairia no meio.
                  i > 0 && "lg:border-l lg:border-borda",
                  i === 0 && "lg:pl-0",
                ]}
              >
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="h-7 w-7 shrink-0 text-oliva-300"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  set:html={selo.icone}
                />
                <span class="text-[15px] leading-snug text-texto">{selo.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       CAMPOS CADASTRADOS
       ========================================================== -->
  <section class="mx-auto max-w-[1240px] border-t border-borda px-5 py-16 md:px-12 md:py-20">
    <div class="flex items-center gap-4">
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-6 w-6 shrink-0 text-oliva-500"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <circle cx="12" cy="12" r="7" />
        <path d="M12 1v4M12 19v4M1 12h4M19 12h4" stroke-linecap="square" />
      </svg>
      <h2 class="font-display text-3xl font-bold uppercase tracking-[0.04em]">
        Encontre um campo
      </h2>
      <div class="h-px flex-1 bg-borda"></div>
      <a
        href="/campos"
        class="flex shrink-0 items-center gap-2 font-display text-base font-bold uppercase tracking-[0.08em] text-oliva-500 transition-colors hover:text-oliva-300"
      >
        <span aria-hidden="true" class="text-[10px]">&#9673;</span>
        Ver todos
      </a>
    </div>

    <BuscaCampos campos={campos} quantidade={6} />
  </section>

  <!-- ==========================================================
       GUIAS
       ========================================================== -->
  {
    guias.length > 0 && (
      <section class="mx-auto max-w-[1240px] border-t border-borda px-5 py-16 md:px-12 md:py-20">
        <div class="flex items-center gap-4">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="h-6 w-6 shrink-0 text-oliva-500"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M5 3h11l3 3v15H5z" /><path d="M9 9h7M9 13h7M9 17h4" stroke-linecap="square" />
          </svg>
          <h2 class="font-display text-3xl font-bold uppercase tracking-[0.04em]">
            Para quem está começando
          </h2>
          <div class="h-px flex-1 bg-borda" />
        </div>

        {/*
          Todos os guias vao para o HTML e o script mostra tres. Parece
          desperdicio, mas nao e: imagem dentro de elemento oculto nao e
          baixada pelo navegador, entao o custo real e so markup — e em
          troca a home linka o catalogo inteiro, o que distribui autoridade
          interna para os guias.
        */}
        <ul data-guias class="mt-9 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {sorteioGuias.map((guia, i) => (
            <li
              data-guia
              class:list={[
                "moldura-tatica group relative isolate flex flex-col border border-borda bg-papel transition-colors focus-within:border-oliva-500 hover:border-oliva-500",
                i >= GUIAS_NA_HOME && "hidden",
              ]}
            >
              {guia.data.imagem && (
                <div class="block" aria-hidden="true">
                  <Image
                    src={guia.data.imagem}
                    alt=""
                    widths={[400, 800]}
                    sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
                    class="aspect-[16/9] w-full border-b border-borda object-cover"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-xl font-bold uppercase leading-tight tracking-[0.02em]">
                  <a
                    href={`/guias/${guia.id}`}
                    class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-oliva-300"
                  >
                    {guia.data.titulo}
                  </a>
                </h3>
                <p class="mt-2 leading-relaxed text-texto-2">{guia.data.resumo}</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="mt-9 flex justify-center">
          <Botao href="/guias" variante="secundario" seta>
            Ver mais conteúdos
          </Botao>
        </div>

        <script is:inline define:vars={{ GUIAS_NA_HOME }}>
          // Reembaralha os guias a cada visita. Sem este script o visitante ve
          // os tres sorteados no build, que ja e um resultado correto — por
          // isso nada aqui e obrigatorio para a pagina funcionar.
          (() => {
            const lista = document.querySelector("[data-guias]");
            if (!lista) return;

            const itens = [...lista.querySelectorAll("[data-guia]")];
            for (let i = itens.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [itens[i], itens[j]] = [itens[j], itens[i]];
            }

            // Reordena de verdade no DOM: so trocar a visibilidade deixaria a
            // ordem de leitura brigando com a ordem visual.
            lista.append(...itens);
            itens.forEach((item, i) =>
              item.classList.toggle("hidden", i >= GUIAS_NA_HOME),
            );
          })();
        </script>
      </section>
    )
  }
</Base>

<style
  define:vars={{
    heroDesktop: `url('${heroDesktop.src}')`,
    heroMobile: `url('${heroMobile.src}')`,
  }}
>
  /* A foto do hero e background para receber vinheta e grade por cima sem
