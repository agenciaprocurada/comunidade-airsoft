---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import CardCampo from "../../../components/CardCampo.astro";
import TopoPagina from "../../../components/TopoPagina.astro";
import { NOME_UF } from "../../../lib/uf";

/** Hub estadual — agrupa as cidades e lista todos os campos do estado. */
export async function getStaticPaths() {
  const campos = await getCollection("campos", ({ data }) => data.status === "publicado");

  const porUf = new Map<string, typeof campos>();
  for (const campo of campos) {
    const uf = campo.data.uf;
    porUf.set(uf, [...(porUf.get(uf) ?? []), campo]);
  }

  return [...porUf].map(([uf, lista]) => ({
    params: { uf: uf.toLowerCase() },
    props: { campos: lista, sigla: uf },
  }));
}

const { campos, sigla } = Astro.props;
const nomeUf = NOME_UF[sigla] ?? sigla;

const cidades = [...new Set(campos.map((c) => c.data.cidade_slug))].map((slug) => {
  const primeiro = campos.find((c) => c.data.cidade_slug === slug)!;
  return {
    slug,
    nome: primeiro.data.cidade,
    total: campos.filter((c) => c.data.cidade_slug === slug).length,
  };
}).sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR"));

const titulo = `Campos de airsoft e paintball em ${nomeUf} (${sigla})`;
const descricao = `${campos.length} ${
  campos.length === 1 ? "campo de airsoft" : "campos de airsoft e paintball"
} em ${nomeUf}, em ${cidades.length} ${
  cidades.length === 1 ? "cidade" : "cidades"
}. Endereço, valores, limite de FPS e estrutura de cada campo.`;
---

<Base titulo={titulo} descricao={descricao}>
  <TopoPagina
    trilha={[{ href: "/campos", texto: "Campos" }, { texto: nomeUf }]}
    dados={[
      { icone: "pino", texto: `${campos.length} ${campos.length === 1 ? "campo" : "campos"}` },
      { icone: "mapa", texto: `${cidades.length} ${cidades.length === 1 ? "cidade" : "cidades"}` },
      { icone: "selo", texto: "Endereço e valores" },
      { icone: "cadeado", texto: "Sem cadastro" },
    ]}
    codigo="01"
  >
    Campos de airsoft<br />e paintball<br />em {nomeUf}
    <p slot="descricao">{descricao}</p>
  </TopoPagina>

  <div class="mx-auto max-w-[1240px] px-5 pb-8 pt-2 md:px-12 md:pb-12 md:pt-4">

    <nav aria-label="Cidades" class="mt-8">
      <h2 class="rotulo mb-3">Cidades com campo cadastrado</h2>
      <ul class="flex flex-wrap gap-2">
        {
          cidades.map((cidade) => (
            <li>
              <a
                href={`/campos/${sigla.toLowerCase()}/${cidade.slug}`}
                class="inline-block border border-borda bg-papel px-4 py-2 text-base transition-colors hover:border-oliva-500 hover:text-oliva-500"
              >
                {cidade.nome}
                <span class="ml-2 font-dado text-[11px] text-oliva-400">
                  {cidade.total}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {campos.map((campo) => <CardCampo campo={campo} />)}
    </div>
  </div>
</Base>
