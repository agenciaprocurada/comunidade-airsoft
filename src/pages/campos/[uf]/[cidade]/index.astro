---
import { getCollection } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import CardCampo from "../../../../components/CardCampo.astro";
import TopoPagina from "../../../../components/TopoPagina.astro";
import { NOME_UF } from "../../../../lib/uf";

/**
 * Hub municipal. Junto com o hub estadual, é o principal ativo de SEO
 * do projeto: captura "campo de airsoft em [cidade]".
 */
export async function getStaticPaths() {
  const campos = await getCollection("campos", ({ data }) => data.status === "publicado");

  const porCidade = new Map<string, typeof campos>();
  for (const campo of campos) {
    const chave = `${campo.data.uf.toLowerCase()}/${campo.data.cidade_slug}`;
    porCidade.set(chave, [...(porCidade.get(chave) ?? []), campo]);
  }

  return [...porCidade].map(([chave, lista]) => {
    const [uf, cidade] = chave.split("/");
    return {
      params: { uf, cidade },
      props: { campos: lista, nomeCidade: lista[0].data.cidade, sigla: lista[0].data.uf },
    };
  });
}

const { campos, nomeCidade, sigla } = Astro.props;
const nomeUf = NOME_UF[sigla] ?? sigla;

const quantidade = campos.length;
const titulo = `Campos de airsoft e paintball em ${nomeCidade}, ${sigla}`;
const descricao = `${quantidade} ${
  quantidade === 1 ? "campo cadastrado" : "campos cadastrados"
} em ${nomeCidade} (${sigla}): endereço, valores, estrutura, avaliação e contato.`;
---

<Base titulo={titulo} descricao={descricao}>
  <TopoPagina
    trilha={[
      { href: "/campos", texto: "Campos" },
      { href: `/campos/${sigla.toLowerCase()}`, texto: nomeUf },
      { texto: nomeCidade },
    ]}
    dados={[
      { icone: "pino", texto: `${quantidade} ${quantidade === 1 ? "campo" : "campos"}` },
      { icone: "mapa", texto: `${nomeCidade}, ${sigla}` },
      { icone: "selo", texto: "Endereço e valores" },
      { icone: "cadeado", texto: "Sem cadastro" },
    ]}
    codigo="01"
  >
    Campos de airsoft<br />e paintball<br />em {nomeCidade}
    <p slot="descricao">{descricao}</p>
  </TopoPagina>

  <div class="mx-auto max-w-[1240px] px-5 pb-8 pt-2 md:px-12 md:pb-12 md:pt-4">

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {campos.map((campo) => <CardCampo campo={campo} />)}
    </div>

    <section class="mt-16 border border-oliva-300 bg-oliva-050 p-8">
      <h2 class="font-display text-2xl font-bold uppercase">
        Conhece um campo em {nomeCidade} que não está aqui?
      </h2>
      <p class="mt-2 max-w-[60ch] leading-relaxed text-texto-2">
        O diretório é montado pela comunidade. Se falta um campo, avise —
        conferimos e publicamos.
      </p>
      <a
        href="/enviar-campo"
        class="chanfro mt-5 inline-flex border border-oliva-500 bg-oliva-500 px-[26px] py-[13px] font-display text-[17px] font-bold uppercase tracking-[0.06em] text-fundo hover:bg-oliva-400 hover:border-oliva-400"
      >
        Indicar um campo
      </a>
    </section>
  </div>
</Base>
