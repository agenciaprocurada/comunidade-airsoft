---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import BuscaCampos from "../../components/BuscaCampos.astro";
import TopoPagina from "../../components/TopoPagina.astro";

const campos = await getCollection("campos", ({ data }) => data.status === "publicado");

// Usado apenas na contagem da meta description. A navegacao por estado
// saiu daqui: virou o filtro de Estado da busca, e os hubs /campos/[uf]
// continuam recebendo link das fichas e da home.
const estados = [...new Set(campos.map((c) => c.data.uf))];

const titulo = "Campos de airsoft e paintball no Brasil";
const descricao = `Diretório de campos de airsoft e paintball no Brasil: ${campos.length} ${campos.length === 1 ? "campo" : "campos"} em ${estados.length} ${estados.length === 1 ? "estado" : "estados"}, com endereço, valores, estrutura, avaliação e contato.`;
---

<Base titulo={titulo} descricao={descricao}>
  <TopoPagina
    trilha={[{ texto: "Campos" }]}
    dados={[
      { icone: "pino", texto: `${campos.length} ${campos.length === 1 ? "campo" : "campos"}` },
      { icone: "mapa", texto: `${estados.length} ${estados.length === 1 ? "estado" : "estados"}` },
      { icone: "selo", texto: "Endereço e valores" },
      { icone: "cadeado", texto: "Sem cadastro" },
    ]}
    codigo="01"
  >
    Campos de airsoft<br />e paintball<br />no Brasil
    <p slot="descricao">{descricao}</p>
  </TopoPagina>

  <div class="mx-auto max-w-[1240px] px-5 pb-8 pt-2 md:px-12 md:pb-12 md:pt-4">


    <BuscaCampos campos={campos} vitrine={false} quantidade={12} incremento={12} />
  </div>
</Base>
