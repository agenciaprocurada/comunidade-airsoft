              <p class="flex items-baseline justify-between font-dado text-[12px] uppercase tracking-[0.12em]">
                <span class="text-tinta">Militar</span>
                <span class="text-texto-2">9/12</span>
              </p>
              <span class="mt-2 block h-2 w-full bg-borda">
                <span class="block h-full w-3/4 bg-latao"></span>
              </span>
              <p class="mt-2 font-dado text-[11px] uppercase tracking-[0.1em] text-oliva-300">
                3 vagas
              </p>
            </div>

            <p class="border border-borda-forte bg-oliva-050 px-4 py-3 text-[0.875rem] leading-relaxed text-texto-2">
              <span class="font-dado text-[10px] uppercase tracking-[0.14em] text-oliva-300">
                Sem nomes
