                <span class="h-1.5 w-1.5 rounded-full border border-oliva-500" />
                <span class="h-0.5 w-8 bg-oliva-700" />
                <span class="h-px flex-1 bg-borda" />
              </span>

              <p class="mt-4 leading-relaxed text-texto">
                {VISIBILIDADES[item.chave].ajuda}
              </p>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-texto-2">
                {item.detalhe}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ==========================================================
       H-0 — O DIA DO JOGO
       ========================================================== -->
  <section class="border-y border-borda bg-papel/40">
    <div class="mx-auto max-w-[1240px] px-5 py-16 md:px-12 md:py-20">
      <div class="flex items-center gap-4">
        <span class="tag-hora" aria-hidden="true">H-0</span>
