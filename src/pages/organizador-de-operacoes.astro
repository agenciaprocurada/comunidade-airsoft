          <div class="border-t border-borda bg-papel px-4 py-3">
            <p class="font-dado text-[10px] uppercase tracking-[0.14em] text-texto-2">
              Anotar quem mandou no grupo
            </p>
            <div class="mt-2 flex items-center gap-2" aria-hidden="true">
              <span class="flex-1 border border-borda-forte bg-fundo px-3 py-2 text-[0.875rem] text-texto-2">
