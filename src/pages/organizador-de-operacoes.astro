<script>
  /* ============================================================
     Vídeo da demonstração.

     Sem JS o <video> fica com os `controls` nativos e o botão
     próprio nem aparece — a página continua inteira. Com JS, os dois
     trocam de lugar: o botão grande cobre o vídeo, e os controles só
     entram depois que o play acontece.
     ============================================================ */
  const video = document.querySelector<HTMLVideoElement>("video[data-video]");
  const tocar = document.querySelector<HTMLButtonElement>("button[data-tocar]");

  if (video && tocar) {
    video.controls = false;
    tocar.hidden = false;

    const comecar = () => {
      tocar.hidden = true;
      video.controls = true;
      // `preload="none"`: o arquivo só começa a baixar agora.
      void video.play();
    };

    tocar.addEventListener("click", comecar);

    // Voltando ao estado inicial no fim, o pôster reaparece e o
    // convite continua de pé para quem quiser rever.
    video.addEventListener("ended", () => {
      video.controls = false;
      video.currentTime = 0;
      tocar.hidden = false;
    });

    /* O "Ver como funciona" do hero aponta para #video. O salto de
       âncora é do navegador; aqui só se dá o play ao chegar. Também
       responde a quem cola a URL com #video direto na barra. */
    const irEtocar = () => {
      if (tocar.hidden) return; // já está tocando
      comecar();
    };

    document
      .querySelector<HTMLAnchorElement>('a[href="#video"]')
      ?.addEventListener("click", () => {
        // Depois do salto, para não competir com o scroll suave.
        setTimeout(irEtocar, 450);
      });

    if (location.hash === "#video") setTimeout(irEtocar, 450);
  }
</script>

<style>
  /* ============================================================
     Coordenada de seção — a contagem regressiva do jogo (H-7, H-0,
     H+1), que é como quem organiza pensa a semana. Mesmo desenho da
     tag de setor da landing do criador de mapas.
     ============================================================ */
  .tag-hora {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: 1px solid var(--color-borda-forte);
    font-family: var(--font-dado);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--color-oliva-400);
  }

  /* Escurece a textura do hero: mais fechado à esquerda (texto) e nas
     bordas de cima e de baixo, para a foto nascer do fundo da página
     e voltar para ele sem emenda. */
  .hero-escurecer {
    background:
      linear-gradient(
        to right,
        rgba(11, 13, 9, 0.86) 0%,
        rgba(11, 13, 9, 0.66) 45%,
        rgba(11, 13, 9, 0.55) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(11, 13, 9, 0.75) 0%,
        rgba(11, 13, 9, 0.12) 35%,
        rgba(11, 13, 9, 0.12) 70%,
        rgba(11, 13, 9, 0.9) 100%
      );
  }

  /* Escurece a foto do CTA: quase opaca à esquerda (onde está o
     texto), abre à direita (onde está o operador), fecha nas bordas. */
  .cta-vinheta {
    background:
      linear-gradient(
        to right,
        var(--color-fundo) 0%,
        rgba(11, 13, 9, 0.96) 38%,
        rgba(11, 13, 9, 0.6) 72%,
        rgba(11, 13, 9, 0.88) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(11, 13, 9, 0.7) 0%,
        transparent 30%,
        transparent 65%,
        rgba(11, 13, 9, 0.92) 100%
      );
  }

  /* Card com chanfro em cantos opostos ao do CTA primário (que corta
     em cima-esquerda / baixo-direita). Clip-path também corta a
     borda, então a borda é o fundo da camada de fora e o conteúdo é
     uma camada de dentro 1px menor, com o mesmo corte. */
  .card-passo {
    --corte: 16px;
    padding: 1px;
    background: var(--color-oliva-700);
    clip-path: polygon(
      0 0,
      calc(100% - var(--corte)) 0,
      100% var(--corte),
      100% 100%,
      var(--corte) 100%,
      0 calc(100% - var(--corte))
    );
  }
  .card-passo-miolo {
    background: rgba(20, 24, 15, 0.94);
    clip-path: polygon(
      0 0,
      calc(100% - var(--corte) + 1px) 0,
      100% calc(var(--corte) - 1px),
      100% 100%,
      calc(var(--corte) - 1px) 100%,
      0 calc(100% - var(--corte) + 1px)
    );
  }

  /* Emblema hexagonal — mesma técnica de duas camadas. */
  .hexagono {
    --hex: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    padding: 1.5px;
    background: var(--color-oliva-500);
    clip-path: var(--hex);
  }
  .hexagono-miolo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-fundo);
    color: var(--color-oliva-300);
    clip-path: var(--hex);
  }

  /* Brilho do CTA. Vai no invólucro porque o chanfro do botão é
     clip-path, que cortaria um box-shadow; drop-shadow segue a
     silhueta recortada. */
  .cta-brilho {
    filter: drop-shadow(0 6px 18px rgba(169, 189, 102, 0.4));
  }

  /* Listra de detalhe sob o título da seção — eco miúdo da
     faixa-perigo, em oliva. */
  .listra-mini {
    width: 64px;
    height: 7px;
    background: repeating-linear-gradient(
      -55deg,
      var(--color-oliva-500) 0 5px,
      transparent 5px 11px
    );
    opacity: 0.75;
  }

  /* ============================================================
     O painel do hero se preenche no carregamento.

     Regra de robustez: o estado BASE de cada camada é a lista
     CHEIA. Toda animação parte de "invisível" no `from` e termina
     no estado base — se ela não rodar (reduced motion, navegador
     antigo), o visitante vê o painel completo, nunca um vazio.
     ============================================================ */

  /* O link, os dois lados e cada nome da lista entram em sequência,
     na mesma ordem em que a operação se preenche de verdade. */
  .op-linha {
    animation: op-entrar 420ms ease-out both;
  }
  .op-linha-1 { animation-delay: 150ms; }
  .op-linha-2 { animation-delay: 450ms; }
  .op-linha-3 { animation-delay: 600ms; }
  .op-linha-4 { animation-delay: 900ms; }
  .op-linha-5 { animation-delay: 1100ms; }
  .op-linha-6 { animation-delay: 1300ms; }
  .op-linha-7 { animation-delay: 1500ms; }
  /* O último é o que bateu no teto e caiu na espera: entra depois de
     um respiro, para a leitura registrar que ele é diferente. */
  .op-linha-8 { animation-delay: 2000ms; }

  /* As barras de vaga enchem da esquerda para a direita. `width` já
     está no estado final (inline); a animação é só a escala. */
  .op-barra {
    animation: op-encher 900ms cubic-bezier(0.22, 1, 0.36, 1) 650ms both;
  }

  /* O ponto "no ar" da barra do painel. */
  .op-pulso {
    animation: op-pulsar 2s ease-in-out 2.4s infinite;
  }

  @keyframes op-entrar {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes op-encher {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes op-pulsar {
    50% {
      opacity: 0.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .op-linha,
    .op-barra,
    .op-pulso {
      animation: none;
    }
  }
</style>
