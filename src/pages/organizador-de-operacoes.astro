                <span class="text-tinta">PMC</span>
                <span class="text-texto-2">12/12</span>
              </p>
              <span class="mt-2 block h-2 w-full bg-borda">
                <span class="block h-full w-full bg-oliva-500"></span>
              </span>
              <p class="mt-2 font-dado text-[11px] uppercase tracking-[0.1em] text-latao">
