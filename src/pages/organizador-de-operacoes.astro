---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Botao from "../components/Botao.astro";
import fundoCta from "../assets/hero-fundo.webp";
import fundoTopo from "../assets/topo-fundo.webp";
import capaVideo from "../assets/operacoes/video-organizador-de-operacoes-airsoft.webp";
import {
  DIAS_DO_CONVITE,
  ESTILOS_OPERACAO,
  LADOS_MAXIMO,
  LADOS_MINIMO,
  VISIBILIDADES,
} from "../lib/operacao";

/**
 * Landing page do Organizador de Operações — a ferramenta que na área
 * logada aparece no menu como "Meus eventos".
 *
 * Estática e pública pelo mesmo motivo da /criador-de-mapas: o painel
 * (/conta/operacoes) exige sessão, então quem chega pelo Google
 * bateria num redirect para /entrar sem nunca ver o que a ferramenta
 * faz. Esta página é a vitrine indexável; os botões apontam para o
 * painel e o middleware cuida do login.
 *
 * As regras citadas no texto são IMPORTADAS de `lib/operacao` — o
 * número de lados, as duas visibilidades, o prazo do convite. Vitrine
 * que descreve ferramenta tem que ler a ferramenta, não uma cópia do
 * texto: mudou a regra, a página muda junto.
 *
 * A assinatura visual é o painel do hero, que SE PREENCHE no
 * carregamento: as barras de vaga enchem, os nomes entram um a um e o
 * último bate o teto e cai na espera. É a lista se administrando
 * sozinha — exatamente o que a ferramenta faz enquanto o organizador
 * dorme. Com `prefers-reduced-motion` nada anima: o estado base de
 * cada elemento já é a lista cheia, a animação só revela.
 *
 * As seções são numeradas pela contagem regressiva do jogo (H-7, H-3,
 * H-1, H-0, H+1), que é como quem organiza pensa a semana. A landing
 * do criador de mapas numera por coordenada de quadrícula pelo mesmo
 * motivo: a convenção do produto aplicada à própria página.
 */

const TITULO = "Organizador de Operações de airsoft";
const DESCRICAO =
  "Abra a operação, mande um link no grupo e pare de manter lista no bloco de " +
  "notas. Vagas por lado, lista de espera automática, quem pagou e quem apareceu. Grátis.";

const totalEstilos = ESTILOS_OPERACAO.length;

/** Os três passos entre "vou fazer um jogo" e "lista cheia". */
const PASSOS = [
  {
    numero: "01",
    titulo: "Abra a operação",
    texto:
      "Escolha o campo no diretório (ou escreva o local), marque a data e o " +
      "horário. Depois divida os lados do jogo — PMC contra Militar, por " +
      "exemplo — e diga quantas vagas cada lado tem.",
  },
  {
    numero: "02",
    titulo: "Mande o link. Uma vez.",
    texto:
      "A operação vira uma página com endereço próprio. Você cola no grupo e " +
      "acabou: quem abrir amanhã vê a lista de amanhã. Nada de repostar print " +
      "do bloco de notas a cada confirmação.",
  },
  {
    numero: "03",
    titulo: "A lista se enche sozinha",
    texto:
      "O jogador entra com a conta Google dele, escolhe o lado e confirma. " +
      "Lado cheio manda para a espera; se alguém desiste, o primeiro da fila " +
      "sobe na hora, sem você mexer em nada.",
  },
];

/** Ficha técnica — cada linha é um fato da ferramenta, não um slogan. */
const FICHA = [
  {
    termo: "Lados",
    valor:
      `De ${LADOS_MINIMO} a ${LADOS_MAXIMO} lados por operação, cada um com as ` +
      "vagas dele. Lado sem teto também vale: fica aberto e nunca gera espera.",
  },
  {
    termo: "Espera",
    valor:
      "Automática, e é o banco que faz. Lotou, o próximo entra em espera; " +
      "abriu vaga, o primeiro da fila sobe na mesma hora.",
  },
  {
    termo: "Preço",
    valor:
      "Dois lotes: o antecipado com prazo e o valor no dia. A página mostra " +
      "sozinha qual está valendo — ninguém erra o valor na hora de pagar.",
  },
  {
    termo: "Pagamento",
    valor:
      "Não passa por nós e não cobramos taxa. Você escreve o seu combinado de " +
      "pagamento na operação e marca “pago” na lista quando o dinheiro cai.",
  },
  {
    termo: "Privacidade",
    valor:
      "A página pública mostra só a contagem por lado. O nome de quem vai " +
      "jogar fica no seu painel — lista de gente não é conteúdo para o Google.",
  },
  {
    termo: "Convite",
    valor:
      "Operação fechada tem link próprio. Quem recebe entra na lista, e o " +
      `convite continua valendo ${DIAS_DO_CONVITE} dias no navegador dele.`,
  },
  {
    termo: "Estilo",
    valor:
      `${totalEstilos} estilos para marcar o tipo do jogo (recreativo, milsim, ` +
      "misto...). É por ele que a agenda acha operação parecida com a sua.",
  },
  {
    termo: "Repetição",
    valor:
      "Qualquer operação vira molde da próxima: campo, horários, lados, vagas " +
      "e preço voltam preenchidos. Você digita só a data nova.",
  },
];

const PERGUNTAS = [
  {
    p: "O Organizador de Operações é pago?",
    r: "Não. É gratuito e faz parte da conta da Comunidade Airsoft, que também é gratuita. Não cobramos mensalidade nem taxa por inscrição.",
  },
  {
    p: "Vocês recebem o dinheiro das inscrições?",
    r: "Não. A plataforma não intermedia pagamento nenhum. Você publica o seu combinado de pagamento na operação, o jogador te paga direto e você marca “pago” na lista. O dinheiro nunca passa por aqui.",
  },
  {
    p: "Meu jogo é só para a minha equipe. Dá para fechar a lista?",
    r: "Dá. A operação fechada aparece na agenda com data, campo e horário, mas a lista e a inscrição só abrem para quem receber o seu link de convite. Quem quiser entrar clica em “Pedir convite” e cai no seu WhatsApp.",
  },
  {
    p: "Os nomes de quem vai jogar ficam públicos?",
    r: "Não. A página da operação mostra só quantos confirmaram em cada lado e quantos estão na espera. A lista com os nomes fica no seu painel de organizador.",
  },
  {
    p: "E o pessoal que manda o nome no grupo e não usa o site?",
    r: "Você anota pelo nome. O painel tem um campo para adicionar jogador sem conta — a lista precisa ser a lista inteira, senão ela não substitui o bloco de notas.",
  },
  {
    p: "Preciso de conta para abrir uma operação?",
    r: "Sim. Entre com o Google, complete o cadastro (WhatsApp e cidade) e cadastre uma réplica na sua ficha — é o mesmo cadastro que libera todas as ferramentas. Para o jogador entrar na lista basta o login e o cadastro básico.",
  },
  {
    p: "Funciona no celular?",
    r: "Funciona inteiro. O painel é uma lista, não um editor: dá para marcar quem chegou com o celular na mão, no portão do campo.",
  },
  {
    p: "Serve para milsim, treino de equipe ou paintball?",
    r: "Serve para qualquer jogo com data, local e lista. Os lados você nomeia como quiser, e a operação pode ser aberta para a comunidade ou fechada só para os seus.",
  },
];

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: PERGUNTAS.map(({ p, r }) => ({
    "@type": "Question",
    name: p,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};

/**
 * Vídeo de demonstração — 26 segundos, da operação vazia à lista
 * fechada.
 *
 * O MP4 sai do projeto Remotion em videos/ (composição
 * `VideoOperacoes`, 1920x1080) reencodado para 1280x720 sem faixa de
 * áudio — a composição não tem trilha, e o AAC mudo que o Remotion
 * escreve por padrão só pesaria. Para regerar depois de um render
 * novo:
 *
 *   ffmpeg -i videos/out/organizador-de-operacoes-1920x1080.mp4 \
 *     -vf scale=1280:-2 -c:v libx264 -crf 26 -preset slow \
 *     -pix_fmt yuv420p -an -movflags +faststart \
 *     public/video/organizador-de-operacoes-airsoft.mp4
 *
 * O binário do ffmpeg já vem junto com o Remotion, dentro de
 * videos/node_modules/@remotion/compositor-*.
 *
 * O pôster é o quadro dos 20,5 s — a lista JÁ CHEIA, com os dois
 * lados e o selo da espera. O primeiro quadro é a marca sobre fundo
 * preto, que não convida ninguém a apertar o play.
 */
const VIDEO = {
  arquivo: "/video/organizador-de-operacoes-airsoft.mp4",
  titulo: "Organizador de operações de airsoft — lista de presença num link",
  duracaoIso: "PT26S",
  duracaoTexto: "26 segundos",
  publicadoEm: "2026-09-01",
};

/**
 * VideoObject entra no @graph da página. Sem `uploadDate`, `duration`
 * e `thumbnailUrl` o Google descarta o rich result — e é justamente a
 * miniatura no resultado de busca que faz o vídeo valer a pena.
 *
 * `contentUrl` aponta para o MP4 deste domínio, que é o que a página
 * serve. Não há `embedUrl`: não existe player embutido aqui.
 */
const video = {
  "@type": "VideoObject",
  name: VIDEO.titulo,
  description:
    "Demonstração do Organizador de Operações da Comunidade Airsoft: abrir a " +
    "operação com campo, data, lados e vagas, publicar o link no grupo da equipe, " +
    "um jogador abrindo esse link e confirmando presença, a lista se enchendo com " +
    "lista de espera automática e a marcação de pago e presente no dia do jogo.",
  uploadDate: VIDEO.publicadoEm,
  duration: VIDEO.duracaoIso,
  thumbnailUrl: new URL(capaVideo.src, Astro.site).href,
  contentUrl: new URL(VIDEO.arquivo, Astro.site).href,
  inLanguage: "pt-BR",
  isFamilyFriendly: true,
};

const aplicativo = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Organizador de Operações — Comunidade Airsoft",
  url: new URL("/conta/operacoes", Astro.site).href,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Navegador web",
  inLanguage: "pt-BR",
  description: DESCRICAO,
  offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
};

/**
 * Ícones de traço reto e ponta quadrada, caixa 24 — o mesmo dialeto
 * dos símbolos do criador de mapas.
 */
const ICONE = {
  calendario: "M4 6h16v14H4zM4 10h16M8 3.5v4M16 3.5v4",
  link: "M10.5 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 1 0-5-5l-1.2 1.2M13.5 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 1 0 5 5l1.2-1.2",
  gente: "M12 4a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zM4 21v-2a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v2",
  cadeado: "M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3",
  dinheiro: "M3 7h18v10H3zM12 9.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5",
  presenca: "m4 12.5 5 5L20 5.5",
  repetir: "M4.5 9.5h11a4 4 0 0 1 0 8H8M4.5 9.5 8 6M4.5 9.5 8 13",
  megafone: "M4 9v6h4l7 4V5L8 9H4zM18 9a4 4 0 0 1 0 6",
  replica: "M3 9h13v4H9l-1 7H5l1-7H3zM16 10h5v2h-5",
  google: "M16.6 8.4A5.6 5.6 0 1 0 17.6 12H12.2",
} as const;

/** Os quatro passos entre "cheguei aqui" e "operação no ar". */
const TRAJETO = [
  { n: "01", t: "Entrar com o Google — sem senha e sem cartão.", icone: ICONE.google },
  { n: "02", t: "Completar o cadastro: WhatsApp, cidade e os termos.", icone: ICONE.gente },
  {
    n: "03",
    t: "Cadastrar uma réplica na sua ficha — é o que libera as ferramentas.",
    icone: ICONE.replica,
  },
  { n: "04", t: "Abrir a operação e mandar o link no grupo.", icone: ICONE.calendario },
];

/**
 * A lista do painel do hero. Nomes fictícios e curtos, como aparecem
 * na tela de verdade. O último entra em espera de propósito: é o
 * único jeito de mostrar, sem explicar, o que acontece quando lota.
 */
const LISTA_HERO = [
  { nome: "Rafael M.", lado: "PMC", pago: true, espera: false },
  { nome: "Bruno T. +1", lado: "Militar", pago: true, espera: false },
  { nome: "Diego A.", lado: "PMC", pago: false, espera: false },
  { nome: "Caio R.", lado: "Militar", pago: true, espera: false },
  { nome: "Wesley P.", lado: "PMC", pago: false, espera: true },
];

/** Os dois lados do jogo do painel, com a ocupação de cada um. */
const LADOS_HERO = [
  { nome: "PMC", confirmados: 12, vagas: 12, cor: "var(--color-oliva-500)" },
  { nome: "Militar", confirmados: 9, vagas: 12, cor: "var(--color-latao)" },
];

/**
 * O antes e o depois, lado a lado. É o argumento inteiro da
 * ferramenta em duas colunas — quem organiza jogo reconhece a coluna
 * da esquerda antes de ler a segunda linha.
 */
const COMPARACAO = [
  {
    antes: "Lista no bloco de notas, reenviada no grupo a cada nome novo",
    depois: "Um link. Quem abre vê a lista de agora.",
  },
  {
    antes: "“Ainda tem vaga?” respondido dez vezes por semana",
    depois: "A página mostra as vagas de cada lado, em tempo real.",
  },
  {
    antes: "Quem desistiu continua na lista até você lembrar de apagar",
    depois: "Quem sai libera a vaga e o próximo da espera sobe sozinho.",
  },
  {
    antes: "Print da lista + planilha de quem pagou + conferência no portão",
    depois: "Uma lista só, com “pago” e “presente” do lado do nome.",
  },
];

/** Os dois cartões da seção de visibilidade, montados a partir da lib. */
const VISIVEL = [
  {
    chave: "aberta" as const,
    icone: ICONE.megafone,
    detalhe:
      "Entra na agenda pública do site e aparece para quem procura jogo na sua " +
      "cidade. É como a operação chega em quem não está no seu grupo.",
  },
  {
    chave: "fechada" as const,
    icone: ICONE.cadeado,
    detalhe:
      "A agenda mostra só a capa: campo, data e horário. Sem o seu link, " +
      "ninguém vê a lista nem consegue confirmar presença.",
  },
];
---

<Base titulo={TITULO} descricao={DESCRICAO} dadosEstruturados={[aplicativo, video, faq]}>
  <!-- ==========================================================
       HERO — o painel se preenche sozinho
       ========================================================== -->
  <section class="relative isolate overflow-hidden border-b border-borda bg-fundo">
    {/* Textura do topo ao fundo. É a primeira dobra, então carrega
        ansiosa. A camada `hero-escurecer` por cima segura o contraste
        do texto e funde a foto com o fundo da página. */}
    <div class="absolute inset-0 -z-30" aria-hidden="true">
      <Image
        src={fundoTopo}
        alt=""
        widths={[960, 1672]}
        sizes="100vw"
        loading="eager"
        class="h-full w-full object-cover object-center"
      />
    </div>
    <div class="hero-escurecer absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="grade-tatica absolute inset-0 -z-10 opacity-30" aria-hidden="true"></div>

    <div
      class="mx-auto grid max-w-[1240px] items-center gap-10 px-5 py-14 md:px-12 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,560px)] lg:gap-14"
    >
      <div>
        <p class="rotulo">Ferramenta gratuita · Para quem organiza jogo</p>

        <h1
          class="mt-4 font-display text-[44px] font-extrabold uppercase italic leading-[0.9] md:text-[72px]"
        >
          Organizador de<br />
          <span class="text-oliva-500">operações</span>
        </h1>

        <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-texto">
          Abra a operação, mande um link no grupo e pare de manter lista no bloco
          de notas. Vagas por lado, lista de espera automática, quem pagou e quem
          apareceu — tudo numa tela só.
        </p>

        <p class="mt-4 max-w-[52ch] leading-relaxed text-texto-2">
          Feito para quem hoje conta nome no print, apaga desistência na mão e
          responde “ainda tem vaga?” dez vezes por semana.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <Botao href="/conta/operacoes">Abrir minha operação</Botao>
          <Botao href="#video" variante="secundario" seta>
            Ver como funciona
          </Botao>
        </div>

        <p class="mt-5 font-dado text-[13px] uppercase tracking-[0.14em] text-texto-2">
          <span class="text-oliva-300">100% grátis</span> · Sem taxa por inscrição ·
          O dinheiro é seu
        </p>
      </div>

      <!--
        A vitrine: o painel da operação com a lista se preenchendo na
        ordem em que ela se preenche de verdade. É HTML e SVG, não
        captura de tela — não envelhece junto com a interface.
      -->
      <div
        aria-hidden="true"
        class="moldura-tatica order-first border border-borda-forte bg-fundo lg:order-none"
      >
        <!-- Barra do painel: a operação e o status -->
        <div
          class="flex items-center justify-between gap-3 border-b border-borda px-3 py-2 font-dado text-[10px] uppercase tracking-[0.16em] text-texto-2"
        >
          <span class="flex items-center gap-2">
            <span class="op-pulso inline-block h-1.5 w-1.5 bg-oliva-400"></span>
            Domingo 13/09 — Sítio Alvorada
          </span>
          <span class="hidden sm:inline text-oliva-300">Aberta</span>
        </div>

        <div class="bg-[#101409] p-4 md:p-5">
          <!-- O link: é ele que vai para o grupo -->
          <div class="op-linha op-linha-1 border border-oliva-700 bg-oliva-050 px-3 py-2.5">
            <p class="font-dado text-[9px] uppercase tracking-[0.16em] text-oliva-300">
              Link do evento
            </p>
            <p class="mt-1 truncate font-dado text-[12px] text-tinta">
              comunidadeairsoft.com.br/operacoes/alvorada-13-09
            </p>
          </div>

          <!-- Ocupação por lado: as barras enchem -->
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {
              LADOS_HERO.map((lado, i) => (
                <div class={`op-linha op-linha-${i + 2} border border-borda bg-fundo px-3 py-2.5`}>
                  <p class="flex items-baseline justify-between font-dado text-[11px] uppercase tracking-[0.12em] text-texto-2">
                    <span class="text-tinta">{lado.nome}</span>
                    <span>
                      {lado.confirmados}/{lado.vagas}
                    </span>
                  </p>
                  <span class="mt-2 block h-1.5 w-full bg-borda">
                    <span
                      class="op-barra block h-full origin-left"
                      style={`width:${(lado.confirmados / lado.vagas) * 100}%;background:${lado.cor}`}
                    />
                  </span>
                  <p class="mt-1.5 font-dado text-[10px] uppercase tracking-[0.1em] text-texto-2">
                    {lado.confirmados === lado.vagas ? "Lado cheio" : `${lado.vagas - lado.confirmados} vagas`}
                  </p>
                </div>
              ))
            }
          </div>

          <!-- A lista: os nomes entram um a um -->
          <p
            class="mt-5 flex items-center justify-between border-b border-borda pb-2 font-dado text-[10px] uppercase tracking-[0.16em] text-texto-2"
          >
            <span>Lista</span>
            <span>21 confirmados · 1 na espera</span>
          </p>

          <ul class="divide-y divide-borda">
            {
              LISTA_HERO.map((pessoa, i) => (
                <li
                  class={`op-linha op-linha-${i + 4} flex items-center justify-between gap-3 py-2.5`}
                >
                  <span class="flex min-w-0 items-center gap-2">
                    <span
                      class="h-1.5 w-1.5 shrink-0"
                      style={`background:${pessoa.lado === "PMC" ? "var(--color-oliva-500)" : "var(--color-latao)"}`}
                    />
                    <span class="truncate text-[13px] font-semibold text-tinta">
                      {pessoa.nome}
                    </span>
                    <span class="hidden font-dado text-[10px] uppercase tracking-[0.1em] text-texto-2 sm:inline">
                      {pessoa.lado}
                    </span>
                  </span>

                  <span class="flex shrink-0 items-center gap-1.5">
                    {pessoa.espera ? (
                      <span class="border border-latao/60 px-1.5 py-0.5 font-dado text-[9px] uppercase tracking-[0.1em] text-latao">
                        Espera
                      </span>
                    ) : (
                      <>
                        <span
                          class:list={[
                            "border px-1.5 py-0.5 font-dado text-[9px] uppercase tracking-[0.1em]",
                            pessoa.pago
                              ? "border-ok/60 text-ok-texto"
                              : "border-borda-forte text-texto-2",
                          ]}
                        >
                          {pessoa.pago ? "Pago" : "A pagar"}
                        </span>
                        <svg
                          viewBox="0 0 24 24"
                          class="h-3.5 w-3.5 text-oliva-400"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <path d={ICONE.presenca} stroke-linecap="square" />
                        </svg>
                      </>
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       VÍDEO — a ferramenta funcionando, logo abaixo do hero.

       Mesma decisão da /criador-de-mapas: arquivo servido pelo
       PRÓPRIO site, não embed do YouTube. O embed desenha por cima do
       vídeo o título, o canal e os botões de compartilhar, e não
       existe parâmetro que tire aquilo — `showinfo` saiu da API e
       `modestbranding` foi descontinuado. Com o arquivo local a tela
       é só o produto.

       Não toca sozinho: `preload="none"` mais o pôster deixam a
       página abrir sem baixar meio mega de quem talvez nem role até
       aqui.
       ========================================================== -->
  <section
    id="video"
    aria-labelledby="video-titulo"
    class="scroll-mt-24 border-b border-borda bg-papel/40"
  >
    <div class="mx-auto max-w-[1240px] px-5 py-14 text-center md:px-12 md:py-16">
      <p class="font-dado text-xs tracking-[0.2em] text-oliva-500">
        DEMONSTRAÇÃO · {VIDEO.duracaoTexto.toUpperCase()}
      </p>
      <h2
        id="video-titulo"
        class="mx-auto mt-3 max-w-[22ch] font-display text-3xl font-bold uppercase leading-tight tracking-[0.03em] md:text-4xl lg:text-[2.75rem]"
      >
        Da operação aberta à lista fechada
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-texto-2">
        Dê play para ver a ferramenta funcionando.
      </p>

      {/* Sem `overflow-hidden`: os ticks de canto da moldura tática
          ficam em -1px e seriam cortados. */}
      <div class="moldura-tatica relative mt-9 aspect-video border border-borda bg-[#141810] md:mt-10">
        <video
          data-video
          class="absolute inset-0 h-full w-full"
          poster={capaVideo.src}
          preload="none"
          controls
          playsinline
          width={capaVideo.width}
          height={capaVideo.height}
        >
          <source src={VIDEO.arquivo} type="video/mp4" />
          Seu navegador não reproduz vídeo. <a href={VIDEO.arquivo}>Baixe o
          arquivo</a> para assistir à demonstração.
        </video>

        {/*
          Botão de play próprio, cobrindo o vídeo inteiro: o alvo de
          clique é a tela toda, não um ícone de 60px. Nasce com
          `hidden` e só aparece se houver JS — sem script ele não teria
          como dar play, e um botão morto por cima bloquearia os
          `controls` nativos, que são o caminho de quem está sem JS.
        */}
        <button
          type="button"
          data-tocar
          hidden
          class="group absolute inset-0 flex cursor-pointer items-center justify-center"
        >
          <span class="sr-only">Assistir à demonstração ({VIDEO.duracaoTexto})</span>
          <span
            aria-hidden="true"
            class="flex h-20 w-20 items-center justify-center border-2 border-oliva-300 bg-[#0b0d09]/70 text-oliva-300 shadow-[0_8px_40px_rgba(11,13,9,0.6)] backdrop-blur-sm transition group-hover:scale-105 group-hover:border-oliva-300 group-hover:bg-oliva-500 group-hover:text-fundo group-focus-visible:scale-105 md:h-24 md:w-24"
          >
            <svg viewBox="0 0 24 24" class="ml-1 h-9 w-9 md:h-11 md:w-11" fill="currentColor">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="mt-9 flex justify-center md:mt-10">
        <Botao href="/conta/operacoes">Abrir minha operação</Botao>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       ANTES E DEPOIS — o argumento inteiro, em duas colunas.

       Fica logo abaixo do hero e não leva coordenada de hora: a
       página numera as seções pela contagem regressiva do jogo
       (H-7, H-3, H-1, H-0, H+1) e enfiar um capítulo no meio
       obrigaria a renumerar tudo. Este bloco é a continuação do
       hero — a mesma promessa, agora comparada com o que existe
       hoje.
       ========================================================== -->
  <section class="border-b border-borda bg-papel/40">
    <div class="mx-auto max-w-[1240px] px-5 py-14 md:px-12 md:py-16">
      <h2 class="max-w-[24ch] font-display text-3xl font-bold uppercase leading-tight tracking-[0.03em] md:text-4xl">
        O grupo continua sendo o grupo.
        <span class="block text-oliva-500">A lista é que sai de lá.</span>
      </h2>

      <p class="mt-4 max-w-[62ch] text-lg leading-relaxed text-texto-2">
        Ninguém precisa mudar de aplicativo, e a zoeira, a carona e a foto do
        domingo continuam no WhatsApp. O que muda é só a lista de presença.
      </p>

      {/*
        Cada PAR é um <li>, e não uma coluna de "antes" seguida de uma
        coluna de "depois". No celular a tabela de duas colunas vira
        pilha, e a pilha perdia o cabeçalho: sobravam oito frases
        alternadas sem dizer qual era qual. Com o par junto, o rótulo
        miúdo acompanha cada metade onde não há cabeçalho.
      */}
      <ul class="mt-10 border border-borda bg-papel">
        <li class="hidden border-b border-borda md:grid md:grid-cols-2">
          <p class="border-r border-borda px-5 py-3 font-dado text-[11px] uppercase tracking-[0.16em] text-texto-2">
            Hoje
          </p>
          <p class="px-5 py-3 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-300">
            Com o organizador
          </p>
        </li>

        {
          COMPARACAO.map((linha, i) => (
            <li
              class:list={[
                "grid md:grid-cols-2",
                i < COMPARACAO.length - 1 && "border-b border-borda",
              ]}
            >
              <div class="flex items-start gap-3 px-5 py-4 md:border-r md:border-borda">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="mt-1 h-4 w-4 shrink-0 text-alerta"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M6 6l12 12M18 6L6 18" stroke-linecap="square" />
                </svg>
                <span>
                  <span class="mb-1 block font-dado text-[10px] uppercase tracking-[0.16em] text-texto-2 md:hidden">
                    Hoje
                  </span>
                  <span class="text-[0.9375rem] leading-relaxed text-texto-2">{linha.antes}</span>
                </span>
              </div>

              <div class="flex items-start gap-3 border-t border-borda px-5 py-4 md:border-t-0">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  class="mt-1 h-4 w-4 shrink-0 text-oliva-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                >
                  <path d={ICONE.presenca} stroke-linecap="square" />
                </svg>
                <span>
                  <span class="mb-1 block font-dado text-[10px] uppercase tracking-[0.16em] text-oliva-300 md:hidden">
                    Com o organizador
                  </span>
                  <span class="text-[0.9375rem] leading-relaxed text-texto">{linha.depois}</span>
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ==========================================================
       H-7 — COMO FUNCIONA
       ========================================================== -->
  <section id="como-funciona" class="mx-auto max-w-[1240px] scroll-mt-24 px-5 py-16 md:px-12 md:py-20">
