            </g>
          </svg>
        </div>
        <div class="p-6">
          <span class="font-dado text-sm tracking-[0.2em] text-oliva-500">{PASSOS[1].numero}</span>
          <h3 class="mt-2 font-display text-xl font-bold uppercase tracking-[0.03em]">
            {PASSOS[1].titulo}
          </h3>
          <p class="mt-3 leading-relaxed text-texto-2">{PASSOS[1].texto}</p>
        </div>
      </li>

      <li class="moldura-tatica flex flex-col border border-borda bg-papel">
        <!-- Vinheta 03: a lista subindo sozinha -->
