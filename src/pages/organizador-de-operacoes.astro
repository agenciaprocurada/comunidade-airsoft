                <p class="mt-2 text-[0.9375rem] leading-relaxed text-texto-2">{item.d}</p>
              </li>
            ))
          }
        </ul>

        <!-- A página pública, como o jogador a vê: contagem, nunca nomes -->
        <figure class="moldura-tatica m-0 self-start border border-borda-forte bg-fundo">
          <figcaption
            class="flex items-center justify-between gap-3 border-b border-borda px-3 py-2 font-dado text-[10px] uppercase tracking-[0.16em] text-texto-2"
