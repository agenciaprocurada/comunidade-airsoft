---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Botao from "../components/Botao.astro";
import Etiqueta from "../components/Etiqueta.astro";
import fotoHero from "../assets/guias/guia-do-iniciante.webp";
import fundoTopo from "../assets/topo-fundo.webp";
import fundoCta from "../assets/combatentes.webp";

/**
 * Landing page "Primeiro jogo de airsoft".
 *
 * Fala com quem NUNCA jogou. Cada seção responde uma pergunta que a
 * pessoa faria em voz alta ("quanto custa?", "posso alugar?"), em
 * linguagem simples e sem jargão sem explicação. Os números vêm dos
 * guias (quanto-custa-comecar-no-airsoft, guia-do-iniciante): se o
 * guia mudar de valor, este arquivo tem que acompanhar.
 *
 * Mesma família visual do Criador de Mapas (moldura tática, grade,
 * rótulos em mono, seções com marcador), mas com vocabulário próprio:
 * aqui o marcador é o número do PASSO, não a coordenada da grade. A
 * assinatura do hero é a "ficha do primeiro dia", que se preenche
 * sozinha no carregamento — o estado base já é a ficha completa, então
 * sem animação (reduced motion) a pessoa vê tudo marcado.
 *
 * O CTA é um só, repetido: encontrar um campo. A página inteira existe
 * para tirar o medo de ir; a ida é no diretório.
 */

const TITULO = "Primeiro jogo de airsoft: nunca jogou? Comece aqui";
const DESCRICAO =
  "O que é airsoft, quanto custa, o que vestir, o que levar, se dá para alugar e " +
  "como funciona o dia de jogo. Tudo explicado para quem nunca jogou. Depois, " +
  "encontre um campo perto de você.";

/** Sumário: o id de cada seção e o rótulo curto do chip de navegação. */
const TOPICOS = [
  { id: "o-que-e", n: "01", rotulo: "O que é airsoft" },
  { id: "quanto-custa", n: "02", rotulo: "Quanto custa" },
  { id: "onde-jogar", n: "03", rotulo: "Onde jogar" },
  { id: "o-que-vestir", n: "04", rotulo: "O que vestir" },
  { id: "o-que-levar", n: "05", rotulo: "O que levar" },
  { id: "preciso-comprar", n: "06", rotulo: "Preciso comprar?" },
  { id: "posso-alugar", n: "07", rotulo: "Posso alugar?" },
  { id: "como-funciona", n: "08", rotulo: "Como funciona o jogo" },
  { id: "regras", n: "09", rotulo: "Regras básicas" },
  { id: "seguranca", n: "10", rotulo: "Segurança" },
  { id: "equipe", n: "11", rotulo: "Como encontrar uma equipe" },
];

/** Três fatos que separam o airsoft de outras coisas com "arma". */
const FATOS = [
  {
    t: "Não é arma de fogo",
    d: "A réplica atira bolinhas de plástico de 6 mm com ar comprimido. No Brasil é classificada como arma de pressão, e jogar é legal para maiores de 18 anos.",
    icone: "M12 2.5 4 5.5v6.2c0 4.6 3.3 8.2 8 9.8 4.7-1.6 8-5.2 8-9.8V5.5zM8.6 12l2.4 2.4 4.4-4.6",
  },
  {
    t: "Não deixa marca",
    d: "Diferente do paintball, a bolinha não tem tinta. Quem leva o tiro avisa. O jogo inteiro funciona na base da honestidade.",
    icone: "M12 4a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zM4 21v-2a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v2",
  },
  {
    t: "Dói pouco",
    d: "Com calça e manga longa, a sensação é de um elástico estalando na pele. Fica uma marquinha vermelha que some em minutos.",
    icone: "M4 12h4l2-5 4 10 2-5h4",
  },
];

/** Custo do primeiro dia, item por item — os mesmos valores do guia de custo. */
const CUSTO_DIA = [
  { item: "Entrada do campo", faixa: "R$ 40 a R$ 120" },
  { item: "Aluguel de réplica e proteção", faixa: "R$ 80 a R$ 200" },
  { item: "Bolinhas (BBs), se não vierem inclusas", faixa: "R$ 0 a R$ 40" },
];

/** O que procurar na ficha do campo antes de ir. */
const SINAIS_CAMPO = [
  {
    t: "Aceita iniciante",
    d: "A etiqueta aparece no cartão do campo. Quer dizer que o pessoal está acostumado a receber quem nunca jogou.",
  },
  {
    t: "Tem aluguel",
    d: "O campo empresta réplica, proteção e carrega a bateria. Você chega com a roupa do corpo e joga.",
  },
  {
    t: "Contato que responde",
    d: "Mande mensagem na semana do jogo e confirme vaga, valores e o que está incluso. Campo organizado responde.",
  },
];

/** Roupa: o que vestir e por quê, sem camuflagem obrigatória. */
const ROUPA = [
  {
    t: "Calça comprida",
    d: "Protege da bolinha, de galho e de inseto. Jeans ou calça de trabalho servem.",
    icone: "M7 3h10l1 18h-4l-2-9-2 9H6z",
  },
  {
    t: "Camiseta de manga longa",
    d: "Manga longa quase elimina a dor do tiro. Tecido grosso é melhor que fino.",
    icone: "M8 4h8l4 3-2 4-2-1v11H8V10l-2 1-2-4z",
  },
  {
    t: "Tênis fechado ou coturno",
    d: "O terreno tem buraco, raiz e pedra. Nada de chinelo ou sapatilha.",
    icone: "M3 17h18v3H3zM3 17l2-8h5l3 4h5l3 4",
  },
  {
    t: "Cor escura ou terrosa",
    d: "Verde, marrom, cinza ou preto. Camuflagem ajuda, mas não é obrigatória no primeiro dia.",
    icone: "M12 3a9 9 0 1 0 0 18V3z",
  },
  {
    t: "Luvas e boné (opcional)",
    d: "Tiro na mão dói mais que no resto do corpo. Luva de ciclismo ou de trabalho já resolve.",
    icone: "M6 21V10a2 2 0 0 1 4 0V6a2 2 0 0 1 4 0v4a2 2 0 0 1 4 0v11z",
  },
];

/** A mochila do primeiro dia. Vira lista com caixinha de marcar. */
const MOCHILA = [
  { chave: "protecao", t: "Proteção para os olhos própria para impacto", d: "Ou confirme que o aluguel do campo inclui." },
  { chave: "roupa", t: "Calça comprida e camiseta de manga longa", d: "Vestidas ou na mochila." },
  { chave: "calcado", t: "Tênis fechado ou coturno", d: "" },
  { chave: "documento", t: "Documento com foto", d: "Pedem na entrada para assinar o termo." },
  { chave: "agua", t: "Água", d: "Mais do que você acha que vai beber." },
  { chave: "sol", t: "Protetor solar e repelente", d: "" },
  { chave: "dinheiro", t: "Dinheiro ou Pix", d: "Para entrada, aluguel e bolinhas." },
  { chave: "lanche", t: "Um lanche", d: "O dia é longo e nem todo campo tem cantina." },
  { chave: "troca", t: "Roupa para a volta", d: "Você vai voltar suado e com terra." },
];

/** Como é o dia, na ordem em que acontece. */
const DIA = [
  {
    n: "01",
    t: "Chegada e cadastro",
    d: "Você se apresenta, mostra o documento e assina um termo de responsabilidade. Se alugou, é aqui que pega a réplica e a proteção.",
  },
  {
    n: "02",
    t: "Cronógrafo",
    d: "Um aparelho mede a velocidade da bolinha de cada réplica. É para garantir que ninguém atira com força acima do limite do campo. Réplica alugada já vem dentro do limite.",
  },
  {
    n: "03",
    t: "Briefing",
    d: "O organizador reúne todo mundo e explica as regras, onde é a safe zone (área sem tiro), o objetivo da partida e como avisar que foi atingido. Preste atenção mesmo que pareça óbvio.",
  },
  {
    n: "04",
    t: "Partidas",
    d: "O campo divide os presentes em dois times. Cada partida dura de 15 a 40 minutos, com objetivos simples: dominar um ponto, pegar uma bandeira, eliminar o outro time.",
  },
  {
    n: "05",
    t: "Pausa na safe zone",
    d: "Entre uma partida e outra, todo mundo volta para a área de descanso. É onde se bebe água, recarrega, conversa e tira a proteção do rosto. Só ali.",
  },
  {
    n: "06",
    t: "Fim do dia",
    d: "Normalmente meio período ou o dia inteiro. Devolve o equipamento alugado, agradece o pessoal e já pergunta quando é o próximo jogo.",
  },
];

/** As regras que valem em qualquer campo do país. */
const REGRAS = [
  {
    t: "Proteção nos olhos não sai do rosto",
    d: "Dentro do campo, nunca. Por nenhum motivo. Embaçou, suou, coçou: volta para a safe zone e resolve lá.",
  },
  {
    t: "Levou, assume",
    d: "Sentiu a bolinha bater em qualquer parte do corpo ou do equipamento, levanta a mão, grita “morri!” e sai do jogo até o próximo respawn. Ninguém confere. É por isso que o jogo funciona.",
  },
  {
    t: "Morto não fala",
    d: "Depois de atingido, você não passa informação para o seu time. Sai em silêncio, com a mão levantada.",
  },
  {
    t: "Trava de segurança na safe zone",
    d: "Área de descanso é área sem disparo. Réplica travada, apontada para baixo ou para cima.",
  },
  {
    t: "Distância mínima",
    d: "Muito perto, o tiro dói e pode cortar. Cada campo define uma distância mínima; abaixo dela, você diz “rendido” em vez de atirar.",
  },
  {
    t: "Dúvida? Chama o organizador",
    d: "Não discuta com outro jogador se ele levou ou não. Chame quem está organizando. Discussão em campo estraga o dia de todo mundo.",
  },
];

/** Segurança além das regras de jogo. */
const SEGURANCA = [
  {
    t: "Óculos de sol não serve",
    d: "A proteção precisa ser própria para impacto (balística). Lente comum estilhaça com a bolinha e vira o próprio acidente. É o único item em que não existe economia.",
    icone: "M2 12a5 5 0 0 1 8 0 5 5 0 0 1 4 0 5 5 0 0 1 8 0M2 12a5 5 0 0 0 8 0M14 12a5 5 0 0 0 8 0",
  },
  {
    t: "Proteja o rosto e os dentes",
    d: "Tiro no dente é a lesão mais cara do airsoft. Máscara inteira ou meia-máscara de tela protege. Muitos campos alugam a máscara junto com a réplica.",
    icone: "M12 3a7 7 0 0 0-7 7v4l2 5h10l2-5v-4a7 7 0 0 0-7-7zM8 13h8M9 17h6",
  },
  {
    t: "Sol, calor e água",
    d: "Você vai correr de calça e manga longa no sol. Beba água antes de sentir sede e pare se ficar tonto. O jogo não vale um mal-estar.",
    icone: "M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8z",
  },
  {
    t: "Transporte na bolsa",
    d: "Se levar réplica emprestada ou própria, ela vai guardada, fora da vista, com a ponta laranja no cano. Nunca no banco do carro nem na mão na rua.",
    icone: "M3 8h18v12H3zM8 8V6a4 4 0 0 1 8 0v2M3 13h18",
  },
];

const PERGUNTAS = [
  {
    p: "Preciso ter réplica para jogar a primeira vez?",
    r: "Não. Muitos campos alugam réplica, proteção e carregam a bateria para você. No diretório, procure a etiqueta “Tem aluguel” no cartão do campo. Jogue alugando uma ou duas vezes antes de gastar com equipamento.",
  },
  {
    p: "Quanto custa jogar airsoft pela primeira vez?",
    r: "Alugando tudo no campo, entre R$ 120 e R$ 360 pelo dia: entrada, aluguel de réplica com proteção e bolinhas. Valores de referência de agosto de 2026; cada campo publica os seus.",
  },
  {
    p: "Airsoft dói?",
    r: "Dói pouco. Com calça, manga longa e a distância normal de jogo, parece um elástico estalando na pele. Tiro muito perto ou em pele exposta dói mais e pode deixar uma marca roxa por alguns dias.",
  },
  {
    p: "Preciso de camuflagem para jogar?",
    r: "Não. Roupa comprida em cor escura ou terrosa resolve o primeiro dia. Camuflagem ajuda a se esconder, mas ficar parado e usar sombra ajuda muito mais.",
  },
  {
    p: "Qual a idade mínima para jogar airsoft?",
    r: "18 anos. Os campos pedem documento com foto na entrada e a assinatura de um termo de responsabilidade.",
  },
  {
    p: "Preciso estar em uma equipe?",
    r: "Não. Dá para jogar sozinho a vida toda: o campo divide os times no dia. A equipe vem depois, quando você quiser treino, carona e um grupo fixo.",
  },
  {
    p: "Vou passar vergonha por não saber jogar?",
    r: "Não. Todo campo tem iniciante toda semana, e o pessoal costuma gostar de ensinar. Avise no cadastro que é o seu primeiro jogo: normalmente colocam você perto de alguém experiente.",
  },
];

const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: PERGUNTAS.map(({ p, r }) => ({
    "@type": "Question",
    name: p,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};

const pagina = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: TITULO,
  description: DESCRICAO,
  inLanguage: "pt-BR",
  url: new URL("/primeiro-jogo-de-airsoft", Astro.site).href,
  audience: { "@type": "Audience", audienceType: "Iniciantes no airsoft" },
  about: { "@type": "Thing", name: "Airsoft" },
};

/** A ficha que se preenche sozinha no hero. */
const FICHA_HERO = [
  "Proteção no rosto",
  "Termo assinado",
  "Cronógrafo ok",
  "Briefing ouvido",
];
---

<Base titulo={TITULO} descricao={DESCRICAO} dadosEstruturados={[pagina, faq]}>
  <!-- ==========================================================
       HERO — a ficha do primeiro dia se preenche sozinha
       ========================================================== -->
  <section class="relative isolate overflow-hidden border-b border-borda bg-fundo">
    <div class="absolute inset-0 -z-30" aria-hidden="true">
      <Image
        src={fundoTopo}
        alt=""
        widths={[960, 1672]}
        sizes="100vw"
        loading="eager"
        class="h-full w-full object-cover object-[70%_center]"
      />
    </div>
    <div class="hero-escurecer absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="grade-tatica absolute inset-0 -z-10 opacity-30" aria-hidden="true"></div>

    <div
      class="mx-auto grid max-w-[1240px] items-center gap-10 px-5 py-14 md:px-12 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,520px)] lg:gap-14"
    >
      <div>
        <p class="rotulo">Para quem nunca jogou · Leitura de 10 minutos</p>

        <h1
          class="mt-4 font-display text-[44px] font-extrabold uppercase italic leading-[0.9] md:text-[72px]"
        >
          Nunca jogou airsoft?<br />
          <span class="text-oliva-500">Comece aqui.</span>
        </h1>

        <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-texto">
          O que é, quanto custa, o que vestir, o que levar, se dá para alugar e
          como funciona o dia de jogo. Explicado do zero, sem palavra difícil.
        </p>

        <p class="mt-4 max-w-[52ch] leading-relaxed text-texto-2">
          Ao final, você vai saber exatamente o que fazer no seu primeiro jogo
          de airsoft. E onde ele vai ser.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <Botao href="/campos">Encontre um campo perto de você</Botao>
          <Botao href="#sumario" variante="secundario" seta>Ler o guia</Botao>
        </div>

        <p class="mt-5 font-dado text-[13px] uppercase tracking-[0.14em] text-texto-2">
          <span class="text-oliva-300">Sem cadastro</span> · Sem comprar nada antes · Maiores de 18
        </p>
      </div>

      <!--
        A vitrine: a foto do primeiro dia (instrutor mostrando o campo
        para quem chegou com a máscara na mão) e, por cima, a ficha que
        se preenche sozinha — o resumo do que a página ensina.
      -->
      <div
        class="moldura-tatica order-first border border-borda-forte bg-fundo lg:order-none"
      >
        <div
          class="flex items-center justify-between gap-3 border-b border-borda px-3 py-2 font-dado text-[10px] uppercase tracking-[0.16em] text-texto-2"
        >
          <span class="flex items-center gap-2">
            <span class="ficha-pulso inline-block h-1.5 w-1.5 bg-oliva-400" aria-hidden="true"></span>
            Safe zone · Primeiro dia
          </span>
          <span class="hidden sm:inline">Domingo · 08h30</span>
        </div>

        <div class="relative aspect-[4/3] overflow-hidden bg-[#1a2016]">
          <Image
            src={fotoHero}
            alt="Instrutor de campo apontando o terreno para um jogador iniciante de camiseta branca que segura a máscara na mão, na safe zone"
            widths={[640, 1040]}
            sizes="(min-width: 1024px) 520px, 100vw"
            loading="eager"
            class="h-full w-full object-cover object-[60%_center]"
          />
          <div class="ficha-sombra absolute inset-0" aria-hidden="true"></div>

          <!-- A ficha, canto inferior esquerdo -->
          <ul
            class="ficha absolute bottom-3 left-3 m-0 list-none border border-borda-forte bg-fundo/85 p-3 backdrop-blur-[2px] md:bottom-4 md:left-4 md:p-4"
            aria-label="Ficha do primeiro dia"
          >
            {
              FICHA_HERO.map((item, i) => (
                <li
                  class="ficha-item flex items-center gap-2.5 py-1 font-dado text-[11px] uppercase tracking-[0.14em] text-tinta md:text-[12px]"
                  style={`--i:${i}`}
                >
                  <span class="ficha-caixa flex h-4 w-4 shrink-0 items-center justify-center border border-oliva-400">
                    <svg
                      viewBox="0 0 24 24"
                      class="ficha-tique h-3 w-3 text-oliva-300"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3.5"
                      aria-hidden="true"
                    >
                      <path d="m5 12 5 5 9-10" stroke-linecap="square" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))
            }
            <li
              class="ficha-pronto mt-2 border-t border-borda pt-2 font-dado text-[11px] uppercase tracking-[0.18em] text-latao md:text-[12px]"
            >
              Pronto para jogar
            </li>
          </ul>

          <div
            class="absolute right-4 top-3 font-dado text-[10px] tracking-[0.2em] text-tinta/60"
            aria-hidden="true"
          >
            CA // 00
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================
       SUMÁRIO — pule para o que você quer saber
       ========================================================== -->
  <nav
    id="sumario"
    aria-label="Assuntos desta página"
    class="border-b border-borda bg-papel/40"
  >
    <div class="mx-auto max-w-[1240px] px-5 py-6 md:px-12 md:py-8">
      <p class="rotulo">Onze perguntas · Pule para a sua</p>
      <ol class="mt-4 flex flex-wrap gap-2">
        {
          TOPICOS.map((topico) => (
            <li>
              <a
                href={`#${topico.id}`}
                class="chip-topico flex items-center gap-2 border border-borda bg-fundo px-3 py-2 text-[0.9375rem] text-texto transition-colors hover:border-oliva-500 hover:text-tinta"
              >
                <span class="font-dado text-[11px] tracking-[0.12em] text-oliva-400">{topico.n}</span>
                {topico.rotulo}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <!-- ==========================================================
       01 — O QUE É AIRSOFT
       ========================================================== -->
  <section id="o-que-e" class="mx-auto max-w-[1240px] scroll-mt-24 px-5 py-16 md:px-12 md:py-20">
    <div class="flex items-center gap-4">
      <span class="tag-passo" aria-hidden="true">01</span>
      <h2 class="font-display text-3xl font-bold uppercase tracking-[0.04em]">O que é airsoft</h2>
      <div class="h-px flex-1 bg-borda"></div>
    </div>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:gap-14">
      <div>
        <p class="max-w-[52ch] text-lg leading-relaxed text-texto">
          Airsoft é um jogo de equipe em que dois times disputam objetivos em
          um campo, usando réplicas de arma que atiram bolinhas de plástico.
          Parece paintball, mas a bolinha é pequena, não tem tinta e a
          réplica se parece com a arma de verdade.
        </p>
        <p class="mt-4 max-w-[52ch] leading-relaxed text-texto-2">
          Como a bolinha não marca, quem foi atingido avisa em voz alta e sai
          da partida. Isso muda tudo: airsoft é um jogo de honestidade antes de
          ser um jogo de pontaria.
        </p>
        <p class="mt-4 max-w-[52ch] leading-relaxed text-texto-2">
          A maior parte dos jogos no Brasil é <strong class="font-semibold text-texto">recreativa</strong>:
          partidas curtas, no fim de semana, com gente de todos os níveis. É
          por aí que todo mundo começa.
        </p>
        <a
          href="/guias/diferenca-entre-airsoft-e-paintball"
          class="mt-6 inline-block font-display text-base font-bold uppercase tracking-[0.08em] text-oliva-500 transition-colors hover:text-oliva-300"
        >
          Airsoft × paintball: as diferenças ›
        </a>
      </div>

      <ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
        {
          FATOS.map((fato) => (
            <li class="moldura-tatica flex gap-4 border border-borda bg-papel p-5">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center border border-oliva-700 bg-fundo text-oliva-300">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d={fato.icone} stroke-linecap="square" />
                </svg>
              </span>
              <div>
                <h3 class="font-display text-lg font-bold uppercase tracking-[0.03em]">{fato.t}</h3>
