<script>
  // Mochila do primeiro dia: o que a pessoa marca fica salvo no
  // navegador até o dia do jogo. Sem servidor, sem conta.
  const CHAVE = "primeiro-jogo:mochila";
  const caixas = Array.from(
    document.querySelectorAll<HTMLInputElement>("[data-mochila-item]"),
  );
  const progresso = document.querySelector<HTMLElement>("[data-mochila-progresso]");
  const limpar = document.querySelector<HTMLButtonElement>("[data-mochila-limpar]");

  const ler = (): string[] => {
    try {
      const bruto = localStorage.getItem(CHAVE);
      const lista = bruto ? JSON.parse(bruto) : [];
      return Array.isArray(lista) ? lista : [];
    } catch {
      return [];
    }
  };

  const salvar = (marcados: string[]) => {
    try {
      localStorage.setItem(CHAVE, JSON.stringify(marcados));
    } catch {
      // Navegador sem armazenamento: a lista só não persiste.
    }
  };

  const atualizar = () => {
    const marcados = caixas.filter((c) => c.checked).map((c) => c.dataset.mochilaItem!);
    if (progresso) {
      progresso.textContent =
        marcados.length === caixas.length
          ? "Mochila pronta. Só falta o dia."
          : `${marcados.length} de ${caixas.length} na mochila`;
    }
    salvar(marcados);
  };

  const salvos = new Set(ler());
  caixas.forEach((caixa) => {
    caixa.checked = salvos.has(caixa.dataset.mochilaItem!);
    caixa.addEventListener("change", atualizar);
  });
  limpar?.addEventListener("click", () => {
    caixas.forEach((caixa) => (caixa.checked = false));
    atualizar();
  });
  atualizar();
</script>

