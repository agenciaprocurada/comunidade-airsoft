---
/**
 * /achados — produtos que o site indica, com link de afiliado.
 *
 * O site não vende: mostra o produto e manda para a loja (Mercado
 * Livre, Shopee, AliExpress...). A comissão vem do link, e o visitante
 * é avisado disso logo no topo — é exigência do Google (`sponsored`)
 * e do CDC, e é o que separa indicação de propaganda escondida.
 *
 * SSR como /equipes: cadastrou no admin, apareceu. A vitrine muda com
 * o estoque de achados, não com o deploy.
 *
 * Preço é referência com mês: "R$ 189,90 · visto em set/26". O card
 * nunca promete o valor — quem promete é a loja.
 */
import Base from "../../layouts/Base.astro";
import TopoPagina from "../../components/TopoPagina.astro";
import Botao from "../../components/Botao.astro";
import {
  COLUNAS_ACHADO,
  EM_LOJA,
  formatarPreco,
  linkAfiliado,
  mesDoPreco,
  ordenarOfertas,
  type Achado,
} from "../../lib/achados";

export const prerender = false;

const { supabase } = Astro.locals;

/** Quantos a vitrine mostra de uma vez. */
const TETO = 60;

const { data: bruto, error } = await supabase
  .from("achados")
  .select(COLUNAS_ACHADO)
  .eq("status", "publicado")
  .order("atualizado_em", { ascending: false })
  .limit(TETO)
  .returns<Achado[]>();

if (error) console.error("Falha ao carregar os achados:", error);

/* Produto publicado sem nenhum link é card sem botão: fica de fora. */
const achados = (bruto ?? []).filter((a) => a.achado_ofertas.length > 0);

const lojasPresentes = new Set(achados.flatMap((a) => a.achado_ofertas.map((o) => o.loja)));

const titulo = "Achados de airsoft";
const descricao =
  "Produtos de airsoft que valem a pena, com link direto para a loja: proteção, " +
  "acessórios, baterias, BBs e o que mais a comunidade testou e indica.";

/**
 * ItemList com Product dentro: diz ao buscador que é uma lista de
 * produtos indicados, não uma loja. Sem `offers` de propósito — o
 * preço aqui é referência, e anunciar oferta em schema sem garantir o
 * valor rende aviso no Search Console.
 */
const dadoEstruturado = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: titulo,
  numberOfItems: achados.length,
  itemListElement: achados.map((a, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: a.nome,
      ...(a.descricao ? { description: a.descricao } : {}),
      ...(a.imagem_url ? { image: a.imagem_url } : {}),
    },
  })),
};

---

<Base
  titulo={titulo}
  descricao={descricao}
  semIndexar={achados.length === 0}
  dadosEstruturados={achados.length ? [dadoEstruturado] : []}
>
  <TopoPagina
    trilha={[{ texto: "Achados" }]}
    dados={[
      { icone: "caixa", texto: `${achados.length} ${achados.length === 1 ? "produto" : "produtos"}` },
      { icone: "loja", texto: `${lojasPresentes.size} ${lojasPresentes.size === 1 ? "loja" : "lojas"}` },
      { icone: "selo", texto: "Escolhidos a dedo" },
    ]}
    codigo="09"
  >
    Achados de<br />airsoft
    <Fragment slot="descricao">
      <p>{descricao}</p>
      <p class="text-base text-texto-2">
        Os links são de afiliado: se você comprar por eles, a loja paga uma
        comissão ao site e você não paga nada a mais. É isso que mantém a
        Comunidade Airsoft de pé.
      </p>
    </Fragment>
  </TopoPagina>

  <div class="mx-auto max-w-[1240px] px-5 pb-8 pt-2 md:px-12 md:pb-12 md:pt-4">
    {
      achados.length === 0 ? (
        <section class="moldura-tatica mt-6 border border-borda bg-papel p-8 md:p-10">
          <p class="rotulo">Em preparação</p>
          <h2 class="mt-3 font-display text-2xl font-bold uppercase md:text-3xl">
            Os primeiros achados estão chegando
          </h2>
          <p class="mt-4 max-w-[62ch] leading-relaxed text-texto-2">
            Estamos separando o que vale a pena indicar. Enquanto isso, o
            diretório de lojas mostra onde comprar na sua cidade.
          </p>
          <div class="mt-7">
            <Botao href="/lojas">Ver onde comprar</Botao>
          </div>
        </section>
      ) : (
        <>
          <p class="mt-6 border-b border-borda pb-3 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400">
            {achados.length} {achados.length === 1 ? "produto indicado" : "produtos indicados"}
            <span class="normal-case tracking-normal text-texto-2"> · preço é referência do mês em que foi visto; o valor final é o da loja</span>
          </p>

          {/*
            Cards no padrão da vitrine do Mercado Livre — brancos, com o
            preço em destaque — sobre o fundo escuro da página. 2 por
            linha no celular, 4 no desktop. Mesmo vocabulário do
            CarrosselAchados: quem viu o carrossel reconhece a vitrine.
          */}
          <ul class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 lg:gap-4">
            {achados.map((a) => {
              const ofertas = ordenarOfertas(a.achado_ofertas);
              const melhor = ofertas.reduce((m, o) =>
                o.preco != null && (m.preco == null || o.preco < m.preco) ? o : m,
              );
              const preco = formatarPreco(melhor.preco);
              const cheio = formatarPreco(melhor.preco_cheio);
              const desconto =
                melhor.preco != null && melhor.preco_cheio != null
                  ? Math.round((1 - melhor.preco / melhor.preco_cheio) * 100)
                  : 0;
              const comPreco = ofertas.filter((o) => o.preco != null).length;
              return (
                <li class="flex flex-col bg-white text-[#1f2a19] shadow-[0_1px_2px_rgba(0,0,0,0.25)] transition-shadow hover:shadow-[0_8px_20px_rgba(0,0,0,0.45)]">
                  {/*
                    A imagem é URL colada da loja e pode sumir. O quadro
                    fica atrás dela com o nome do produto: se o <img>
                    falhar, ele se remove e o quadro aparece.
                  */}
                  <div class="relative aspect-square w-full overflow-hidden bg-white">
                    <div class="absolute inset-0 flex items-center justify-center p-4 text-center font-display text-[15px] font-bold uppercase leading-tight text-[#9aa58a]">
                      {a.nome}
                    </div>
                    {a.imagem_url && (
                      <img
                        src={a.imagem_url}
                        alt={a.nome}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.remove()"
                        class="absolute inset-0 h-full w-full bg-white object-contain p-3"
                      />
                    )}
                  </div>

                  <div class="flex flex-1 flex-col border-t border-[#eef1e6] p-3 md:p-4">
                    <h2 class="line-clamp-2 text-[14px] leading-snug text-[#33402b] md:text-[15px]">
                      {a.nome}
                    </h2>

                    {cheio && <s class="mt-2 text-[12px] leading-none text-[#8a9480]">{cheio}</s>}
                    <p class="mt-1 flex flex-wrap items-baseline gap-x-2 leading-none">
                      {comPreco > 1 && <span class="text-[11px] text-[#6b7460]">a partir de</span>}
                      <span class="text-[20px] font-semibold md:text-[22px]">{preco ?? "Ver preço"}</span>
                      {desconto > 0 && <span class="text-[12px] font-semibold text-[#3d7a2a]">{desconto}% OFF</span>}
                    </p>

                    {a.descricao && (
                      <p class="mt-2 line-clamp-3 text-[12px] leading-snug text-[#6b7460] md:text-[13px]">{a.descricao}</p>
                    )}

                    <ul class="mt-auto flex flex-col gap-1.5 pt-3">
                      {ofertas.map((o) => {
                        const p = formatarPreco(o.preco);
                        const mes = mesDoPreco(o.preco_visto_em);
                        return (
                          <li>
                            <a
                              {...linkAfiliado(o.url)}
                              class="flex items-center justify-between gap-2 bg-[#27351e] px-3 py-2 text-[12px] font-semibold text-[#eff3e6] transition-colors hover:bg-[#3c512d] md:text-[13px]"
                            >
                              {/* No celular o card tem ~150px: "Comprar no Mercado Livre" quebrava em duas linhas. */}
                              <span class="font-display uppercase tracking-[0.04em]">
                                Comprar<span class="hidden md:inline"> {EM_LOJA[o.loja]}</span>
                              </span>
                              {ofertas.length > 1 && p && <span class="shrink-0 font-dado font-normal opacity-80">{p}</span>}
                            </a>
                            <span class="mt-0.5 block text-[10px] leading-snug text-[#8a9480]">
                              <span class="md:hidden">{EM_LOJA[o.loja]}{mes && " · "}</span>
                              {mes && `preço visto ${mes}`}
                            </span>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
  </div>
</Base>
