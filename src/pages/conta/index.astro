      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              <p class="font-display text-[1.5rem] font-bold uppercase leading-none tracking-[0.01em] text-tinta">
                {nomeExibido}
              </p>
              {
                perfil?.perfil_completo ? (
                  <Selo tom="ok" ponto={true}>
                    Cadastro completo
                  </Selo>
                ) : (
                  <Selo tom="atencao" ponto={true}>
                    Cadastro incompleto
                  </Selo>
                )
              }
            </div>
            <p class="mt-1.5 font-dado text-[0.8125rem] tracking-[0.06em] text-texto-2">
              {perfil?.nickname ? "@" + perfil.nickname : usuario?.email}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <!--
              Atalho para a gaveta de edição, que fica mais abaixo. Sem
              JS o link só rola até ela; com JS ela também abre.
            -->
            <a href="/conta?editar=1#editar" data-abrir-editar class={BOTAO_HUD}>
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                class="h-4 w-4"
              >
                <path
                  d="m14.5 5.5 4 4L8 20H4v-4zM12.5 7.5l4 4"
                  stroke-linecap="square"
                  stroke-linejoin="miter"></path>
              </svg>
              Editar meus dados
            </a>
          </div>
        </div>

        <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-3">
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Região
            </dt>
            <dd class="mt-1.5 text-[0.9375rem] text-tinta">{local ?? "—"}</dd>
          </div>
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Nível
            </dt>
            <dd class="mt-1.5 flex items-center gap-2 text-[0.9375rem] text-tinta">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 shrink-0 text-hud">
                <path d="M5 20v-4M10 20v-8M15 20v-12M20 20V4" stroke-linecap="square"></path>
              </svg>
              {rotuloNivel ?? "não informado"}
            </dd>
          </div>
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Estilo de jogo
            </dt>
            <dd class="mt-1.5 flex items-center gap-2 text-[0.9375rem] text-tinta">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0 text-hud">
                <circle cx="12" cy="12" r="8.5"></circle>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="12" cy="12" r="0.5" fill="currentColor"></circle>
                <path d="M12 3.5V7M12 17v3.5M3.5 12H7M17 12h3.5" stroke-linecap="square"></path>
              </svg>
              {estilosDoPerfil.length > 0 ? estilosDoPerfil.join(", ") : "não informado"}
            </dd>
          </div>
        </dl>

        <div class="mt-6">
          <p class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
            WhatsApp
          </p>
          <p class="mt-1.5 flex flex-wrap items-center gap-2.5">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0 text-hud">
              <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3z" stroke-linejoin="miter"></path>
              <path d="M9 8.5c0 4 2.5 6.5 6.5 6.5l.8-2-2.3-1-1 1c-1-.4-1.6-1-2-2l1-1-1-2.3z" stroke-linejoin="miter"></path>
            </svg>
            <span class="font-dado text-[0.875rem] text-tinta">
              {formatarWhatsapp(perfil?.whatsapp ?? null) || "—"}
            </span>
            {
              perfil?.whatsapp_verificado ? (
                <Selo tom="ok">Confirmado</Selo>
              ) : (
                <Selo>A confirmar</Selo>
              )
            }
            <a
              href="/conta?editar=1#editar"
              data-abrir-editar
              class="border border-borda-forte px-2 py-[3px] font-dado text-[0.6875rem] uppercase leading-none tracking-[0.1em] text-texto transition-colors duration-150 hover:border-hud/60 hover:text-hud focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hud"
            >
              Alterar
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Números que resumem a conta. Cada um leva para a sua seção. -->
    <ul class="mt-7 grid grid-cols-3 divide-x divide-borda border-t border-borda pt-6">
      {
        contadores.map((contador) => {
          const miolo = (
            <span class="flex shrink-0 items-center justify-center text-hud">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="h-10 w-10">
                <path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z" stroke-linejoin="miter" />
                <path d={MIOLO_CONTADOR[contador.icone]} stroke-linecap="square" stroke-linejoin="miter" />
              </svg>
            </span>
          );
          const numeros = (
            <span class="min-w-0">
              <span
                class:list={[
                  "block font-dado text-[1.5rem] leading-none",
                  contador.href ? "text-tinta transition-colors duration-150 group-hover:text-hud" : "text-texto-2",
                ]}
              >
                {String(contador.valor).padStart(2, "0")}
              </span>
              <span class="mt-1.5 block font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
                {contador.rotulo}
              </span>
            </span>
          );
          return (
            <li class="px-4 first:pl-0 last:pr-0 sm:px-6">
              {contador.href ? (
                <a
                  href={contador.href}
                  class="group flex items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hud sm:gap-4"
                >
                  {miolo}
                  {numeros}
                </a>
              ) : (
                <div class="flex items-center gap-3 opacity-80 sm:gap-4">
                  {miolo}
                  {numeros}
                </div>
              )}
            </li>
          );
        })
      }
    </ul>

    {
      membroDesde && (
        <p class="mt-6 flex items-center gap-2 border-t border-borda pt-5 font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4 shrink-0">
            <path d="M4 6h16v14H4zM4 10h16M8 3.5V7M16 3.5V7" stroke-linecap="square" stroke-linejoin="miter"></path>
          </svg>
          Na comunidade desde {membroDesde}
        </p>
      )
    }
  </section>

  <!--
    O formulário de edição vive num modal: o botão na ficha é a única
    porta. Abre sozinho quando o formulário voltou com erro, quando a
    pessoa veio de um pedido barrado ou via ?editar=1 (fallback do
    botão sem JavaScript).
  -->
  <Modal
    id="editar"
    titulo="Editar meus dados"
    descricao="Contato, região, nível, estilo e permissões de comunicação."
    aberta={gavetaAberta}
  >
    <div class="max-w-[62ch]">
      {
        erros.length > 0 && (
          <div class={"mb-7 " + ERRO_CAIXA}>
            <ul class="space-y-1">
              {erros.map((erro) => (
                <li class="text-alerta-texto">{erro}</li>
              ))}
            </ul>
          </div>
        )
      }
    <form method="POST" class="mt-10 space-y-7">
      <div>
        <label for="nome" class={ROTULO_CAMPO}>Nome</label>
        <input
          id="nome"
          name="nome"
          type="text"
          required
          maxlength="80"
          autocomplete="name"
          value={valor("nome", perfil?.nome)}
          class={ENTRADA}
        />
      </div>

      <div>
        <label for="nickname" class={ROTULO_CAMPO}>Apelido no campo</label>
        <p class={AJUDA_CAMPO}>
          Opcional. Minúsculas, sem espaço. É o nome que vai aparecer quando os
          perfis públicos existirem.
        </p>
        <input
          id="nickname"
          name="nickname"
          type="text"
          maxlength="24"
          placeholder="ex.: corvo-51"
          value={valor("nickname", perfil?.nickname)}
          class={ENTRADA}
        />
      </div>

      <div>
        <label for="whatsapp" class={ROTULO_CAMPO}>WhatsApp</label>
        <p class={AJUDA_CAMPO}>
          {
            perfil?.whatsapp_verificado
              ? "Número confirmado. Se você trocar, a confirmação cai e terá que refazer."
              : "Ainda não confirmado. A confirmação por WhatsApp entra numa próxima entrega."
          }
        </p>
        <input
          id="whatsapp"
          name="whatsapp"
          type="tel"
          required
          inputmode="tel"
          autocomplete="tel-national"
          placeholder="(51) 99999-8888"
          value={valor("whatsapp", formatarWhatsapp(perfil?.whatsapp ?? null))}
          class={ENTRADA}
        />
      </div>

      <div class="grid gap-6 sm:grid-cols-[9rem_1fr]">
        <div>
          <label for="uf" class={ROTULO_CAMPO}>Estado</label>
          <select id="uf" name="uf" required class={SELECAO}>
            <option value="">UF</option>
            {
              UFS.map(([sigla, nome]) => (
                <option value={sigla} selected={valor("uf", perfil?.uf) === sigla}>
                  {sigla} — {nome}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="cidade" class={ROTULO_CAMPO}>Cidade</label>
          <input
            id="cidade"
            name="cidade"
            type="text"
            required
            maxlength="60"
            autocomplete="address-level2"
            value={valor("cidade", perfil?.cidade)}
            class={ENTRADA}
          />
        </div>
      </div>

      <div>
        <label for="nivel" class={ROTULO_CAMPO}>Seu nível</label>
        <select id="nivel" name="nivel" class={SELECAO}>
          <option value="">Prefiro não dizer</option>
          {
            NIVEIS.map((nivel) => (
              <option
                value={nivel.valor}
                selected={valor("nivel", perfil?.nivel) === nivel.valor}
              >
                {nivel.rotulo} — {nivel.ajuda}
              </option>
            ))
          }
        </select>
      </div>

      <fieldset>
        <legend class={ROTULO_CAMPO}>Estilo que você joga</legend>
        <p class={AJUDA_CAMPO}>Pode marcar mais de um.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {
            ESTILOS.map((estilo) => (
              <label class={LINHA_CAIXA}>
                <input
                  type="checkbox"
                  name="estilos"
                  value={estilo.valor}
                  checked={estilosMarcados.includes(estilo.valor)}
                  class={CAIXA}
                />
                <span class="text-[15px] leading-snug text-texto">{estilo.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="instagram" class={ROTULO_CAMPO}>Instagram</label>
        <p class={AJUDA_CAMPO}>Opcional.</p>
        <input
          id="instagram"
          name="instagram"
          type="text"
          maxlength="60"
          placeholder="@seuperfil"
          value={valor("instagram", perfil?.redes?.instagram)}
          class={ENTRADA}
        />
      </div>

      <fieldset class="border-t border-borda pt-8">
        <legend class="rotulo">Permissões</legend>
        <p class={AJUDA_CAMPO}>
          Cada uma é separada e pode ser desmarcada quando você quiser.
        </p>
        <div class="mt-3 space-y-3">
          {
            CONSENTIMENTOS_OPCIONAIS.map((item) => (
              <label class={LINHA_CAIXA}>
                <input
                  type="checkbox"
                  name={item.tipo}
                  checked={marcadoOpcional(item.tipo)}
                  class={CAIXA}
                />
                <span class="text-[15px] leading-snug text-texto">{item.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <input type="hidden" name="voltar" value={voltarPara} />
      <button type="submit" class={BOTAO_PRIMARIO}>Salvar</button>
    </form>


    </div>
  </Modal>

    <!--
      Réplicas na mesma página do perfil: são a outra metade da ficha
      do jogador. A página /conta/armamentos virou redirecionamento.
    -->
    <section id="replicas" class="mt-14 scroll-mt-24 border-t border-borda pt-10">
      <Painel
        titulo="Minhas réplicas"
        contagem={totalReplicas > 0 ? `${totalReplicas} / ${LIMITE_REPLICAS}` : undefined}
        semMoldura={true}
      >
        {
          !noLimite && (
            <a
              slot="acao"
              href="/conta?replica=1#cadastrar-replica"
              data-abrir-replica
              class={BOTAO_HUD}
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4">
                <path d="M12 5v14M5 12h14" stroke-linecap="square" />
              </svg>
              Adicionar réplica
            </a>
          )
        }
        {
          totalReplicas === 0 ? (
            /* Estado vazio que ensina: diz o que a lista destrava, não
               apenas que está vazia. */
            <div class="moldura-tatica border border-borda bg-papel/60 px-5 py-8 sm:px-8">
              <p class="max-w-[54ch] text-[1.0625rem] leading-relaxed text-texto">
                Nenhuma réplica cadastrada ainda.
              </p>
              <ul class="mt-5 max-w-[58ch] space-y-2.5 text-[0.9375rem] leading-snug text-texto-2">
                <li class="flex gap-3">
                  <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-oliva-500" aria-hidden="true" />
                  O acionamento define seu consumível — bateria, gás ou ar.
                </li>
                <li class="flex gap-3">
                  <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-oliva-500" aria-hidden="true" />
                  A categoria diz o tipo de jogo em que você entra.
                </li>
                <li class="flex gap-3">
                  <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-oliva-500" aria-hidden="true" />
                  Marcar a principal ajuda a saber o que é o seu dia a dia.
                </li>
              </ul>
              <p class="mt-6 text-[0.9375rem] text-texto-2">
                Clique em "Adicionar réplica" aqui em cima. Leva menos de um
                minuto.
              </p>
            </div>
          ) : (
            <GradeCards>
              {listaReplicas.map((replica) => {
                const marca = nomeDaMarca(replica, listaMarcas);
                return (
                  <CardHud destaque={replica.principal}>
                    <div class="relative flex h-[9.5rem] items-center justify-center px-6">
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill={replica.principal ? "currentColor" : "none"}
                        stroke="currentColor"
                        stroke-width="1.4"
                        class:list={[
                          "absolute left-0 top-0 h-[1.15rem] w-[1.15rem]",
                          replica.principal ? "text-hud" : "text-texto-2/70",
                        ]}
                      >
                        <path
                          d="m12 3 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 18.3 5.9 21.6l1.4-6.8L2.2 10.1l6.9-.8z"
                          stroke-linejoin="miter"
                        />
                      </svg>

                      {replica.principal && (
                        <span class="absolute right-0 top-0 z-10 inline-flex items-center gap-1.5 border border-hud/60 bg-hud/10 px-2 py-1 font-dado text-[0.6875rem] uppercase leading-none tracking-[0.1em] text-hud">
                          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3">
                            <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
                          </svg>
                          Principal
                        </span>
                      )}

                      <ArteReplica categoria={replica.categoria} class="max-h-[8.5rem] max-w-[15rem]" />
                    </div>

                    <p class="mt-4 font-display text-[1.0625rem] font-bold uppercase leading-snug tracking-[0.01em] text-tinta">
                      {marca.nome} {replica.modelo}
                    </p>

                    <p class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                      <ChipHud>{rotuloAcionamento(replica.acionamento)}</ChipHud>
                      <span class="font-dado text-[0.75rem] uppercase tracking-[0.1em] text-texto-2">
                        <span aria-hidden="true" class="pr-1.5 text-borda-forte">/</span>
                        {rotuloCategoria(replica.categoria)}
                      </span>
                      {marca.pendente && <Selo tom="atencao">Marca a conferir</Selo>}
                    </p>

                    {replica.observacoes && (
                      <p class="mt-3 text-[0.9375rem] leading-snug text-texto-2">
                        {replica.observacoes}
                      </p>
                    )}

                    <div class="mt-auto flex flex-wrap gap-2 border-t border-borda pt-4">
                      {!replica.principal && (
                        <form method="POST" action="/conta#replicas">
                          <input type="hidden" name="acao" value="principal" />
                          <input type="hidden" name="id" value={replica.id} />
                          <button type="submit" class={BOTAO_HUD}>
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                              <path d="m12 3 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 18.3 5.9 21.6l1.4-6.8L2.2 10.1l6.9-.8z" stroke-linejoin="miter" />
                            </svg>
                            Tornar principal
                          </button>
                        </form>
                      )}
                      <form method="POST" action="/conta#replicas">
                        <input type="hidden" name="acao" value="apagar" />
                        <input type="hidden" name="id" value={replica.id} />
                        <button
                          type="submit"
                          class={`${BOTAO_HUD} hover:!border-alerta hover:!text-alerta-texto`}
                          aria-label={`Remover ${marca.nome} ${replica.modelo}`}
                        >
                          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                            <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" stroke-linecap="square" stroke-linejoin="miter" />
                          </svg>
                          Remover
                        </button>
                      </form>
                    </div>
                  </CardHud>
                );
              })}
            </GradeCards>
          )
        }
      </Painel>

      {
        noLimite ? (
          <p class="mt-8 border border-borda-forte bg-papel/60 px-4 py-3.5 text-[0.9375rem] text-texto-2">
            Você chegou ao limite de {LIMITE_REPLICAS} réplicas. Remova alguma
            para cadastrar outra.
          </p>
        ) : (
          <Modal
            id="cadastrar-replica"
            titulo="Cadastrar réplica"
            descricao="Adicione uma nova réplica à sua coleção."
            aberta={gavetaReplicaAberta}
          >
            <form method="POST" action="/conta#replicas" class="space-y-0">
              <input type="hidden" name="acao" value="adicionar" />

              {erroReplicaGeral && (
                <p class="mb-6 border border-alerta bg-alerta-bg px-4 py-3 text-[0.9375rem] text-alerta-texto">
                  {erroReplicaGeral}
                </p>
              )}

              <div class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
                <div>
                  <label for="marca" class={ROTULO_CAMPO}>Marca</label>
                  <select
                    id="marca"
                    name="marca"
                    required
                    aria-invalid={erroReplicaDe.marca ? "true" : undefined}
                    aria-describedby={erroReplicaDe.marca ? "erro-marca" : undefined}
                    class={erroReplicaDe.marca ? SELECAO_INVALIDA : SELECAO}
                  >
                    <option value="">Escolha</option>
                    <optgroup label="Mais comuns no Brasil">
                      {marcasComuns.map((m) => (
                        <option value={m.id} selected={valorReplica("marca") === m.id}>
                          {m.nome}
                        </option>
                      ))}
                    </optgroup>
                    <optgroup label="Outras marcas">
                      {marcasDemais.map((m) => (
                        <option value={m.id} selected={valorReplica("marca") === m.id}>
                          {m.nome}
                        </option>
                      ))}
                    </optgroup>
                    <option value={MARCA_OUTRA} selected={usouOutra}>
                      Não está na lista
                    </option>
                  </select>
                  {erroReplicaDe.marca && (
                    <p id="erro-marca" class={ERRO_CAMPO}>
                      {erroReplicaDe.marca}
                    </p>
                  )}
                </div>

                <div>
                  <label for="modelo" class={ROTULO_CAMPO}>Modelo</label>
                  <input
                    id="modelo"
                    name="modelo"
                    type="text"
                    required
                    maxlength="80"
                    placeholder="CM16 Raider"
                    value={valorReplica("modelo")}
                    aria-invalid={erroReplicaDe.modelo ? "true" : undefined}
                    aria-describedby={erroReplicaDe.modelo ? "erro-modelo" : undefined}
                    class={erroReplicaDe.modelo ? ENTRADA_INVALIDA : ENTRADA}
                  />
                  {erroReplicaDe.modelo && (
                    <p id="erro-modelo" class={ERRO_CAMPO}>
                      {erroReplicaDe.modelo}
                    </p>
                  )}
                </div>

                {/* Só aparece quando a marca não está na lista. */}
                <div class="campo-marca-livre sm:col-span-2" hidden={!usouOutra}>
                  <label for="marca_outra" class={ROTULO_CAMPO}>Qual é a marca?</label>
                  <p class={AJUDA_CAMPO}>
                    A gente confere e adiciona à lista oficial.
                  </p>
                  <input
                    id="marca_outra"
                    name="marca_outra"
                    type="text"
                    maxlength="60"
                    value={valorReplica("marca_outra")}
                    aria-invalid={erroReplicaDe.marca_outra ? "true" : undefined}
                    aria-describedby={erroReplicaDe.marca_outra ? "erro-marca-outra" : undefined}
                    class={erroReplicaDe.marca_outra ? ENTRADA_INVALIDA : ENTRADA}
                  />
                  {erroReplicaDe.marca_outra && (
                    <p id="erro-marca-outra" class={ERRO_CAMPO}>
                      {erroReplicaDe.marca_outra}
                    </p>
                  )}
                </div>

                <div>
                  <label for="acionamento" class={ROTULO_CAMPO}>Acionamento</label>
                  <select
                    id="acionamento"
                    name="acionamento"
                    required
                    aria-invalid={erroReplicaDe.acionamento ? "true" : undefined}
                    aria-describedby={erroReplicaDe.acionamento ? "erro-acionamento" : undefined}
                    class={erroReplicaDe.acionamento ? SELECAO_INVALIDA : SELECAO}
                  >
                    <option value="">Escolha</option>
                    {ACIONAMENTOS.map((a) => (
                      <option value={a.valor} selected={valorReplica("acionamento") === a.valor}>
                        {a.rotulo} — {a.ajuda}
                      </option>
                    ))}
                  </select>
                  {erroReplicaDe.acionamento && (
                    <p id="erro-acionamento" class={ERRO_CAMPO}>
                      {erroReplicaDe.acionamento}
                    </p>
                  )}
                </div>

                <div>
                  <label for="categoria" class={ROTULO_CAMPO}>Categoria</label>
                  <select
                    id="categoria"
                    name="categoria"
                    required
                    aria-invalid={erroReplicaDe.categoria ? "true" : undefined}
                    aria-describedby={erroReplicaDe.categoria ? "erro-categoria" : undefined}
                    class={erroReplicaDe.categoria ? SELECAO_INVALIDA : SELECAO}
                  >
                    <option value="">Escolha</option>
                    {CATEGORIAS.map((c) => (
                      <option value={c.valor} selected={valorReplica("categoria") === c.valor}>
                        {c.rotulo}
                      </option>
                    ))}
                  </select>
                  {erroReplicaDe.categoria && (
                    <p id="erro-categoria" class={ERRO_CAMPO}>
                      {erroReplicaDe.categoria}
                    </p>
                  )}
                </div>

                <div class="sm:col-span-2">
                  <label for="observacoes" class={ROTULO_CAMPO}>Observações</label>
                  <p class={AJUDA_CAMPO}>Opcional. Upgrades, estado, o que quiser.</p>
                  <input
                    id="observacoes"
                    name="observacoes"
                    type="text"
                    maxlength="300"
                    value={valorReplica("observacoes")}
                    aria-invalid={erroReplicaDe.observacoes ? "true" : undefined}
                    aria-describedby={erroReplicaDe.observacoes ? "erro-observacoes" : undefined}
                    class={erroReplicaDe.observacoes ? ENTRADA_INVALIDA : ENTRADA}
                  />
                  {erroReplicaDe.observacoes && (
                    <p id="erro-observacoes" class={ERRO_CAMPO}>
                      {erroReplicaDe.observacoes}
                    </p>
                  )}
                </div>

                <div class="sm:col-span-2">
                  <label class={LINHA_CAIXA}>
                    <input type="checkbox" name="principal" class={CAIXA} />
                    <span class="text-[0.9375rem] leading-snug text-texto">
                      É a que eu mais uso em campo
                    </span>
                  </label>
                </div>
              </div>

              <div class="mt-6">
                <button type="submit" class={BOTAO_PRIMARIO}>Cadastrar réplica</button>
              </div>
            </form>
          </Modal>
        )
      }
    </section>

    <section class="mt-12 border-t border-borda pt-7">
      <h2 class="text-[1.0625rem] font-semibold text-tinta">Seus dados</h2>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-texto-2">
        Para pedir a exclusão da sua conta e de todos os seus dados, escreva
        para{" "}
        <a href="mailto:contato@comunidadeairsoft.com.br" class="text-oliva-300 underline">
          contato@comunidadeairsoft.com.br
        </a>. O que fazemos com cada dado está na{" "}
        <a href="/privacidade" class="text-oliva-300 underline">Política de Privacidade</a>.
      </p>
    </section>
</Conta>

<script>
  /**
   * O campo de marca livre só aparece quando "Não está na lista" é a
   * escolha. Progressive enhancement: sem JS o campo fica escondido,
   * mas o servidor devolve a página com ele aberto e o erro no lugar —
   * o cadastro nunca fica impossível.
   */
  const seletor = document.querySelector<HTMLSelectElement>("#marca");
  const campo = document.querySelector<HTMLElement>(".campo-marca-livre");
  const entrada = document.querySelector<HTMLInputElement>("#marca_outra");

  if (seletor && campo && entrada) {
    const sincronizar = () => {
      const livre = seletor.value === "__outra__";
      campo.hidden = !livre;
      entrada.required = livre;
      if (!livre) entrada.value = "";
    };
    seletor.addEventListener("change", sincronizar);
  }

  /**
   * Os formulários vivem em modais ("Editar meus dados", "Cadastrar
   * réplica"). Sem JavaScript o href (?editar=1 / ?replica=1) faz o
   * servidor entregar o <dialog> já com `open`, no fluxo da página;
   * aqui esse estado é promovido a modal de verdade, com fundo escuro
   * e Esc fechando.
   */
  const ATALHOS: Array<[string, string]> = [
    ["[data-abrir-editar]", "#editar"],
    ["[data-abrir-replica]", "#cadastrar-replica"],
  ];
  for (const [gatilho, alvo] of ATALHOS) {
    const modal = document.querySelector<HTMLDialogElement>(alvo);
    if (!modal) continue;

    if (modal.open) {
      modal.close();
      modal.showModal();
    }

    for (const atalho of document.querySelectorAll<HTMLAnchorElement>(gatilho)) {
      atalho.addEventListener("click", (evento) => {
        evento.preventDefault();
        modal.showModal();
      });
    }

    // Clique no fundo escuro fecha — o alvo só é o próprio dialog
    // quando o clique cai fora da caixa de conteúdo.
    modal.addEventListener("click", (evento) => {
      if (evento.target === modal) modal.close();
    });
  }

  /**
   * "Alterar foto": escolher o arquivo já envia o formulário — sem um
   * segundo botão de confirmar que ninguém acharia.
   */
  const formFoto = document.querySelector<HTMLFormElement>("[data-form-foto]");
  const arquivoFoto = document.querySelector<HTMLInputElement>("[data-arquivo-foto]");
  if (formFoto && arquivoFoto) {
    arquivoFoto.addEventListener("change", () => {
      if (arquivoFoto.files && arquivoFoto.files.length > 0) formFoto.submit();
    });
  }
</script>
