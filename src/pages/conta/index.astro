          </span>
        </div>

        <form method="POST" enctype="multipart/form-data" data-form-foto>
          <input type="hidden" name="acao" value="foto" />
          <label class={`${BOTAO_HUD} cursor-pointer`}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
              <path d="M3 8h3.5L9 5h6l2.5 3H21v12H3z" stroke-linejoin="miter"></path>
              <circle cx="12" cy="13.5" r="3.5"></circle>
