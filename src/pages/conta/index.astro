---
import Conta from "../../layouts/Conta.astro";
import Selo from "../../components/conta/Selo.astro";
import Modal from "../../components/conta/Modal.astro";
import Painel from "../../components/conta/Painel.astro";
import ArteReplica from "../../components/conta/ArteReplica.astro";
import GradeCards from "../../components/conta/GradeCards.astro";
import CardHud from "../../components/conta/CardHud.astro";
import ChipHud from "../../components/conta/ChipHud.astro";
import {
  ACIONAMENTOS,
  CATEGORIAS,
  COLUNAS_ARMAMENTO,
  LIMITE_REPLICAS,
  MARCA_OUTRA,
  ehAcionamento,
  ehCategoria,
  nomeDaMarca,
  normalizarMarcaLivre,
  rotuloAcionamento,
  rotuloCategoria,
  type Armamento,
  type Marca,
} from "../../lib/armamento";
import { NOME_UF, slugificar } from "../../lib/uf";
import {
  CONSENTIMENTOS_OPCIONAIS,
  ESTILOS,
  NIVEIS,
  VERSAO_TERMOS,
  destinoSeguro,
  formatarWhatsapp,
  ipDaRequisicao,
  normalizarWhatsapp,
  type TipoConsentimento,
} from "../../lib/conta";
import {
  AJUDA_CAMPO,
  BOTAO_HUD,
  BOTAO_PRIMARIO,
  BOTAO_SECUNDARIO,
  CAIXA,
  ENTRADA,
  ENTRADA_INVALIDA,
  ERRO_CAIXA,
  ERRO_CAMPO,
  LINHA_CAIXA,
  ROTULO_CAMPO,
  SELECAO,
  SELECAO_INVALIDA,
} from "../../lib/estilos-form";

export const prerender = false;

const { supabase, usuario, perfil, admin } = Astro.locals;

const UFS = Object.entries(NOME_UF).sort(([a], [b]) => a.localeCompare(b));

let erros: string[] = [];
let salvo = false;
let enviado: Record<string, string> = {};
let estilosEnviados: string[] = [];
let opcionaisEnviados: Set<string> | null = null;

/** Erros do cadastro de réplica, separados dos erros do perfil. */
let erroReplicaDe: Record<string, string> = {};
let erroReplicaGeral = "";
let enviadoReplica: Record<string, string> = {};

/*
 * Perfil e réplicas moram na mesma página, então o POST chega num
 * lugar só. O corpo é lido UMA vez (formData consome o stream) e o
 * campo `acao` diz de qual formulário ele veio; sem `acao` é o
 * formulário do perfil, que existia antes dessa fusão.
 */
const dadosPost =
  Astro.request.method === "POST" && usuario ? await Astro.request.formData() : null;
const acaoPost = dadosPost?.get("acao")?.toString() ?? "perfil";

/** Erro do envio de foto, mostrado perto da ficha e não na gaveta. */
let erroFoto = "";

if (dadosPost && usuario && acaoPost === "foto") {
  const arquivo = dadosPost.get("foto");
  const TIPOS: Record<string, string> = {
    "image/jpeg": "jpg",
    "image/png": "png",
    "image/webp": "webp",
  };

  if (!(arquivo instanceof File) || arquivo.size === 0) {
    erroFoto = "Escolha uma imagem.";
  } else if (!TIPOS[arquivo.type]) {
    erroFoto = "Formato não aceito. Use JPG, PNG ou WebP.";
  } else if (arquivo.size > 4 * 1024 * 1024) {
    erroFoto = "A foto pode ter no máximo 4 MB.";
  } else {
    // Nome com carimbo de hora: troca de foto vira arquivo NOVO, e a
    // URL nova fura qualquer cache do navegador na hora.
    const caminho = `${usuario.id}/avatar-${Date.now()}.${TIPOS[arquivo.type]}`;
    const { error: erroEnvio } = await supabase.storage
      .from("avatares")
      .upload(caminho, await arquivo.arrayBuffer(), { contentType: arquivo.type });

    if (erroEnvio) {
      console.error("Falha ao enviar avatar:", erroEnvio);
      erroFoto = "Não conseguimos enviar a foto. Tente de novo em instantes.";
    } else {
      const { data: publica } = supabase.storage.from("avatares").getPublicUrl(caminho);
      const { error: erroPerfil } = await supabase
        .from("perfis")
        .update({ foto_url: publica.publicUrl })
        .eq("id", usuario.id);

      if (erroPerfil) {
        console.error("Falha ao gravar foto_url:", erroPerfil);
        erroFoto = "A foto subiu mas não conseguimos salvar. Tente de novo.";
      } else {
        return Astro.redirect("/conta?foto=1", 303);
      }
    }
  }
}

if (dadosPost && acaoPost === "apagar") {
  // A RLS já garante que só dá para apagar a própria réplica; o
  // filtro por usuario_id é cinto e suspensório.
  const { error } = await supabase
    .from("armamentos")
    .delete()
    .eq("id", dadosPost.get("id")?.toString() ?? "")
    .eq("usuario_id", usuario!.id);
  if (error) console.error("Falha ao apagar réplica:", error);
  return Astro.redirect("/conta?removida=1#replicas", 303);
}

if (dadosPost && acaoPost === "principal") {
  // O gatilho `armamentos_principal` desmarca a anterior sozinho.
  const { error } = await supabase
    .from("armamentos")
    .update({ principal: true })
    .eq("id", dadosPost.get("id")?.toString() ?? "")
    .eq("usuario_id", usuario!.id);
  if (error) console.error("Falha ao marcar principal:", error);
  return Astro.redirect("/conta#replicas", 303);
}

if (dadosPost && acaoPost === "adicionar") {
  const textoReplica = (chave: string) => (dadosPost.get(chave)?.toString() ?? "").trim();
  enviadoReplica = {
    marca: textoReplica("marca"),
    marca_outra: textoReplica("marca_outra"),
    modelo: textoReplica("modelo"),
    acionamento: textoReplica("acionamento"),
    categoria: textoReplica("categoria"),
    observacoes: textoReplica("observacoes"),
  };

  const usaOutra = enviadoReplica.marca === MARCA_OUTRA;
  const marcaLivre = normalizarMarcaLivre(enviadoReplica.marca_outra);

  if (!enviadoReplica.marca) erroReplicaDe.marca = "Escolha a marca.";
  if (usaOutra && (marcaLivre.length < 2 || marcaLivre.length > 60)) {
    erroReplicaDe.marca_outra = "Escreva a marca com 2 a 60 caracteres.";
  }
  if (!enviadoReplica.modelo) erroReplicaDe.modelo = "Informe o modelo.";
  else if (enviadoReplica.modelo.length > 80) erroReplicaDe.modelo = "No máximo 80 caracteres.";
  if (!ehAcionamento(enviadoReplica.acionamento)) {
    erroReplicaDe.acionamento = "Escolha o tipo de acionamento.";
  }
  if (!ehCategoria(enviadoReplica.categoria)) erroReplicaDe.categoria = "Escolha a categoria.";
  if (enviadoReplica.observacoes.length > 300) {
    erroReplicaDe.observacoes = "No máximo 300 caracteres.";
  }

  if (Object.keys(erroReplicaDe).length === 0) {
    const { error } = await supabase.from("armamentos").insert({
      usuario_id: usuario!.id,
      marca_id: usaOutra ? null : enviadoReplica.marca,
      marca_outra: usaOutra ? marcaLivre : null,
      modelo: enviadoReplica.modelo,
      acionamento: enviadoReplica.acionamento,
      categoria: enviadoReplica.categoria,
      principal: dadosPost.get("principal") === "on",
      observacoes: enviadoReplica.observacoes || null,
    });

    if (error) {
      if (error.message.includes("limite de 30")) {
        erroReplicaGeral = `Você chegou ao limite de ${LIMITE_REPLICAS} réplicas.`;
      } else if (error.code === "23503") {
        erroReplicaDe.marca = "Essa marca saiu da lista. Escolha outra.";
      } else {
        console.error("Falha ao cadastrar réplica:", error);
        erroReplicaGeral = "Não conseguimos salvar agora. Tente de novo em instantes.";
      }
    } else {
      return Astro.redirect("/conta?adicionada=1#replicas", 303);
    }
  }
}

if (dadosPost && usuario && acaoPost === "perfil") {
  const dados = dadosPost;
  const texto = (chave: string) => (dados.get(chave)?.toString() ?? "").trim();
  const marcado = (chave: string) => dados.get(chave) === "on";

  enviado = {
    nome: texto("nome"),
    nickname: texto("nickname").toLowerCase(),
    whatsapp: texto("whatsapp"),
    uf: texto("uf").toUpperCase(),
    cidade: texto("cidade"),
    nivel: texto("nivel"),
    instagram: texto("instagram"),
  };
  estilosEnviados = dados
    .getAll("estilos")
    .map((valor) => valor.toString())
    .filter((valor) => ESTILOS.some((estilo) => estilo.valor === valor));

  const whatsapp = normalizarWhatsapp(enviado.whatsapp);

  if (enviado.nome.length < 2) erros.push("Informe seu nome.");
  if (!whatsapp) {
    erros.push("WhatsApp inválido. Use DDD + número, ex.: (51) 99999-8888.");
  }
  if (!NOME_UF[enviado.uf]) erros.push("Escolha o estado.");
  if (enviado.cidade.length < 2) erros.push("Informe sua cidade.");
  if (enviado.nickname && !/^[a-z0-9._-]{3,24}$/.test(enviado.nickname)) {
    erros.push(
      "Apelido: de 3 a 24 caracteres, só letras minúsculas, números, ponto, hífen ou underline.",
    );
  }
  if (enviado.nivel && !NIVEIS.some((nivel) => nivel.valor === enviado.nivel)) {
    erros.push("Nível inválido.");
  }

  if (erros.length === 0) {
    // `.select()` no fim: um update que nao acerta nenhuma linha nao
    // da erro no PostgREST. Sem essa checagem, "salvo" pode ser mentira.
    const { data: perfilSalvo, error } = await supabase
      .from("perfis")
      .update({
        nome: enviado.nome,
        nickname: enviado.nickname || null,
        whatsapp,
        uf: enviado.uf,
        cidade: enviado.cidade,
        cidade_slug: slugificar(enviado.cidade),
        nivel: enviado.nivel || null,
        estilos: estilosEnviados,
        redes: enviado.instagram ? { instagram: enviado.instagram } : {},
      })
      .eq("id", usuario.id)
      .select("id")
      .maybeSingle();

    if (error) {
      // 23505 = violacao de unicidade; aqui so o apelido tem indice unico.
      if (error.code === "23505") {
        erros.push("Esse apelido já está em uso. Escolha outro.");
      } else {
        console.error("Falha ao salvar perfil:", error);
        erros.push("Não conseguimos salvar agora. Tente de novo em instantes.");
      }
    } else if (!perfilSalvo) {
      console.error("Update de perfil não alterou nenhuma linha para", usuario.id);
      erros.push("Não conseguimos salvar agora. Tente de novo em instantes.");
    }
  }

  // Consentimento opcional que mudou vira registro NOVO — a tabela e
  // append-only de proposito, o historico e a prova.
  if (erros.length === 0) {
    opcionaisEnviados = new Set(
      CONSENTIMENTOS_OPCIONAIS.filter((item) => marcado(item.tipo)).map((i) => i.tipo),
    );

    const { data: atuais } = await supabase
      .from("consentimentos_atuais")
      .select("tipo,concedido")
      .eq("usuario_id", usuario.id);

    const estadoAtual = new Map(
      (atuais ?? []).map((linha) => [linha.tipo as string, linha.concedido as boolean]),
    );

    const mudancas = CONSENTIMENTOS_OPCIONAIS.filter(
      (item) => (estadoAtual.get(item.tipo) ?? false) !== opcionaisEnviados!.has(item.tipo),
    ).map((item) => ({
      usuario_id: usuario.id,
      tipo: item.tipo,
      concedido: opcionaisEnviados!.has(item.tipo),
      versao_texto: VERSAO_TERMOS,
      ip: ipDaRequisicao(() => Astro.clientAddress),
      user_agent: Astro.request.headers.get("user-agent"),
    }));

    if (mudancas.length > 0) {
      const { error } = await supabase.from("consentimentos").insert(mudancas);
      if (error) {
        console.error("Falha ao registrar consentimentos:", error);
        erros.push("Seus dados foram salvos, mas não conseguimos registrar as permissões.");
      }
    }

    if (erros.length === 0) {
      // Veio de um pedido de reivindicação? Devolve para lá em vez de
      // largar a pessoa na tela de perfil sem contexto.
      const voltar = destinoSeguro(dados.get("voltar")?.toString());
      return Astro.redirect(voltar === "/conta" ? "/conta?salvo=1" : voltar, 303);
    }
  }
}

salvo = Astro.url.searchParams.get("salvo") === "1";
const adicionada = Astro.url.searchParams.get("adicionada") === "1";
const removida = Astro.url.searchParams.get("removida") === "1";
const fotoTrocada = Astro.url.searchParams.get("foto") === "1";
/** Fallback sem JS do botão "Adicionar réplica" (?replica=1). */
const pediuCadastroReplica = Astro.url.searchParams.get("replica") === "1";

// Réplicas moram nesta página: lista inteira + marcas para o seletor.
const [{ data: marcas }, { data: replicas }] = await Promise.all([
  supabase
    .from("marcas_replica")
    .select("id,nome,ordem")
    .order("ordem")
    .order("nome")
    .returns<Marca[]>(),
  supabase
    .from("armamentos")
    .select(COLUNAS_ARMAMENTO)
    .eq("usuario_id", usuario!.id)
    .order("principal", { ascending: false })
    .order("criado_em", { ascending: true })
    .returns<Armamento[]>(),
]);

const listaMarcas = marcas ?? [];
const listaReplicas = replicas ?? [];
const marcasComuns = listaMarcas.filter((m) => m.ordem <= 1);
const marcasDemais = listaMarcas.filter((m) => m.ordem > 1);
const totalReplicas = listaReplicas.length;
const noLimite = totalReplicas >= LIMITE_REPLICAS;

const houveErroReplica = Object.keys(erroReplicaDe).length > 0 || erroReplicaGeral !== "";
/** O modal de cadastro abre com erro de validacao ou a pedido. */
const gavetaReplicaAberta = houveErroReplica || pediuCadastroReplica;
const valorReplica = (chave: string) => enviadoReplica[chave] ?? "";
const usouOutra = valorReplica("marca") === MARCA_OUTRA;

// Estado dos opcionais para pintar as caixas no GET.
let opcionaisAtuais = new Set<string>();
if (Astro.request.method !== "POST" && usuario) {
  const { data } = await supabase
    .from("consentimentos_atuais")
    .select("tipo,concedido")
    .eq("usuario_id", usuario.id);
  for (const linha of data ?? []) {
    if (linha.concedido) opcionaisAtuais.add(linha.tipo as string);
  }
}

// So o POST do PERFIL repopula o formulario do perfil: um erro no
// cadastro de replica nao pode apagar os campos ja preenchidos.
const houvePost = dadosPost !== null && acaoPost === "perfil";
const valor = (chave: string, padrao: string | null | undefined) =>
  houvePost ? (enviado[chave] ?? "") : (padrao ?? "");

const estilosMarcados = houvePost ? estilosEnviados : (perfil?.estilos ?? []);
const opcionaisMarcados = houvePost ? (opcionaisEnviados ?? new Set()) : opcionaisAtuais;
const marcadoOpcional = (tipo: TipoConsentimento) => opcionaisMarcados.has(tipo);

/**
 * Quem foi barrado em /reivindicar chega aqui com `?motivo=reivindicar`.
 * Sem explicar o porquê, a pessoa cai numa tela de perfil sem entender
 * o que aconteceu com o pedido dela.
 */
const veioDeReivindicacao = Astro.url.searchParams.get("motivo") === "reivindicar";
const voltarPara = destinoSeguro(Astro.url.searchParams.get("voltar"));
const faltando = [
  !perfil?.nome && "o nome",
  !perfil?.nivel && "o nível",
  (perfil?.estilos ?? []).length === 0 && "o estilo de jogo",
].filter((f): f is string => typeof f === "string");

/* ------------------------------------------------------------------
   Painel e perfil viraram uma página só. O que era "painel" — avisos
   do que precisa de ação e contadores — entra aqui em cima, na ficha.
   O índice de seções que o painel tinha morreu: era uma cópia da
   navegação que está do lado esquerdo.
   ------------------------------------------------------------------ */

const [{ count: totalPaginas }, { data: pedidos }] = await Promise.all([
  supabase
    .from("reivindicacoes")
    .select("id", { count: "exact", head: true })
    .eq("usuario_id", usuario!.id)
    .eq("status", "aprovada"),
  supabase
    .from("reivindicacoes")
    .select("status")
    .eq("usuario_id", usuario!.id)
    .returns<{ status: string }[]>(),
]);

const pedidosAbertos = (pedidos ?? []).filter(
  (p) => p.status === "pendente" || p.status === "em_analise",
).length;

let filaModeracao = 0;
if (admin) {
  const { count } = await supabase
    .from("reivindicacoes")
    .select("id", { count: "exact", head: true })
    .in("status", ["pendente", "em_analise"]);
  filaModeracao = count ?? 0;
}

const recemCadastrado = Astro.url.searchParams.get("novo") === "1";

/**
 * A pessoa clicou em algo que exige o último passo (Editor de Mapas,
 * abrir operação) e foi trazida para cá entender o porquê.
 */
const veioDasFerramentas = Astro.url.searchParams.get("motivo") === "ferramentas";

/** Só aparece o que exige ação. Nada de bloco fixo dizendo "tudo certo". */
const avisos = [
  totalReplicas === 0
    ? {
        tom: "atencao" as const,
        texto:
          "Último passo: cadastre sua primeira réplica para liberar o Editor de Mapas e o cadastro de operações.",
        acao: { href: "/conta?replica=1#cadastrar-replica", texto: "Cadastrar minhas réplicas" },
      }
    : null,
  admin && filaModeracao > 0
    ? {
        tom: "atencao" as const,
        texto: `${filaModeracao} ${filaModeracao > 1 ? "reivindicações esperam" : "reivindicação espera"} sua análise.`,
        acao: { href: "/conta/admin/reivindicacoes", texto: "Abrir a fila" },
      }
    : null,
  pedidosAbertos > 0
    ? {
        tom: "neutro" as const,
        texto: `${pedidosAbertos} ${pedidosAbertos > 1 ? "pedidos seus estão" : "pedido seu está"} na fila de conferência.`,
        acao: { href: "/conta/reivindicacoes", texto: "Acompanhar" },
      }
    : null,
].filter((a) => a !== null);

const nomeExibido = perfil?.nome ?? usuario?.email ?? "jogador";
const inicial = nomeExibido.trim().charAt(0).toUpperCase();
const local = perfil?.cidade && perfil?.uf ? `${perfil.cidade}, ${NOME_UF[perfil.uf] ?? perfil.uf}` : null;
const rotuloNivel = NIVEIS.find((n) => n.valor === perfil?.nivel)?.rotulo ?? null;
const estilosDoPerfil = (perfil?.estilos ?? []).map(
  (valor) => ESTILOS.find((e) => e.valor === valor)?.rotulo ?? valor,
);

const membroDesde = usuario?.created_at
  ? new Date(usuario.created_at).toLocaleDateString("pt-BR", { month: "short", year: "numeric" })
  : null;

/**
 * A ficha é o que a página mostra; o formulário fica guardado. Abre
 * sozinho quando falta dado, quando houve erro, quando a pessoa veio
 * de um pedido barrado ou quando ela pede (?editar=1).
 */
/**
 * Quando o modal de edicao ja abre carregado: erro de validacao,
 * pedido barrado por perfil incompleto, ou ?editar=1 (fallback sem
 * JS do botao). Perfil incompleto por si so NAO abre — o selo e os
 * avisos ja cobram, e modal na cara a cada visita e assedio.
 */
const gavetaAberta =
  Astro.url.searchParams.get("editar") === "1" || erros.length > 0 || veioDeReivindicacao;

/** Miolo do hexágono de cada contador (desenho de 24x24). */
const MIOLO_CONTADOR = {
  replicas: "M8.5 9.5 12 7.5l3.5 2v4.5L12 16l-3.5-2zM12 7.5v4M12 11.5l3.5-2M12 11.5l-3.5-2",
  paginas: "M9 7h6M9 10h6M9 13h4M8.5 5.5h7v13h-7z",
  pedidos: "M8.5 5.5h7v13h-7zM10.5 9h3M10.5 12h2",
} as const;

const contadores = [
  { rotulo: "Réplicas", valor: totalReplicas, href: "#replicas", icone: "replicas" as const },
  {
    rotulo: "Páginas",
    valor: totalPaginas ?? 0,
    href: (totalPaginas ?? 0) > 0 ? "/conta/reivindicacoes" : null,
    icone: "paginas" as const,
  },
  {
    rotulo: "Pedidos abertos",
    valor: pedidosAbertos,
    href: pedidosAbertos > 0 ? "/conta/reivindicacoes" : null,
    icone: "pedidos" as const,
  },
];
---

<Conta
  titulo="Meu perfil"
  descricao="Seus dados na Comunidade Airsoft."
  resumo="Sua ficha na comunidade: seus dados e suas réplicas. WhatsApp e cidade nunca aparecem no site, e a lista de réplicas é só sua."
>
  {
    recemCadastrado && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">Pronto</Selo>
        {totalReplicas === 0
          ? "Cadastro criado. Bem-vindo à Comunidade Airsoft — falta só 1 passo, logo abaixo."
          : "Cadastro criado. Bem-vindo à Comunidade Airsoft."}
      </p>
    )
  }

  {
    veioDasFerramentas && (
      <p class="entrada-suave mt-8 border border-latao/50 bg-latao/[0.07] px-4 py-3.5 text-[0.9375rem] leading-snug text-latao">
        Quase lá: o Editor de Mapas e o cadastro de operações abrem depois do
        último passo do cadastro — perfil completo e pelo menos uma réplica
        cadastrada. É rápido, e libera as duas ferramentas de uma vez.
      </p>
    )
  }

  {
    salvo && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">Pronto</Selo>
        Dados salvos.
      </p>
    )
  }

  {
    (adicionada || removida || fotoTrocada) && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">Pronto</Selo>
        {adicionada ? "Réplica cadastrada." : removida ? "Réplica removida." : "Foto atualizada."}
      </p>
    )
  }

  {
    erroFoto && (
      <p class="entrada-suave mt-8 border border-alerta bg-alerta-bg px-4 py-3 text-[0.9375rem] text-alerta-texto">
