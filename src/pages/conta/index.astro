---
import Conta from "../../layouts/Conta.astro";
import Selo from "../../components/conta/Selo.astro";
import Gaveta from "../../components/conta/Gaveta.astro";
import { NOME_UF, slugificar } from "../../lib/uf";
import {
  CONSENTIMENTOS_OPCIONAIS,
  ESTILOS,
  NIVEIS,
  VERSAO_TERMOS,
  destinoSeguro,
  formatarWhatsapp,
  ipDaRequisicao,
  normalizarWhatsapp,
  type TipoConsentimento,
} from "../../lib/conta";
import {
  AJUDA_CAMPO,
  BOTAO_PRIMARIO,
  BOTAO_SECUNDARIO,
  CAIXA,
  ENTRADA,
  ERRO_CAIXA,
  LINHA_CAIXA,
  ROTULO_CAMPO,
  SELECAO,
} from "../../lib/estilos-form";

export const prerender = false;

const { supabase, usuario, perfil, admin } = Astro.locals;

const UFS = Object.entries(NOME_UF).sort(([a], [b]) => a.localeCompare(b));

let erros: string[] = [];
let salvo = false;
let enviado: Record<string, string> = {};
let estilosEnviados: string[] = [];
let opcionaisEnviados: Set<string> | null = null;

if (Astro.request.method === "POST" && usuario) {
  const dados = await Astro.request.formData();
  const texto = (chave: string) => (dados.get(chave)?.toString() ?? "").trim();
  const marcado = (chave: string) => dados.get(chave) === "on";

  enviado = {
    nome: texto("nome"),
    nickname: texto("nickname").toLowerCase(),
    whatsapp: texto("whatsapp"),
    uf: texto("uf").toUpperCase(),
    cidade: texto("cidade"),
    nivel: texto("nivel"),
    instagram: texto("instagram"),
  };
  estilosEnviados = dados
    .getAll("estilos")
    .map((valor) => valor.toString())
    .filter((valor) => ESTILOS.some((estilo) => estilo.valor === valor));

  const whatsapp = normalizarWhatsapp(enviado.whatsapp);

  if (enviado.nome.length < 2) erros.push("Informe seu nome.");
  if (!whatsapp) {
    erros.push("WhatsApp inválido. Use DDD + número, ex.: (51) 99999-8888.");
  }
  if (!NOME_UF[enviado.uf]) erros.push("Escolha o estado.");
  if (enviado.cidade.length < 2) erros.push("Informe sua cidade.");
  if (enviado.nickname && !/^[a-z0-9._-]{3,24}$/.test(enviado.nickname)) {
    erros.push(
      "Apelido: de 3 a 24 caracteres, só letras minúsculas, números, ponto, hífen ou underline.",
    );
  }
  if (enviado.nivel && !NIVEIS.some((nivel) => nivel.valor === enviado.nivel)) {
    erros.push("Nível inválido.");
  }

  if (erros.length === 0) {
    // `.select()` no fim: um update que nao acerta nenhuma linha nao
    // da erro no PostgREST. Sem essa checagem, "salvo" pode ser mentira.
    const { data: perfilSalvo, error } = await supabase
      .from("perfis")
      .update({
        nome: enviado.nome,
        nickname: enviado.nickname || null,
        whatsapp,
        uf: enviado.uf,
        cidade: enviado.cidade,
        cidade_slug: slugificar(enviado.cidade),
        nivel: enviado.nivel || null,
        estilos: estilosEnviados,
        redes: enviado.instagram ? { instagram: enviado.instagram } : {},
      })
      .eq("id", usuario.id)
      .select("id")
      .maybeSingle();

    if (error) {
      // 23505 = violacao de unicidade; aqui so o apelido tem indice unico.
      if (error.code === "23505") {
        erros.push("Esse apelido já está em uso. Escolha outro.");
      } else {
        console.error("Falha ao salvar perfil:", error);
        erros.push("Não conseguimos salvar agora. Tente de novo em instantes.");
      }
    } else if (!perfilSalvo) {
      console.error("Update de perfil não alterou nenhuma linha para", usuario.id);
      erros.push("Não conseguimos salvar agora. Tente de novo em instantes.");
    }
  }

  // Consentimento opcional que mudou vira registro NOVO — a tabela e
  // append-only de proposito, o historico e a prova.
  if (erros.length === 0) {
    opcionaisEnviados = new Set(
      CONSENTIMENTOS_OPCIONAIS.filter((item) => marcado(item.tipo)).map((i) => i.tipo),
    );

    const { data: atuais } = await supabase
      .from("consentimentos_atuais")
      .select("tipo,concedido")
      .eq("usuario_id", usuario.id);

    const estadoAtual = new Map(
      (atuais ?? []).map((linha) => [linha.tipo as string, linha.concedido as boolean]),
    );

    const mudancas = CONSENTIMENTOS_OPCIONAIS.filter(
      (item) => (estadoAtual.get(item.tipo) ?? false) !== opcionaisEnviados!.has(item.tipo),
    ).map((item) => ({
      usuario_id: usuario.id,
      tipo: item.tipo,
      concedido: opcionaisEnviados!.has(item.tipo),
      versao_texto: VERSAO_TERMOS,
      ip: ipDaRequisicao(() => Astro.clientAddress),
      user_agent: Astro.request.headers.get("user-agent"),
    }));

    if (mudancas.length > 0) {
      const { error } = await supabase.from("consentimentos").insert(mudancas);
      if (error) {
        console.error("Falha ao registrar consentimentos:", error);
        erros.push("Seus dados foram salvos, mas não conseguimos registrar as permissões.");
      }
    }

    if (erros.length === 0) {
      // Veio de um pedido de reivindicação? Devolve para lá em vez de
      // largar a pessoa na tela de perfil sem contexto.
      const voltar = destinoSeguro(dados.get("voltar")?.toString());
      return Astro.redirect(voltar === "/conta" ? "/conta?salvo=1" : voltar, 303);
    }
  }
}

salvo = Astro.url.searchParams.get("salvo") === "1";

// Só a contagem: a lista em si vive em /conta/armamentos.
const { count } = await supabase
  .from("armamentos")
  .select("id", { count: "exact", head: true })
  .eq("usuario_id", usuario!.id);
const totalReplicas = count ?? 0;

// Estado dos opcionais para pintar as caixas no GET.
let opcionaisAtuais = new Set<string>();
if (Astro.request.method !== "POST" && usuario) {
  const { data } = await supabase
    .from("consentimentos_atuais")
    .select("tipo,concedido")
    .eq("usuario_id", usuario.id);
  for (const linha of data ?? []) {
    if (linha.concedido) opcionaisAtuais.add(linha.tipo as string);
  }
}

const houvePost = Astro.request.method === "POST";
const valor = (chave: string, padrao: string | null | undefined) =>
  houvePost ? (enviado[chave] ?? "") : (padrao ?? "");

const estilosMarcados = houvePost ? estilosEnviados : (perfil?.estilos ?? []);
const opcionaisMarcados = houvePost ? (opcionaisEnviados ?? new Set()) : opcionaisAtuais;
const marcadoOpcional = (tipo: TipoConsentimento) => opcionaisMarcados.has(tipo);

/**
 * Quem foi barrado em /reivindicar chega aqui com `?motivo=reivindicar`.
 * Sem explicar o porquê, a pessoa cai numa tela de perfil sem entender
 * o que aconteceu com o pedido dela.
 */
const veioDeReivindicacao = Astro.url.searchParams.get("motivo") === "reivindicar";
const voltarPara = destinoSeguro(Astro.url.searchParams.get("voltar"));
const faltando = [
  !perfil?.nome && "o nome",
  !perfil?.nivel && "o nível",
  (perfil?.estilos ?? []).length === 0 && "o estilo de jogo",
].filter((f): f is string => typeof f === "string");

/* ------------------------------------------------------------------
   Painel e perfil viraram uma página só. O que era "painel" — avisos
   do que precisa de ação e contadores — entra aqui em cima, na ficha.
   O índice de seções que o painel tinha morreu: era uma cópia da
   navegação que está do lado esquerdo.
   ------------------------------------------------------------------ */

const [{ count: totalPaginas }, { data: pedidos }] = await Promise.all([
  supabase
    .from("reivindicacoes")
    .select("id", { count: "exact", head: true })
    .eq("usuario_id", usuario!.id)
    .eq("status", "aprovada"),
  supabase
    .from("reivindicacoes")
    .select("status")
    .eq("usuario_id", usuario!.id)
    .returns<{ status: string }[]>(),
]);

const pedidosAbertos = (pedidos ?? []).filter(
  (p) => p.status === "pendente" || p.status === "em_analise",
).length;

let filaModeracao = 0;
if (admin) {
  const { count } = await supabase
    .from("reivindicacoes")
    .select("id", { count: "exact", head: true })
    .in("status", ["pendente", "em_analise"]);
  filaModeracao = count ?? 0;
}

const recemCadastrado = Astro.url.searchParams.get("novo") === "1";

/** Só aparece o que exige ação. Nada de bloco fixo dizendo "tudo certo". */
const avisos = [
  admin && filaModeracao > 0
    ? {
        tom: "atencao" as const,
        texto: `${filaModeracao} ${filaModeracao > 1 ? "reivindicações esperam" : "reivindicação espera"} sua análise.`,
        acao: { href: "/conta/admin/reivindicacoes", texto: "Abrir a fila" },
      }
    : null,
  pedidosAbertos > 0
    ? {
        tom: "neutro" as const,
        texto: `${pedidosAbertos} ${pedidosAbertos > 1 ? "pedidos seus estão" : "pedido seu está"} na fila de conferência.`,
        acao: { href: "/conta/reivindicacoes", texto: "Acompanhar" },
      }
    : null,
].filter((a) => a !== null);

const nomeExibido = perfil?.nome ?? usuario?.email ?? "jogador";
const inicial = nomeExibido.trim().charAt(0).toUpperCase();
const local = perfil?.cidade && perfil?.uf ? `${perfil.cidade}, ${NOME_UF[perfil.uf] ?? perfil.uf}` : null;
const rotuloNivel = NIVEIS.find((n) => n.valor === perfil?.nivel)?.rotulo ?? null;
const estilosDoPerfil = (perfil?.estilos ?? []).map(
  (valor) => ESTILOS.find((e) => e.valor === valor)?.rotulo ?? valor,
);

const membroDesde = usuario?.created_at
  ? new Date(usuario.created_at).toLocaleDateString("pt-BR", { month: "short", year: "numeric" })
  : null;

/**
 * A ficha é o que a página mostra; o formulário fica guardado. Abre
 * sozinho quando falta dado, quando houve erro, quando a pessoa veio
 * de um pedido barrado ou quando ela pede (?editar=1).
 */
const gavetaAberta =
  Astro.url.searchParams.get("editar") === "1" ||
  erros.length > 0 ||
  veioDeReivindicacao ||
  !perfil?.perfil_completo;

const contadores = [
  { rotulo: "Réplicas", valor: totalReplicas, href: "/conta/armamentos" },
  { rotulo: "Páginas", valor: totalPaginas ?? 0, href: (totalPaginas ?? 0) > 0 ? "/conta/reivindicacoes" : null },
  { rotulo: "Pedidos abertos", valor: pedidosAbertos, href: pedidosAbertos > 0 ? "/conta/reivindicacoes" : null },
];
---

<Conta
  titulo="Meu perfil"
  descricao="Seus dados na Comunidade Airsoft."
  resumo="Sua ficha na comunidade. Nome, nível e estilo são o que falta para poder cadastrar ou assumir alguma página; WhatsApp e cidade nunca aparecem no site."
>
  {
    recemCadastrado && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">Pronto</Selo>
        Cadastro criado. Bem-vindo à Comunidade Airsoft.
      </p>
    )
  }

  {
    salvo && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">Pronto</Selo>
        Dados salvos.
      </p>
    )
  }

  {
    veioDeReivindicacao && (
      <p class="entrada-suave mt-8 border border-latao/50 bg-latao/[0.07] px-4 py-3.5 text-[0.9375rem] leading-snug text-latao">
        Para assumir uma página, o perfil precisa estar completo. Falta{" "}
        {faltando.join(", ")}. Preencha abaixo e a gente te leva de volta ao pedido.
      </p>
    )
  }

  {
    avisos.length > 0 && (
      <ul class="mt-8 space-y-2">
        {avisos.map((aviso) => (
          <li
            class:list={[
              "flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border px-4 py-3.5",
              aviso!.tom === "atencao"
                ? "border-latao/50 bg-latao/[0.07]"
                : "border-borda-forte bg-papel/60",
            ]}
          >
            <p
              class:list={[
                "max-w-[60ch] text-[0.9375rem] leading-snug",
                aviso!.tom === "atencao" ? "text-latao" : "text-texto",
              ]}
            >
              {aviso!.texto}
            </p>
            <a href={aviso!.acao.href} class={BOTAO_SECUNDARIO}>
              {aviso!.acao.texto}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <!--
    Ficha do jogador.
    A página lidera com o que a pessoa É na comunidade, não com um
    formulário: campo editável é meio, o perfil é o fim. O formulário
    fica guardado na gaveta logo abaixo.
  -->
  <section
    class:list={[
      "moldura-hud mt-10 border bg-fundo/70 p-6 sm:p-7",
      perfil?.perfil_completo ? "border-borda" : "moldura-hud-ativa border-hud/40",
    ]}
  >
    <div class="flex flex-wrap items-start gap-5 sm:flex-nowrap sm:gap-6">
      {
        perfil?.foto_url ? (
          <img
            src={perfil.foto_url}
            alt=""
            width="88"
            height="88"
            referrerpolicy="no-referrer"
            class="octogono h-[5.5rem] w-[5.5rem] shrink-0 bg-oliva-050 object-cover"
          />
        ) : (
          <span class="octogono flex h-[5.5rem] w-[5.5rem] shrink-0 items-center justify-center bg-oliva-050 font-display text-3xl font-bold text-hud">
            {inicial}
          </span>
        )
      }

      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-display text-[1.5rem] font-bold uppercase leading-none tracking-[0.01em] text-tinta">
              {nomeExibido}
            </p>
            <p class="mt-1.5 font-dado text-[0.8125rem] tracking-[0.06em] text-texto-2">
              {perfil?.nickname ? "@" + perfil.nickname : usuario?.email}
            </p>
          </div>
          {
            perfil?.perfil_completo ? (
              <Selo tom="ok" ponto={true}>
                Cadastro completo
              </Selo>
            ) : (
              <Selo tom="atencao" ponto={true}>
                Cadastro incompleto
              </Selo>
            )
          }
        </div>

        <dl class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Região
            </dt>
            <dd class="mt-1 text-[0.9375rem] text-tinta">{local ?? "—"}</dd>
          </div>
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Nível
            </dt>
            <dd class="mt-1 text-[0.9375rem] text-tinta">{rotuloNivel ?? "não informado"}</dd>
          </div>
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              WhatsApp
            </dt>
            <dd class="mt-1 flex flex-wrap items-center gap-2.5">
              <span class="font-dado text-[0.875rem] text-tinta">
                {formatarWhatsapp(perfil?.whatsapp ?? null) || "—"}
              </span>
              {
                perfil?.whatsapp_verificado ? (
                  <Selo tom="ok">Confirmado</Selo>
                ) : (
                  <Selo>A confirmar</Selo>
                )
              }
            </dd>
          </div>
          <div>
            <dt class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Estilo de jogo
            </dt>
            <dd class="mt-1 flex flex-wrap gap-1.5">
              {
                estilosDoPerfil.length > 0 ? (
                  estilosDoPerfil.map((estilo) => (
                    <span class="border border-hud/40 px-2 py-[3px] font-dado text-[0.6875rem] uppercase leading-none tracking-[0.1em] text-hud">
                      {estilo}
                    </span>
                  ))
                ) : (
                  <span class="text-[0.9375rem] text-texto-2">não informado</span>
                )
              }
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Números que resumem a conta. Cada um leva para a sua seção. -->
    <ul class="mt-7 grid grid-cols-3 gap-4 border-t border-borda pt-5">
      {
        contadores.map((contador) => (
          <li>
            {contador.href ? (
              <a
                href={contador.href}
                class="group block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hud"
              >
                <span class="block font-dado text-[1.5rem] leading-none text-hud transition-colors duration-150 group-hover:text-oliva-100">
                  {String(contador.valor).padStart(2, "0")}
                </span>
                <span class="mt-1.5 block font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
                  {contador.rotulo}
                </span>
              </a>
            ) : (
              <div>
                <span class="block font-dado text-[1.5rem] leading-none text-texto-2">
                  {String(contador.valor).padStart(2, "0")}
                </span>
                <span class="mt-1.5 block font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
                  {contador.rotulo}
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    {
      membroDesde && (
        <p class="mt-5 font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
          Na comunidade desde {membroDesde}
        </p>
      )
    }
  </section>

  <Gaveta
    id="editar"
    titulo="Editar meus dados"
    descricao="Contato, região, nível, estilo e permissões de comunicação."
    aberta={gavetaAberta}
    icone="lapis"
    class="mt-6"
  >
    <div class="max-w-[62ch]">
      {
        erros.length > 0 && (
          <div class={"mb-7 " + ERRO_CAIXA}>
            <ul class="space-y-1">
              {erros.map((erro) => (
                <li class="text-alerta-texto">{erro}</li>
              ))}
            </ul>
          </div>
        )
      }
    <form method="POST" class="mt-10 space-y-7">
      <div>
        <label for="nome" class={ROTULO_CAMPO}>Nome</label>
        <input
          id="nome"
          name="nome"
          type="text"
          required
          maxlength="80"
          autocomplete="name"
          value={valor("nome", perfil?.nome)}
          class={ENTRADA}
        />
      </div>

      <div>
        <label for="nickname" class={ROTULO_CAMPO}>Apelido no campo</label>
        <p class={AJUDA_CAMPO}>
          Opcional. Minúsculas, sem espaço. É o nome que vai aparecer quando os
          perfis públicos existirem.
        </p>
        <input
          id="nickname"
          name="nickname"
          type="text"
          maxlength="24"
          placeholder="ex.: corvo-51"
          value={valor("nickname", perfil?.nickname)}
          class={ENTRADA}
        />
      </div>

      <div>
        <label for="whatsapp" class={ROTULO_CAMPO}>WhatsApp</label>
        <p class={AJUDA_CAMPO}>
          {
            perfil?.whatsapp_verificado
              ? "Número confirmado. Se você trocar, a confirmação cai e terá que refazer."
              : "Ainda não confirmado. A confirmação por WhatsApp entra numa próxima entrega."
          }
        </p>
        <input
          id="whatsapp"
          name="whatsapp"
          type="tel"
          required
          inputmode="tel"
          autocomplete="tel-national"
          placeholder="(51) 99999-8888"
          value={valor("whatsapp", formatarWhatsapp(perfil?.whatsapp ?? null))}
          class={ENTRADA}
        />
      </div>

      <div class="grid gap-6 sm:grid-cols-[9rem_1fr]">
        <div>
          <label for="uf" class={ROTULO_CAMPO}>Estado</label>
          <select id="uf" name="uf" required class={SELECAO}>
            <option value="">UF</option>
            {
              UFS.map(([sigla, nome]) => (
                <option value={sigla} selected={valor("uf", perfil?.uf) === sigla}>
                  {sigla} — {nome}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="cidade" class={ROTULO_CAMPO}>Cidade</label>
          <input
            id="cidade"
            name="cidade"
            type="text"
            required
            maxlength="60"
            autocomplete="address-level2"
            value={valor("cidade", perfil?.cidade)}
            class={ENTRADA}
          />
        </div>
      </div>

      <div>
        <label for="nivel" class={ROTULO_CAMPO}>Seu nível</label>
        <select id="nivel" name="nivel" class={SELECAO}>
          <option value="">Prefiro não dizer</option>
          {
            NIVEIS.map((nivel) => (
              <option
                value={nivel.valor}
                selected={valor("nivel", perfil?.nivel) === nivel.valor}
              >
                {nivel.rotulo} — {nivel.ajuda}
              </option>
            ))
          }
        </select>
      </div>

      <fieldset>
        <legend class={ROTULO_CAMPO}>Estilo que você joga</legend>
        <p class={AJUDA_CAMPO}>Pode marcar mais de um.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {
            ESTILOS.map((estilo) => (
              <label class={LINHA_CAIXA}>
                <input
                  type="checkbox"
                  name="estilos"
                  value={estilo.valor}
                  checked={estilosMarcados.includes(estilo.valor)}
                  class={CAIXA}
                />
                <span class="text-[15px] leading-snug text-texto">{estilo.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="instagram" class={ROTULO_CAMPO}>Instagram</label>
        <p class={AJUDA_CAMPO}>Opcional.</p>
        <input
          id="instagram"
          name="instagram"
          type="text"
          maxlength="60"
          placeholder="@seuperfil"
          value={valor("instagram", perfil?.redes?.instagram)}
          class={ENTRADA}
        />
      </div>

      <fieldset class="border-t border-borda pt-8">
        <legend class="rotulo">Permissões</legend>
        <p class={AJUDA_CAMPO}>
          Cada uma é separada e pode ser desmarcada quando você quiser.
        </p>
        <div class="mt-3 space-y-3">
          {
            CONSENTIMENTOS_OPCIONAIS.map((item) => (
              <label class={LINHA_CAIXA}>
                <input
                  type="checkbox"
                  name={item.tipo}
                  checked={marcadoOpcional(item.tipo)}
                  class={CAIXA}
                />
                <span class="text-[15px] leading-snug text-texto">{item.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <input type="hidden" name="voltar" value={voltarPara} />
      <button type="submit" class={BOTAO_PRIMARIO}>Salvar</button>
    </form>


    </div>
  </Gaveta>

    <section class="mt-12 border-t border-borda pt-7">
      <h2 class="text-[1.0625rem] font-semibold text-tinta">Seus dados</h2>
      <p class="mt-2 text-[0.9375rem] leading-relaxed text-texto-2">
        Para pedir a exclusão da sua conta e de todos os seus dados, escreva
        para{" "}
        <a href="mailto:contato@comunidadeairsoft.com.br" class="text-oliva-300 underline">
          contato@comunidadeairsoft.com.br
        </a>. O que fazemos com cada dado está na{" "}
        <a href="/privacidade" class="text-oliva-300 underline">Política de Privacidade</a>.
      </p>
    </section>
</Conta>
