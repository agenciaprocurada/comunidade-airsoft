      <div class="flex shrink-0 flex-col items-center gap-3 self-center sm:self-start">
        <div class="relative">
          {
            perfil?.foto_url ? (
              <img
                src={perfil.foto_url}
                alt=""
                width="176"
                height="176"
                referrerpolicy="no-referrer"
                class="octogono h-40 w-40 bg-oliva-050 object-cover sm:h-44 sm:w-44"
              />
            ) : (
              <span class="octogono flex h-40 w-40 items-center justify-center bg-oliva-050 font-display text-6xl font-bold text-hud sm:h-44 sm:w-44">
