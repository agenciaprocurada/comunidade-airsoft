---
import Conta from "../../layouts/Conta.astro";
import Painel from "../../components/conta/Painel.astro";
import GradeCards from "../../components/conta/GradeCards.astro";
import CardHud from "../../components/conta/CardHud.astro";
import ChipHud from "../../components/conta/ChipHud.astro";
import Gaveta from "../../components/conta/Gaveta.astro";
import Selo from "../../components/conta/Selo.astro";
import {
  AJUDA_CAMPO,
  BOTAO_HUD,
  BOTAO_PRIMARIO,
  BOTAO_SECUNDARIO,
  BOTAO_TEXTO,
  ENTRADA,
  ENTRADA_INVALIDA,
  ERRO_CAMPO,
  ROTULO_CAMPO,
} from "../../lib/estilos-form";
import {
  COLUNAS_EQUIPE,
  COLUNAS_VINCULO,
  DESCRICAO_MAXIMA,
  NOME_MAXIMO,
  SIGLA_MAXIMA,
  erroDoNome,
  etiqueta,
  formatarData,
  normalizarSigla,
  slugDaEquipe,
  termoDeBusca,
  type Equipe,
  type VinculoEquipe,
} from "../../lib/equipe";
import { NOME_UF } from "../../lib/uf";

export const prerender = false;

const { supabase, usuario, perfil } = Astro.locals;

/** Vínculo com a ficha da equipe junto — é sempre assim que a tela usa. */
type VinculoComEquipe = VinculoEquipe & { equipe: Equipe };

let erroDe: Record<string, string> = {};
let erroGeral = "";
let enviado: Record<string, string> = { nome: "", sigla: "", descricao: "" };
/** Equipe que já existe com o nome tentado — vira convite para pedir entrada. */
let jaExiste: Equipe | null = null;

if (Astro.request.method === "POST") {
  const dados = await Astro.request.formData();
  const acao = dados.get("acao")?.toString();
  const texto = (chave: string) => (dados.get(chave)?.toString() ?? "").trim();

  // --- Ações de uma linha: a RLS e os gatilhos é que decidem se pode.
  // O filtro por usuario_id aqui é cinto e suspensório.
  const mudarProprioVinculo = async (status: string, destino: string) => {
    const { error } = await supabase
      .from("equipe_membros")
      .update({ status })
      .eq("id", texto("id"))
      .eq("usuario_id", usuario!.id);
    if (error) console.error("Falha ao mudar vínculo:", error);
    return Astro.redirect(destino, 303);
  };

  if (acao === "aceitar") return await mudarProprioVinculo("ativo", "/conta/equipes?entrou=1");
  if (acao === "recusar") return await mudarProprioVinculo("recusado", "/conta/equipes");
  if (acao === "sair") return await mudarProprioVinculo("saiu", "/conta/equipes?saiu=1");

  if (acao === "principal") {
    // O gatilho `equipe_membros_principal` desmarca a anterior sozinho.
    const { error } = await supabase
      .from("equipe_membros")
      .update({ principal: true })
      .eq("id", texto("id"))
      .eq("usuario_id", usuario!.id);
    if (error) console.error("Falha ao marcar equipe principal:", error);
    return Astro.redirect("/conta/equipes", 303);
  }

  if (acao === "pedir") {
    const equipeId = texto("equipe_id");

    const { error } = await supabase
      .from("equipe_membros")
      .insert({ equipe_id: equipeId, usuario_id: usuario!.id });

    // Já houve vínculo antes (saiu, recusado, removido): a linha é
    // única por (equipe, usuário), então reabrir é o único caminho.
    if (error?.code === "23505") {
      const { error: erroReabrir } = await supabase
        .from("equipe_membros")
        .update({ status: "pendente" })
        .eq("equipe_id", equipeId)
        .eq("usuario_id", usuario!.id);
      if (erroReabrir) console.error("Falha ao reabrir pedido:", erroReabrir);
    } else if (error) {
      console.error("Falha ao pedir entrada:", error);
    }

    return Astro.redirect("/conta/equipes?pedido=1", 303);
  }

  if (acao === "criar") {
    enviado = {
      nome: texto("nome"),
      sigla: texto("sigla"),
      descricao: texto("descricao"),
    };

    const problema = erroDoNome(enviado.nome);
    if (problema) erroDe.nome = problema;
    if (enviado.sigla.length > SIGLA_MAXIMA) {
      erroDe.sigla = `No máximo ${SIGLA_MAXIMA} caracteres.`;
    }
    if (enviado.descricao.length > DESCRICAO_MAXIMA) {
      erroDe.descricao = `No máximo ${DESCRICAO_MAXIMA} caracteres.`;
    }

    if (Object.keys(erroDe).length === 0) {
      const slug = slugDaEquipe(enviado.nome);

      const { data: criada, error } = await supabase
        .from("equipes")
        .insert({
          nome: enviado.nome,
          sigla: normalizarSigla(enviado.sigla),
          slug,
          // A equipe nasce na região de quem criou. É o palpite certo
          // em quase todos os casos, e o líder corrige no painel.
          uf: perfil?.uf ?? null,
          cidade: perfil?.cidade ?? null,
          cidade_slug: perfil?.cidade_slug ?? null,
          descricao: enviado.descricao || null,
          criada_por: usuario!.id,
        })
        .select("slug")
        .single();

      if (!error && criada) return Astro.redirect(`/conta/equipes/${criada.slug}?criada=1`, 303);

      if (error?.code === "23505") {
        // Duplicata é o erro esperado aqui ("R.I.S.E" x "RISE"). Em vez
        // de só recusar, mostra a equipe que já existe: quase sempre é
        // essa mesma que a pessoa queria.
        const { data } = await supabase
          .from("equipes")
          .select(COLUNAS_EQUIPE)
          .or(`slug.eq.${slug},nome.ilike.${termoDeBusca(enviado.nome)}`)
          .limit(1)
          .maybeSingle<Equipe>();
        jaExiste = data ?? null;
        erroDe.nome = "Já existe uma equipe com esse nome.";
      } else if (error) {
        console.error("Falha ao criar equipe:", error);
        erroGeral = "Não conseguimos criar agora. Tente de novo em instantes.";
      }
    }
  }
}

// ------------------------------------------------------------------
// Leitura
// ------------------------------------------------------------------

const { data: vinculos } = await supabase
  .from("equipe_membros")
  .select(`${COLUNAS_VINCULO}, equipe:equipes(${COLUNAS_EQUIPE})`)
  .eq("usuario_id", usuario!.id)
  .in("status", ["ativo", "pendente"])
  .order("criado_em", { ascending: true })
  .returns<VinculoComEquipe[]>();

const meus = (vinculos ?? []).filter((v) => v.equipe);

const ativos = meus.filter((v) => v.status === "ativo");
const convites = meus.filter((v) => v.status === "pendente" && v.origem === "convite");
const pedidos = meus.filter((v) => v.status === "pendente" && v.origem === "pedido");

// Quantos pedidos esperam decisão minha, por equipe que eu lidero.
// A tela mostra o que precisa de ação — sem isso o líder só descobre
// que alguém pediu se abrir o painel por acaso.
const equipesQueLidero = ativos.filter((v) => v.papel === "lider").map((v) => v.equipe_id);
let aguardando: Record<string, number> = {};

if (equipesQueLidero.length > 0) {
  const { data: fila } = await supabase
    .from("equipe_membros")
    .select("equipe_id")
    .in("equipe_id", equipesQueLidero)
    .eq("status", "pendente")
    .eq("origem", "pedido")
    .returns<{ equipe_id: string }[]>();

  for (const linha of fila ?? []) {
    aguardando[linha.equipe_id] = (aguardando[linha.equipe_id] ?? 0) + 1;
  }
}

// Busca. Só a partir de 2 caracteres: com 1 letra volta a base inteira.
const busca = termoDeBusca(Astro.url.searchParams.get("q") ?? "");
let achadas: Equipe[] = [];

if (busca.length >= 2) {
  const { data } = await supabase
    .from("equipes")
    .select(COLUNAS_EQUIPE)
    .or(`nome.ilike.%${busca}%,sigla.ilike.%${busca}%`)
    .order("nome")
    .limit(12)
    .returns<Equipe[]>();
  achadas = data ?? [];
}

const jaVinculada = new Set(meus.map((v) => v.equipe_id));

const criouAgora = Astro.url.searchParams.get("pedido") === "1";
const entrou = Astro.url.searchParams.get("entrou") === "1";
const saiu = Astro.url.searchParams.get("saiu") === "1";

const abrirFormulario = Object.keys(erroDe).length > 0 || Boolean(erroGeral);

const local = (equipe: Equipe) =>
  equipe.cidade && equipe.uf
    ? `${equipe.cidade} · ${NOME_UF[equipe.uf] ?? equipe.uf}`
    : equipe.uf
      ? (NOME_UF[equipe.uf] ?? equipe.uf)
      : "Sem região informada";
---

<Conta
  titulo="Minhas equipes"
  descricao="Equipes de airsoft de que você participa."
  resumo="A equipe é quem aparece do lado do seu nome na lista da operação. Você pode estar em mais de uma — a principal é a que vai por padrão."
>
  {
    (criouAgora || entrou || saiu) && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">{saiu ? "Saiu" : entrou ? "Entrou" : "Enviado"}</Selo>
        {criouAgora && "Pedido enviado. O líder da equipe vai responder."}
        {entrou && "Pronto, você entrou na equipe."}
        {saiu && "Você saiu da equipe."}
      </p>
    )
  }

  {
    erroGeral && (
      <p class="mt-8 border border-alerta bg-alerta-bg px-4 py-3 text-[0.9375rem] text-alerta-texto">
        {erroGeral}
      </p>
    )
  }

  <!-- Precisa da sua resposta: primeiro, porque é o que trava alguém. -->
  {
    convites.length > 0 && (
      <div class="mt-10">
        <Painel titulo="Convites para você" contagem={convites.length}>
          <ul class="divide-y divide-borda">
            {convites.map((vinculo) => (
              <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-4">
                <div class="min-w-0">
                  <p class="text-[1rem] font-semibold leading-tight text-tinta">
                    {vinculo.equipe.nome}
                  </p>
                  <p class="mt-1.5 font-dado text-[0.75rem] uppercase tracking-[0.1em] text-texto-2">
                    {local(vinculo.equipe)}
                    <span aria-hidden="true" class="px-1.5 text-borda-forte">/</span>
                    convidado em {formatarData(vinculo.criado_em)}
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-3">
                  <form method="POST">
                    <input type="hidden" name="acao" value="aceitar" />
                    <input type="hidden" name="id" value={vinculo.id} />
                    <button type="submit" class={BOTAO_PRIMARIO}>Entrar</button>
                  </form>
                  <form method="POST">
                    <input type="hidden" name="acao" value="recusar" />
                    <input type="hidden" name="id" value={vinculo.id} />
                    <button type="submit" class={BOTAO_TEXTO}>Recusar</button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        </Painel>
      </div>
    )
  }

  <div class="mt-10">
    {
      ativos.length === 0 ? (
        <div class="moldura-tatica border border-borda bg-papel/60 px-5 py-8 sm:px-8">
          <p class="max-w-[54ch] text-[1.0625rem] leading-relaxed text-texto">
            Você ainda não está em nenhuma equipe.
          </p>
          <p class="mt-3 max-w-[58ch] text-[0.9375rem] leading-relaxed text-texto-2">
            Procure a sua abaixo e peça para entrar — quem lidera aprova. Se ela
            ainda não estiver aqui, você mesmo pode criar.
          </p>
        </div>
      ) : (
        <Painel titulo="Você joga por" contagem={ativos.length} semMoldura={true}>
          <GradeCards>
            {ativos.map((vinculo) => {
              const pendentes = aguardando[vinculo.equipe_id] ?? 0;
              return (
                <CardHud destaque={vinculo.principal}>
                  <div class="flex items-start justify-between gap-3">
                    <p class="font-dado text-[0.75rem] uppercase leading-tight tracking-[0.1em] text-texto-2">
                      {local(vinculo.equipe)}
                    </p>
                    <span class="flex flex-col items-end gap-1.5">
                      {vinculo.principal && <Selo tom="marca">Principal</Selo>}
                      {vinculo.papel === "lider" && <Selo tom="neutro">Líder</Selo>}
                    </span>
                  </div>

                  <p class="mt-4 text-[1.0625rem] font-semibold leading-snug text-tinta">
                    <a
                      href={`/conta/equipes/${vinculo.equipe.slug}`}
                      class="transition-colors duration-150 hover:text-hud focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-hud"
                    >
                      {vinculo.equipe.nome}
                    </a>
                  </p>

                  {vinculo.equipe.sigla && (
                    <p class="mt-2.5">
                      <ChipHud>{vinculo.equipe.sigla}</ChipHud>
                    </p>
                  )}

                  {pendentes > 0 && (
                    <p class="mt-3">
                      <a
                        href={`/conta/equipes/${vinculo.equipe.slug}`}
                        class="inline-flex items-center gap-2 text-[0.875rem] font-semibold text-latao transition-colors duration-150 hover:text-hud"
                      >
                        <Selo tom="atencao" ponto={true}>
                          {pendentes}
                        </Selo>
                        {pendentes === 1
                          ? "pedido esperando você"
                          : "pedidos esperando você"}
                      </a>
                    </p>
                  )}

                  <div class="mt-auto flex flex-wrap gap-2 border-t border-borda pt-4">
                    {!vinculo.principal && (
                      <form method="POST">
                        <input type="hidden" name="acao" value="principal" />
                        <input type="hidden" name="id" value={vinculo.id} />
                        <button type="submit" class={BOTAO_HUD}>
                          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                            <path d="m12 3 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 18.3 5.9 21.6l1.4-6.8L2.2 10.1l6.9-.8z" stroke-linejoin="miter" />
                          </svg>
                          Tornar principal
                        </button>
                      </form>
                    )}
                    <form method="POST">
                      <input type="hidden" name="acao" value="sair" />
                      <input type="hidden" name="id" value={vinculo.id} />
                      <button type="submit" class={`${BOTAO_HUD} hover:!border-alerta hover:!text-alerta-texto`}>
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                          <path d="M10 4H5v16h5M15 8l4 4-4 4M9 12h10" stroke-linecap="square" stroke-linejoin="miter" />
                        </svg>
                        Sair
                      </button>
                    </form>
                  </div>
                </CardHud>
              );
            })}
          </GradeCards>
        </Painel>
      )
    }
  </div>

  {
    pedidos.length > 0 && (
      <div class="mt-10">
        <Painel titulo="Pedidos enviados" contagem={pedidos.length}>
          <ul class="divide-y divide-borda">
            {pedidos.map((vinculo) => (
              <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4">
                <div class="min-w-0">
                  <p class="text-[1rem] font-semibold leading-tight text-tinta">
                    {vinculo.equipe.nome}
                  </p>
                  <p class="mt-1.5 font-dado text-[0.75rem] uppercase tracking-[0.1em] text-texto-2">
                    enviado em {formatarData(vinculo.criado_em)}
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-4">
                  <Selo tom="atencao" ponto>Aguardando o líder</Selo>
                  <form method="POST">
                    <input type="hidden" name="acao" value="sair" />
                    <input type="hidden" name="id" value={vinculo.id} />
                    <button type="submit" class={BOTAO_TEXTO}>Cancelar</button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        </Painel>
      </div>
    )
  }

  <!-- Procurar antes de criar: é assim que se evita a terceira "RISE". -->
  <div class="mt-12">
    <Painel
      titulo="Procurar equipe"
      descricao="Antes de criar, veja se a sua já está aqui."
      semMoldura
    >
      <form method="GET" class="flex flex-wrap items-end gap-3">
        <div class="min-w-[16rem] flex-1">
          <label for="q" class={ROTULO_CAMPO}>Nome ou sigla</label>
          <input
            type="search"
            id="q"
            name="q"
            value={busca}
            placeholder="R.I.S.E, Nomad, Lobos..."
            class={ENTRADA}
          />
        </div>
        <button type="submit" class={BOTAO_SECUNDARIO}>Procurar</button>
      </form>

      {
        busca.length >= 2 && (
          <div class="mt-5 border border-borda bg-papel/60">
            {achadas.length === 0 ? (
              <p class="px-4 py-5 text-[0.9375rem] leading-relaxed text-texto-2">
                Nenhuma equipe com esse nome. Crie a sua logo abaixo.
              </p>
            ) : (
              <ul class="divide-y divide-borda">
                {achadas.map((equipe) => (
                  <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3.5">
                    <div class="min-w-0">
                      <p class="flex flex-wrap items-center gap-2 text-[0.9375rem] font-semibold leading-tight text-tinta">
                        {equipe.nome}
                        {equipe.verificada && <Selo tom="ok">Verificada</Selo>}
                      </p>
                      <p class="mt-1 font-dado text-[0.75rem] uppercase tracking-[0.1em] text-texto-2">
                        {local(equipe)}
                      </p>
                    </div>
                    {jaVinculada.has(equipe.id) ? (
                      <Selo tom="neutro">Você já está aqui</Selo>
                    ) : (
                      <form method="POST" class="shrink-0">
                        <input type="hidden" name="acao" value="pedir" />
                        <input type="hidden" name="equipe_id" value={equipe.id} />
                        <button type="submit" class={BOTAO_SECUNDARIO}>
                          Pedir para entrar
                        </button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </Painel>
  </div>

  <div class="mt-10">
    <Gaveta
      titulo="Criar uma equipe"
      descricao="Você vira o líder e passa a aprovar quem pede para entrar. Dá para mudar o resto depois."
      aberta={abrirFormulario}
    >

      {
        jaExiste && (
          <div class="mt-4 border border-latao/60 bg-latao/10 px-4 py-3.5">
            <p class="text-[0.9375rem] leading-snug text-tinta">
              <strong class="font-semibold">{jaExiste.nome}</strong> já está
              cadastrada. É a sua?
            </p>
            <form method="POST" class="mt-3">
              <input type="hidden" name="acao" value="pedir" />
              <input type="hidden" name="equipe_id" value={jaExiste.id} />
              <button type="submit" class={BOTAO_SECUNDARIO}>Pedir para entrar</button>
            </form>
          </div>
        )
      }

      <form method="POST" class="mt-5 max-w-[34rem] space-y-5">
        <input type="hidden" name="acao" value="criar" />

        <div>
          <label for="nome" class={ROTULO_CAMPO}>Nome da equipe</label>
          <input
            type="text"
            id="nome"
            name="nome"
            required
            maxlength={NOME_MAXIMO}
            value={enviado.nome}
            aria-invalid={erroDe.nome ? "true" : undefined}
            aria-describedby={erroDe.nome ? "erro-nome" : undefined}
            class={erroDe.nome ? ENTRADA_INVALIDA : ENTRADA}
          />
          {erroDe.nome && (
            <p id="erro-nome" class={ERRO_CAMPO}>{erroDe.nome}</p>
          )}
        </div>

        <div>
          <label for="sigla" class={ROTULO_CAMPO}>
            Sigla <span class="font-normal text-texto-2">(opcional)</span>
          </label>
          <input
            type="text"
            id="sigla"
            name="sigla"
            maxlength={SIGLA_MAXIMA}
            value={enviado.sigla}
            placeholder="R.I.S.E"
            aria-invalid={erroDe.sigla ? "true" : undefined}
            class={erroDe.sigla ? ENTRADA_INVALIDA : ENTRADA}
          />
          <p class={AJUDA_CAMPO}>
            É o que aparece do lado do seu nome na lista da operação.
          </p>
          {erroDe.sigla && <p class={ERRO_CAMPO}>{erroDe.sigla}</p>}
        </div>

        <div>
          <label for="descricao" class={ROTULO_CAMPO}>
            Descrição <span class="font-normal text-texto-2">(opcional)</span>
          </label>
          <textarea
            id="descricao"
            name="descricao"
            rows="3"
            maxlength={DESCRICAO_MAXIMA}
            aria-invalid={erroDe.descricao ? "true" : undefined}
            class={erroDe.descricao ? ENTRADA_INVALIDA : ENTRADA}
            set:text={enviado.descricao}
          />
          {erroDe.descricao && <p class={ERRO_CAMPO}>{erroDe.descricao}</p>}
        </div>

        <button type="submit" class={BOTAO_PRIMARIO}>Criar equipe</button>
      </form>
    </Gaveta>
  </div>
</Conta>
