---
/**
 * As réplicas viraram parte da página Meu perfil, em /conta#replicas.
 *
 * Esta rota fica de pé só para não quebrar o que já aponta para ela —
 * link salvo, aba aberta, e-mail antigo. Preserva a query (avisos de
 * "adicionada"/"removida" continuam aparecendo no destino).
 */
export const prerender = false;

const destino = `/conta${Astro.url.search}#replicas`;
return Astro.redirect(destino, 302);
---
