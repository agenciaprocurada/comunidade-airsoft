---
import Conta from "../../layouts/Conta.astro";
import Painel from "../../components/conta/Painel.astro";
import Selo from "../../components/conta/Selo.astro";
import ArteReplica from "../../components/conta/ArteReplica.astro";
import GradeCards from "../../components/conta/GradeCards.astro";
import CardHud from "../../components/conta/CardHud.astro";
import ChipHud from "../../components/conta/ChipHud.astro";
import Gaveta from "../../components/conta/Gaveta.astro";
import {
  ACIONAMENTOS,
  CATEGORIAS,
  COLUNAS_ARMAMENTO,
  LIMITE_REPLICAS,
  MARCA_OUTRA,
  ehAcionamento,
  ehCategoria,
  nomeDaMarca,
  normalizarMarcaLivre,
  rotuloAcionamento,
  rotuloCategoria,
  type Armamento,
  type Marca,
} from "../../lib/armamento";
import {
  AJUDA_CAMPO,
  BOTAO_HUD,
  BOTAO_PRIMARIO,
  BOTAO_TEXTO,
  CAIXA,
  ENTRADA,
  ENTRADA_INVALIDA,
  ERRO_CAMPO,
  LINHA_CAIXA,
  ROTULO_CAMPO,
  SELECAO,
  SELECAO_INVALIDA,
} from "../../lib/estilos-form";

export const prerender = false;

const { supabase, usuario } = Astro.locals;

/** Erro por campo, e não uma lista solta no topo longe do que falhou. */
let erroDe: Record<string, string> = {};
let erroGeral = "";
let enviado: Record<string, string> = {};

if (Astro.request.method === "POST") {
  const dados = await Astro.request.formData();
  const acao = dados.get("acao")?.toString();
  const texto = (chave: string) => (dados.get(chave)?.toString() ?? "").trim();

  if (acao === "apagar") {
    // A RLS já garante que só dá para apagar a própria réplica; o
    // filtro por usuario_id é cinto e suspensório.
    const { error } = await supabase
      .from("armamentos")
      .delete()
      .eq("id", texto("id"))
      .eq("usuario_id", usuario!.id);
    if (error) console.error("Falha ao apagar réplica:", error);
    return Astro.redirect("/conta/armamentos?removida=1", 303);
  }

  if (acao === "principal") {
    // O gatilho `armamentos_principal` desmarca a anterior sozinho.
    const { error } = await supabase
      .from("armamentos")
      .update({ principal: true })
      .eq("id", texto("id"))
      .eq("usuario_id", usuario!.id);
    if (error) console.error("Falha ao marcar principal:", error);
    return Astro.redirect("/conta/armamentos", 303);
  }

  if (acao === "adicionar") {
    enviado = {
      marca: texto("marca"),
      marca_outra: texto("marca_outra"),
      modelo: texto("modelo"),
      acionamento: texto("acionamento"),
      categoria: texto("categoria"),
      observacoes: texto("observacoes"),
    };

    const usaOutra = enviado.marca === MARCA_OUTRA;
    const marcaLivre = normalizarMarcaLivre(enviado.marca_outra);

    if (!enviado.marca) erroDe.marca = "Escolha a marca.";
    if (usaOutra && (marcaLivre.length < 2 || marcaLivre.length > 60)) {
      erroDe.marca_outra = "Escreva a marca com 2 a 60 caracteres.";
    }
    if (!enviado.modelo) erroDe.modelo = "Informe o modelo.";
    else if (enviado.modelo.length > 80) erroDe.modelo = "No máximo 80 caracteres.";
    if (!ehAcionamento(enviado.acionamento)) {
      erroDe.acionamento = "Escolha o tipo de acionamento.";
    }
    if (!ehCategoria(enviado.categoria)) erroDe.categoria = "Escolha a categoria.";
    if (enviado.observacoes.length > 300) {
      erroDe.observacoes = "No máximo 300 caracteres.";
    }

    if (Object.keys(erroDe).length === 0) {
      const { error } = await supabase.from("armamentos").insert({
        usuario_id: usuario!.id,
        marca_id: usaOutra ? null : enviado.marca,
        marca_outra: usaOutra ? marcaLivre : null,
        modelo: enviado.modelo,
        acionamento: enviado.acionamento,
        categoria: enviado.categoria,
        principal: dados.get("principal") === "on",
        observacoes: enviado.observacoes || null,
      });

      if (error) {
        if (error.message.includes("limite de 30")) {
          erroGeral = `Você chegou ao limite de ${LIMITE_REPLICAS} réplicas.`;
        } else if (error.code === "23503") {
          erroDe.marca = "Essa marca saiu da lista. Escolha outra.";
        } else {
          console.error("Falha ao cadastrar réplica:", error);
          erroGeral = "Não conseguimos salvar agora. Tente de novo em instantes.";
        }
      } else {
        return Astro.redirect("/conta/armamentos?adicionada=1", 303);
      }
    }
  }
}

const [{ data: marcas }, { data: replicas }] = await Promise.all([
  supabase
    .from("marcas_replica")
    .select("id,nome,ordem")
    .order("ordem")
    .order("nome")
    .returns<Marca[]>(),
  supabase
    .from("armamentos")
    .select(COLUNAS_ARMAMENTO)
    .eq("usuario_id", usuario!.id)
    .order("principal", { ascending: false })
    .order("criado_em", { ascending: true })
    .returns<Armamento[]>(),
]);

const listaMarcas = marcas ?? [];
const lista = replicas ?? [];
const comuns = listaMarcas.filter((m) => m.ordem <= 1);
const demais = listaMarcas.filter((m) => m.ordem > 1);
const noLimite = lista.length >= LIMITE_REPLICAS;

const adicionada = Astro.url.searchParams.get("adicionada") === "1";
const removida = Astro.url.searchParams.get("removida") === "1";
const houveErro = Object.keys(erroDe).length > 0 || erroGeral !== "";

/**
 * Lista vazia ou formulário com erro: a gaveta abre sozinha, porque é
 * onde a pessoa precisa estar. Com réplicas cadastradas e nada errado,
 * ela fica fechada — formulário permanentemente aberto vira ruído
 * depois da terceira réplica.
 */
const gavetaAberta = lista.length === 0 || houveErro;

const valor = (chave: string) => enviado[chave] ?? "";
const usouOutra = valor("marca") === MARCA_OUTRA;
---

<Conta
  titulo="Minhas réplicas"
  descricao="Suas réplicas de airsoft cadastradas."
  resumo="O que você usa em campo. Serve para você receber recomendação que faça sentido — quem joga com AEG não precisa de oferta de gás verde. A lista é sua e não aparece para ninguém."
>
  {
    (adicionada || removida) && (
      <p class="entrada-suave mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border border-ok bg-ok-bg px-4 py-3 text-[0.9375rem] text-ok-texto">
        <Selo tom="ok">Pronto</Selo>
        {adicionada ? "Réplica cadastrada." : "Réplica removida."}
      </p>
    )
  }

  <div class="mt-10 space-y-10">
    <Painel
      titulo="Cadastradas"
      contagem={lista.length > 0 ? `${lista.length}/${LIMITE_REPLICAS}` : undefined}
      semMoldura={true}
    >
      {
        lista.length === 0 ? (
          /* Estado vazio que ensina: diz o que a lista destrava, não
             apenas que está vazia. */
          <div class="moldura-tatica border border-borda bg-papel/60 px-5 py-8 sm:px-8">
            <p class="max-w-[54ch] text-[1.0625rem] leading-relaxed text-texto">
              Nenhuma réplica cadastrada ainda.
            </p>
            <ul class="mt-5 max-w-[58ch] space-y-2.5 text-[0.9375rem] leading-snug text-texto-2">
              <li class="flex gap-3">
                <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-oliva-500" aria-hidden="true" />
                O acionamento define seu consumível — bateria, gás ou ar.
              </li>
              <li class="flex gap-3">
                <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-oliva-500" aria-hidden="true" />
                A categoria diz o tipo de jogo em que você entra.
              </li>
              <li class="flex gap-3">
                <span class="mt-[0.55em] h-1 w-3 shrink-0 bg-oliva-500" aria-hidden="true" />
                Marcar a principal ajuda a saber o que é o seu dia a dia.
              </li>
            </ul>
            <p class="mt-6 text-[0.9375rem] text-texto-2">
              O formulário abaixo já está aberto. Leva menos de um minuto.
            </p>
          </div>
        ) : (
          /*
            Grade de cards no vocabulário de HUD do mockup: cantos em
            esquadro, anéis de alvo e o blueprint da réplica como
            protagonista.

            `auto-fit` + `minmax` resolve a responsividade sem nenhum
            ponto de quebra — o espaço disponível decide o número de
            colunas.
          */
          <GradeCards>
            {lista.map((replica) => {
              const marca = nomeDaMarca(replica, listaMarcas);
              return (
                <CardHud destaque={replica.principal}>
                  {/* Palco do desenho. Preto porque o PNG do blueprint
                      é preto: assim a arte encosta no fundo sem deixar
                      retângulo aparente. */}
                  <div class="relative flex h-[9.5rem] items-center justify-center px-6">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      class="absolute left-0 top-0 h-4 w-4 text-hud/45"
                    >
                      <path d="M12 3v6M12 15v6M3 12h6M15 12h6" stroke-linecap="square" />
                      <circle cx="12" cy="12" r="3.5" />
                    </svg>

                    {replica.principal && (
                      <span class="absolute right-0 top-0 z-10 inline-flex items-center gap-1.5 border border-hud/60 bg-hud/10 px-2 py-1 font-dado text-[0.6875rem] uppercase leading-none tracking-[0.1em] text-hud">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-3 w-3">
                          <path d="m12 2 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z" />
                        </svg>
                        Principal
                      </span>
                    )}

                    <ArteReplica categoria={replica.categoria} class="max-h-[8.5rem] max-w-[15rem]" />
                  </div>

                  <p class="mt-4 text-[1.0625rem] font-semibold leading-snug text-tinta">
                    {marca.nome} {replica.modelo}
                  </p>

                  <p class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                    <ChipHud>{rotuloAcionamento(replica.acionamento)}</ChipHud>
                    <span class="font-dado text-[0.75rem] uppercase tracking-[0.1em] text-texto-2">
                      <span aria-hidden="true" class="pr-1.5 text-borda-forte">/</span>
                      {rotuloCategoria(replica.categoria)}
                    </span>
                    {marca.pendente && <Selo tom="atencao">Marca a conferir</Selo>}
                  </p>

                  {replica.observacoes && (
                    <p class="mt-3 text-[0.9375rem] leading-snug text-texto-2">
                      {replica.observacoes}
                    </p>
                  )}

                  {/* `mt-auto` cola as ações no pé: com cards de alturas
                      diferentes, os botões ficam alinhados na fileira. */}
                  <div class="mt-auto flex flex-wrap gap-2 border-t border-borda pt-4">
                    {!replica.principal && (
                      <form method="POST">
                        <input type="hidden" name="acao" value="principal" />
                        <input type="hidden" name="id" value={replica.id} />
                        <button type="submit" class={BOTAO_HUD}>
                          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                            <path d="m12 3 2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 18.3 5.9 21.6l1.4-6.8L2.2 10.1l6.9-.8z" stroke-linejoin="miter" />
                          </svg>
                          Tornar principal
                        </button>
                      </form>
                    )}
                    <form method="POST">
                      <input type="hidden" name="acao" value="apagar" />
                      <input type="hidden" name="id" value={replica.id} />
                      <button
                        type="submit"
                        class={`${BOTAO_HUD} hover:!border-alerta hover:!text-alerta-texto`}
                        aria-label={`Remover ${marca.nome} ${replica.modelo}`}
                      >
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
                          <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" stroke-linecap="square" stroke-linejoin="miter" />
                        </svg>
                        Remover
                      </button>
                    </form>
                  </div>
                </CardHud>
              );
            })}
          </GradeCards>
        )
      }
    </Painel>

    {
      noLimite ? (
        <p class="border border-borda-forte bg-papel/60 px-4 py-3.5 text-[0.9375rem] text-texto-2">
          Você chegou ao limite de {LIMITE_REPLICAS} réplicas. Remova alguma para
          cadastrar outra.
        </p>
      ) : (
        <Gaveta
          titulo="Cadastrar réplica"
          descricao="Adicione uma nova réplica à sua coleção."
          aberta={gavetaAberta}
        >
          <form method="POST" class="space-y-0">
            <input type="hidden" name="acao" value="adicionar" />

            {erroGeral && (
              <p class="mb-6 border border-alerta bg-alerta-bg px-4 py-3 text-[0.9375rem] text-alerta-texto">
                {erroGeral}
              </p>
            )}

            <div class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
              <div>
                <label for="marca" class={ROTULO_CAMPO}>Marca</label>
                <select
                  id="marca"
                  name="marca"
                  required
                  aria-invalid={erroDe.marca ? "true" : undefined}
                  aria-describedby={erroDe.marca ? "erro-marca" : undefined}
                  class={erroDe.marca ? SELECAO_INVALIDA : SELECAO}
                >
                  <option value="">Escolha</option>
                  <optgroup label="Mais comuns no Brasil">
                    {comuns.map((m) => (
                      <option value={m.id} selected={valor("marca") === m.id}>
                        {m.nome}
                      </option>
                    ))}
                  </optgroup>
                  <optgroup label="Outras marcas">
                    {demais.map((m) => (
                      <option value={m.id} selected={valor("marca") === m.id}>
                        {m.nome}
                      </option>
                    ))}
                  </optgroup>
                  <option value={MARCA_OUTRA} selected={usouOutra}>
                    Não está na lista
                  </option>
                </select>
                {erroDe.marca && (
                  <p id="erro-marca" class={ERRO_CAMPO}>
                    {erroDe.marca}
                  </p>
                )}
              </div>

              <div>
                <label for="modelo" class={ROTULO_CAMPO}>Modelo</label>
                <input
                  id="modelo"
                  name="modelo"
                  type="text"
                  required
                  maxlength="80"
                  placeholder="CM16 Raider"
                  value={valor("modelo")}
                  aria-invalid={erroDe.modelo ? "true" : undefined}
                  aria-describedby={erroDe.modelo ? "erro-modelo" : undefined}
                  class={erroDe.modelo ? ENTRADA_INVALIDA : ENTRADA}
                />
                {erroDe.modelo && (
                  <p id="erro-modelo" class={ERRO_CAMPO}>
                    {erroDe.modelo}
                  </p>
                )}
              </div>

              {/* Só aparece quando a marca não está na lista — em vez de um
                  campo permanentemente vazio pedindo para ser ignorado. */}
              <div class="campo-marca-livre sm:col-span-2" hidden={!usouOutra}>
                <label for="marca_outra" class={ROTULO_CAMPO}>Qual é a marca?</label>
                <p class={AJUDA_CAMPO}>
                  A gente confere e adiciona à lista oficial.
                </p>
                <input
                  id="marca_outra"
                  name="marca_outra"
                  type="text"
                  maxlength="60"
                  value={valor("marca_outra")}
                  aria-invalid={erroDe.marca_outra ? "true" : undefined}
                  aria-describedby={erroDe.marca_outra ? "erro-marca-outra" : undefined}
                  class={erroDe.marca_outra ? ENTRADA_INVALIDA : ENTRADA}
                />
                {erroDe.marca_outra && (
                  <p id="erro-marca-outra" class={ERRO_CAMPO}>
                    {erroDe.marca_outra}
                  </p>
                )}
              </div>

              <div>
                <label for="acionamento" class={ROTULO_CAMPO}>Acionamento</label>
                <select
                  id="acionamento"
                  name="acionamento"
                  required
                  aria-invalid={erroDe.acionamento ? "true" : undefined}
                  aria-describedby={erroDe.acionamento ? "erro-acionamento" : undefined}
                  class={erroDe.acionamento ? SELECAO_INVALIDA : SELECAO}
                >
                  <option value="">Escolha</option>
                  {ACIONAMENTOS.map((a) => (
                    <option value={a.valor} selected={valor("acionamento") === a.valor}>
                      {a.rotulo} — {a.ajuda}
                    </option>
                  ))}
                </select>
                {erroDe.acionamento && (
                  <p id="erro-acionamento" class={ERRO_CAMPO}>
                    {erroDe.acionamento}
                  </p>
                )}
              </div>

              <div>
                <label for="categoria" class={ROTULO_CAMPO}>Categoria</label>
                <select
                  id="categoria"
                  name="categoria"
                  required
                  aria-invalid={erroDe.categoria ? "true" : undefined}
                  aria-describedby={erroDe.categoria ? "erro-categoria" : undefined}
                  class={erroDe.categoria ? SELECAO_INVALIDA : SELECAO}
                >
                  <option value="">Escolha</option>
                  {CATEGORIAS.map((c) => (
                    <option value={c.valor} selected={valor("categoria") === c.valor}>
                      {c.rotulo}
                    </option>
                  ))}
                </select>
                {erroDe.categoria && (
                  <p id="erro-categoria" class={ERRO_CAMPO}>
                    {erroDe.categoria}
                  </p>
                )}
              </div>

              <div class="sm:col-span-2">
                <label for="observacoes" class={ROTULO_CAMPO}>Observações</label>
                <p class={AJUDA_CAMPO}>Opcional. Upgrades, estado, o que quiser.</p>
                <input
                  id="observacoes"
                  name="observacoes"
                  type="text"
                  maxlength="300"
                  value={valor("observacoes")}
                  aria-invalid={erroDe.observacoes ? "true" : undefined}
                  aria-describedby={erroDe.observacoes ? "erro-observacoes" : undefined}
                  class={erroDe.observacoes ? ENTRADA_INVALIDA : ENTRADA}
                />
                {erroDe.observacoes && (
                  <p id="erro-observacoes" class={ERRO_CAMPO}>
                    {erroDe.observacoes}
                  </p>
                )}
              </div>

              <div class="sm:col-span-2">
                <label class={LINHA_CAIXA}>
                  <input type="checkbox" name="principal" class={CAIXA} />
                  <span class="text-[0.9375rem] leading-snug text-texto">
                    É a que eu mais uso em campo
                  </span>
                </label>
              </div>
            </div>

            <div class="mt-6">
              <button type="submit" class={BOTAO_PRIMARIO}>Cadastrar réplica</button>
            </div>
          </form>
        </Gaveta>
      )
    }
  </div>
</Conta>

<script>
  /**
   * O campo de marca livre só aparece quando "Não está na lista" é a
   * escolha. Progressive enhancement: sem JS o campo fica escondido,
   * mas o servidor devolve a página com ele aberto e o erro no lugar —
   * o cadastro nunca fica impossível.
   */
  const seletor = document.querySelector<HTMLSelectElement>("#marca");
  const campo = document.querySelector<HTMLElement>(".campo-marca-livre");
  const entrada = document.querySelector<HTMLInputElement>("#marca_outra");

  if (seletor && campo && entrada) {
    const sincronizar = () => {
      const livre = seletor.value === "__outra__";
      campo.hidden = !livre;
      entrada.required = livre;
      if (!livre) entrada.value = "";
    };
    seletor.addEventListener("change", sincronizar);
  }
</script>
