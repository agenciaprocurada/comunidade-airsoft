---
/**
 * Painel e perfil viraram uma página só, em /conta.
 *
 * Esta rota fica de pé só para não quebrar o que já aponta para ela —
 * link salvo, aba aberta, e o redirecionamento de /reivindicar quando
 * o perfil está incompleto. Preserva a query, que é o que carrega o
 * motivo e o destino de volta.
 */
export const prerender = false;

const destino = `/conta${Astro.url.search}`;
return Astro.redirect(destino, 302);
---
