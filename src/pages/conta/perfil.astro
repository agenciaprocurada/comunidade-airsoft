---
import Conta from "../../layouts/Conta.astro";
import Botao from "../../components/Botao.astro";
import { NOME_UF, slugificar } from "../../lib/uf";
import {
  CONSENTIMENTOS_OPCIONAIS,
  ESTILOS,
  NIVEIS,
  VERSAO_TERMOS,
  formatarWhatsapp,
  ipDaRequisicao,
  normalizarWhatsapp,
  type TipoConsentimento,
} from "../../lib/conta";
import {
  AJUDA_CAMPO,
  CAIXA,
  ENTRADA,
  ERRO_CAIXA,
  LINHA_CAIXA,
  ROTULO_CAMPO,
  SELECAO,
} from "../../lib/estilos-form";

export const prerender = false;

const { supabase, usuario, perfil } = Astro.locals;

const UFS = Object.entries(NOME_UF).sort(([a], [b]) => a.localeCompare(b));

let erros: string[] = [];
let salvo = false;
let enviado: Record<string, string> = {};
let estilosEnviados: string[] = [];
let opcionaisEnviados: Set<string> | null = null;

if (Astro.request.method === "POST" && usuario) {
  const dados = await Astro.request.formData();
  const texto = (chave: string) => (dados.get(chave)?.toString() ?? "").trim();
  const marcado = (chave: string) => dados.get(chave) === "on";

  enviado = {
    nome: texto("nome"),
    nickname: texto("nickname").toLowerCase(),
    whatsapp: texto("whatsapp"),
    uf: texto("uf").toUpperCase(),
    cidade: texto("cidade"),
    nivel: texto("nivel"),
    instagram: texto("instagram"),
  };
  estilosEnviados = dados
    .getAll("estilos")
    .map((valor) => valor.toString())
    .filter((valor) => ESTILOS.some((estilo) => estilo.valor === valor));

  const whatsapp = normalizarWhatsapp(enviado.whatsapp);

  if (enviado.nome.length < 2) erros.push("Informe seu nome.");
  if (!whatsapp) {
    erros.push("WhatsApp inválido. Use DDD + número, ex.: (51) 99999-8888.");
  }
  if (!NOME_UF[enviado.uf]) erros.push("Escolha o estado.");
  if (enviado.cidade.length < 2) erros.push("Informe sua cidade.");
  if (enviado.nickname && !/^[a-z0-9._-]{3,24}$/.test(enviado.nickname)) {
    erros.push(
      "Apelido: de 3 a 24 caracteres, só letras minúsculas, números, ponto, hífen ou underline.",
    );
  }
  if (enviado.nivel && !NIVEIS.some((nivel) => nivel.valor === enviado.nivel)) {
    erros.push("Nível inválido.");
  }

  if (erros.length === 0) {
    const { error } = await supabase
      .from("perfis")
      .update({
        nome: enviado.nome,
        nickname: enviado.nickname || null,
        whatsapp,
        uf: enviado.uf,
        cidade: enviado.cidade,
        cidade_slug: slugificar(enviado.cidade),
        nivel: enviado.nivel || null,
        estilos: estilosEnviados,
        redes: enviado.instagram ? { instagram: enviado.instagram } : {},
      })
      .eq("id", usuario.id);

    if (error) {
      // 23505 = violacao de unicidade; aqui so o apelido tem indice unico.
      if (error.code === "23505") {
        erros.push("Esse apelido já está em uso. Escolha outro.");
      } else {
        console.error("Falha ao salvar perfil:", error);
        erros.push("Não conseguimos salvar agora. Tente de novo em instantes.");
      }
    }
  }

  // Consentimento opcional que mudou vira registro NOVO — a tabela e
  // append-only de proposito, o historico e a prova.
  if (erros.length === 0) {
    opcionaisEnviados = new Set(
      CONSENTIMENTOS_OPCIONAIS.filter((item) => marcado(item.tipo)).map((i) => i.tipo),
    );

    const { data: atuais } = await supabase
      .from("consentimentos_atuais")
      .select("tipo,concedido")
      .eq("usuario_id", usuario.id);

    const estadoAtual = new Map(
      (atuais ?? []).map((linha) => [linha.tipo as string, linha.concedido as boolean]),
    );

    const mudancas = CONSENTIMENTOS_OPCIONAIS.filter(
      (item) => (estadoAtual.get(item.tipo) ?? false) !== opcionaisEnviados!.has(item.tipo),
    ).map((item) => ({
      usuario_id: usuario.id,
      tipo: item.tipo,
      concedido: opcionaisEnviados!.has(item.tipo),
      versao_texto: VERSAO_TERMOS,
      ip: ipDaRequisicao(() => Astro.clientAddress),
      user_agent: Astro.request.headers.get("user-agent"),
    }));

    if (mudancas.length > 0) {
      const { error } = await supabase.from("consentimentos").insert(mudancas);
      if (error) {
        console.error("Falha ao registrar consentimentos:", error);
        erros.push("Seus dados foram salvos, mas não conseguimos registrar as permissões.");
      }
    }

    if (erros.length === 0) return Astro.redirect("/conta/perfil?salvo=1", 303);
  }
}

salvo = Astro.url.searchParams.get("salvo") === "1";

// Estado dos opcionais para pintar as caixas no GET.
let opcionaisAtuais = new Set<string>();
if (Astro.request.method !== "POST" && usuario) {
  const { data } = await supabase
    .from("consentimentos_atuais")
    .select("tipo,concedido")
    .eq("usuario_id", usuario.id);
  for (const linha of data ?? []) {
    if (linha.concedido) opcionaisAtuais.add(linha.tipo as string);
  }
}

const houvePost = Astro.request.method === "POST";
const valor = (chave: string, padrao: string | null | undefined) =>
  houvePost ? (enviado[chave] ?? "") : (padrao ?? "");

const estilosMarcados = houvePost ? estilosEnviados : (perfil?.estilos ?? []);
const opcionaisMarcados = houvePost ? (opcionaisEnviados ?? new Set()) : opcionaisAtuais;
const marcadoOpcional = (tipo: TipoConsentimento) => opcionaisMarcados.has(tipo);
---

<Conta titulo="Meu perfil" descricao="Seus dados na Comunidade Airsoft.">
  <div class="mx-auto max-w-[64ch] px-5 py-14 md:px-12 md:py-20">
    <h1
      class="font-display text-4xl font-extrabold uppercase italic leading-[0.95] md:text-5xl"
    >
      Meu perfil
    </h1>
    <p class="mt-5 leading-relaxed text-texto-2">
      Nome, nível e estilo são o que falta para poder cadastrar ou reivindicar
      alguma coisa. WhatsApp e cidade nunca aparecem no site.
    </p>

    {
      salvo && (
        <p class="mt-8 border border-ok bg-ok-bg px-5 py-4 text-ok-texto">
          Dados salvos.
        </p>
      )
    }

    {
      erros.length > 0 && (
        <div class={`mt-8 ${ERRO_CAIXA}`}>
          <ul class="list-disc space-y-1 pl-5">
            {erros.map((erro) => (
              <li class="text-alerta-texto">{erro}</li>
            ))}
          </ul>
        </div>
      )
    }

    <form method="POST" class="mt-10 space-y-8">
      <div>
        <label for="nome" class={ROTULO_CAMPO}>Nome</label>
        <input
          id="nome"
          name="nome"
          type="text"
          required
          maxlength="80"
          autocomplete="name"
          value={valor("nome", perfil?.nome)}
          class={ENTRADA}
        />
      </div>

      <div>
        <label for="nickname" class={ROTULO_CAMPO}>Apelido no campo</label>
        <p class={AJUDA_CAMPO}>
          Opcional. Minúsculas, sem espaço. É o nome que vai aparecer quando os
          perfis públicos existirem.
        </p>
        <input
          id="nickname"
          name="nickname"
          type="text"
          maxlength="24"
          placeholder="ex.: corvo-51"
          value={valor("nickname", perfil?.nickname)}
          class={ENTRADA}
        />
      </div>

      <div>
        <label for="whatsapp" class={ROTULO_CAMPO}>WhatsApp</label>
        <p class={AJUDA_CAMPO}>
          {
            perfil?.whatsapp_verificado
              ? "Número confirmado. Se você trocar, a confirmação cai e terá que refazer."
              : "Ainda não confirmado. A confirmação por WhatsApp entra numa próxima entrega."
          }
        </p>
        <input
          id="whatsapp"
          name="whatsapp"
          type="tel"
          required
          inputmode="tel"
          autocomplete="tel-national"
          placeholder="(51) 99999-8888"
          value={valor("whatsapp", formatarWhatsapp(perfil?.whatsapp ?? null))}
          class={ENTRADA}
        />
      </div>

      <div class="grid gap-6 sm:grid-cols-[9rem_1fr]">
        <div>
          <label for="uf" class={ROTULO_CAMPO}>Estado</label>
          <select id="uf" name="uf" required class={SELECAO}>
            <option value="">UF</option>
            {
              UFS.map(([sigla, nome]) => (
                <option value={sigla} selected={valor("uf", perfil?.uf) === sigla}>
                  {sigla} — {nome}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="cidade" class={ROTULO_CAMPO}>Cidade</label>
          <input
            id="cidade"
            name="cidade"
            type="text"
            required
            maxlength="60"
            autocomplete="address-level2"
            value={valor("cidade", perfil?.cidade)}
            class={ENTRADA}
          />
        </div>
      </div>

      <div>
        <label for="nivel" class={ROTULO_CAMPO}>Seu nível</label>
        <select id="nivel" name="nivel" class={SELECAO}>
          <option value="">Prefiro não dizer</option>
          {
            NIVEIS.map((nivel) => (
              <option
                value={nivel.valor}
                selected={valor("nivel", perfil?.nivel) === nivel.valor}
              >
                {nivel.rotulo} — {nivel.ajuda}
              </option>
            ))
          }
        </select>
      </div>

      <fieldset>
        <legend class={ROTULO_CAMPO}>Estilo que você joga</legend>
        <p class={AJUDA_CAMPO}>Pode marcar mais de um.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {
            ESTILOS.map((estilo) => (
              <label class={LINHA_CAIXA}>
                <input
                  type="checkbox"
                  name="estilos"
                  value={estilo.valor}
                  checked={estilosMarcados.includes(estilo.valor)}
                  class={CAIXA}
                />
                <span class="text-[15px] leading-snug text-texto">{estilo.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="instagram" class={ROTULO_CAMPO}>Instagram</label>
        <p class={AJUDA_CAMPO}>Opcional.</p>
        <input
          id="instagram"
          name="instagram"
          type="text"
          maxlength="60"
          placeholder="@seuperfil"
          value={valor("instagram", perfil?.redes?.instagram)}
          class={ENTRADA}
        />
      </div>

      <fieldset class="border-t border-borda pt-8">
        <legend class="rotulo">Permissões</legend>
        <p class={AJUDA_CAMPO}>
          Cada uma é separada e pode ser desmarcada quando você quiser.
        </p>
        <div class="mt-3 space-y-3">
          {
            CONSENTIMENTOS_OPCIONAIS.map((item) => (
              <label class={LINHA_CAIXA}>
                <input
                  type="checkbox"
                  name={item.tipo}
                  checked={marcadoOpcional(item.tipo)}
                  class={CAIXA}
                />
                <span class="text-[15px] leading-snug text-texto">{item.rotulo}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <Botao tipo="submit">Salvar</Botao>
    </form>

    <section class="mt-14 border-t border-borda pt-8">
      <h2 class="rotulo">Seus dados</h2>
      <p class="mt-3 leading-relaxed text-texto-2">
        Para pedir a exclusão da sua conta e de todos os seus dados, escreva
        para
        <a href="mailto:contato@comunidadeairsoft.com.br" class="text-oliva-300 underline">
          contato@comunidadeairsoft.com.br
        </a>. O que fazemos com cada dado está na
        <a href="/privacidade" class="text-oliva-300 underline">Política de Privacidade</a>.
      </p>
    </section>
  </div>
</Conta>
