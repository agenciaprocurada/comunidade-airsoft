---
import Base from "../../layouts/Base.astro";
import TopoPagina from "../../components/TopoPagina.astro";
import Etiqueta from "../../components/Etiqueta.astro";
import Botao from "../../components/Botao.astro";
import {
  COLUNAS_OPERACAO,
  ESTILOS_OPERACAO,
  dataPorExtenso,
  hora,
  loteVigente,
  type Operacao,
} from "../../lib/operacao";
import { NOME_UF, slugificar } from "../../lib/uf";

export const prerender = false;

const { supabase } = Astro.locals;

type OperacaoNaAgenda = Operacao & {
  campo: { id: string; nome: string; cidade: string; cidade_slug: string; uf: string } | null;
};

const parametros = Astro.url.searchParams;
const uf = (parametros.get("uf") ?? "").toUpperCase().slice(0, 2);
const cidade = slugificar(parametros.get("cidade") ?? "");
const estilo = (parametros.get("estilo") ?? "").toLowerCase();

// Hoje ainda conta: quem abre o site de manhã indo para o campo
// precisa achar a operação do próprio dia.
const hoje = new Date().toISOString().slice(0, 10);

/*
 * Os filtros vão para o banco, e não para um `.filter()` depois: com
 * o diretório crescendo, trazer o país inteiro para filtrar em memória
 * é o tipo de coisa que só dói quando já tem gente usando.
 *
 * A lista de estados e cidades disponíveis, essa sim, precisa do
 * conjunto todo — senão filtrar por RS apagaria os outros estados do
 * próprio filtro.
 */
let consulta = supabase
  .from("operacoes")
  .select(`${COLUNAS_OPERACAO}, campo:campos(id,nome,cidade,cidade_slug,uf)`)
  .eq("status", "publicada")
  .gte("data", hoje);

if (uf) consulta = consulta.eq("uf", uf);
if (cidade) consulta = consulta.eq("cidade_slug", cidade);
if (estilo) consulta = consulta.eq("estilo", estilo);

const [{ data: bruto }, { data: paraFiltro }] = await Promise.all([
  consulta.order("data").limit(120).returns<OperacaoNaAgenda[]>(),
  supabase
    .from("operacoes")
    .select("uf,cidade,cidade_slug,estilo")
    .eq("status", "publicada")
    .gte("data", hoje)
    .returns<{ uf: string | null; cidade: string | null; cidade_slug: string | null; estilo: string | null }[]>(),
]);

const operacoes = bruto ?? [];
const universo = paraFiltro ?? [];

/** Estados e cidades que realmente têm operação — o filtro não oferece vazio. */
const estados = [...new Set(universo.map((o) => o.uf).filter(Boolean))].sort() as string[];

const cidades = [
  ...new Map(
    universo
      .filter((o) => o.cidade_slug && (!uf || o.uf === uf))
      .map((o) => [o.cidade_slug!, o.cidade!]),
  ).entries(),
].sort((a, b) => a[1].localeCompare(b[1], "pt-BR"));

const estilosComJogo = new Set(universo.map((o) => o.estilo).filter(Boolean));

/**
 * Contagem por operação. A view só devolve linha de operação ABERTA —
 * na fechada o número fica escondido junto com a lista, que é o ponto.
 */
let confirmados: Record<string, number> = {};
if (operacoes.length > 0) {
  const { data: linhas } = await supabase
    .from("operacao_contagem")
    .select("operacao_id,confirmadas")
    .in("operacao_id", operacoes.map((o) => o.id))
    .returns<{ operacao_id: string; confirmadas: number }[]>();

  // Uma linha por LADO: somar dá o total da operação.
  for (const linha of linhas ?? []) {
    confirmados[linha.operacao_id] =
      (confirmados[linha.operacao_id] ?? 0) + Number(linha.confirmadas);
  }
}

/** Agrupado por data: é assim que se olha um fim de semana. */
const porData = new Map<string, OperacaoNaAgenda[]>();
for (const operacao of operacoes) {
  const lista = porData.get(operacao.data) ?? [];
  lista.push(operacao);
  porData.set(operacao.data, lista);
}

/** Monta o endereço mantendo os outros filtros. Trocar UF zera cidade. */
const comFiltro = (mudanca: Record<string, string | null>) => {
  const p = new URLSearchParams();
  const atual = { uf, cidade, estilo, ...mudanca };
  if (atual.uf) p.set("uf", atual.uf.toLowerCase());
  if (atual.cidade && !("uf" in mudanca)) p.set("cidade", atual.cidade);
  if (atual.estilo) p.set("estilo", atual.estilo);
  const query = p.toString();
  return query ? `/operacoes?${query}` : "/operacoes";
};

const nomeDoEstilo = (valor: string | null) =>
  ESTILOS_OPERACAO.find((e) => e.valor === valor)?.rotulo ?? null;

const nomeDaCidadeAtual = cidades.find(([slug]) => slug === cidade)?.[1];

const ondeEstou = [
  nomeDaCidadeAtual,
  !nomeDaCidadeAtual && uf ? (NOME_UF[uf] ?? uf) : null,
].filter(Boolean)[0];

const titulo = ondeEstou
  ? `Operações de airsoft em ${ondeEstou}`
  : "Agenda de operações de airsoft";
const descricao =
  (ondeEstou
    ? `As próximas operações de airsoft abertas em ${ondeEstou}. `
    : "As próximas operações de airsoft abertas no Brasil, por data e por região. ") +
  "Veja quem já está na lista e confirme a sua presença.";

const CLASSE_FILTRO =
  "border px-3 py-1.5 font-dado text-[0.75rem] uppercase tracking-[0.1em] transition-colors duration-150";
const ATIVO = "border-oliva-700 bg-oliva-050 text-oliva-300";
const INATIVO = "border-borda text-texto-2 hover:border-oliva-500 hover:text-oliva-300";
---

<Base titulo={titulo} descricao={descricao}>
  <TopoPagina
    trilha={[{ texto: "Operações" }]}
    dados={[
      {
        icone: "calendario",
        texto: `${operacoes.length} ${operacoes.length === 1 ? "operação aberta" : "operações abertas"}`,
      },
      { icone: "mapa", texto: `${estados.length} ${estados.length === 1 ? "estado" : "estados"}` },
      { icone: "pessoas", texto: "Lista de presença" },
      { icone: "cadeado", texto: "Consulta livre" },
    ]}
    codigo="04"
  >
    Operações
    <p slot="descricao">
      Os próximos jogos abertos. Sem precisar estar em oito grupos de WhatsApp
      para descobrir onde tem operação no sábado.
    </p>
  </TopoPagina>

  <div class="mx-auto max-w-[1240px] px-5 pb-8 pt-2 md:px-12 md:pb-12 md:pt-4">

    <div class="mt-6 space-y-3">
      {
        estados.length > 1 && (
          <nav aria-label="Filtrar por estado" class="flex flex-wrap items-center gap-2">
            <span class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Estado
            </span>
            <a href={comFiltro({ uf: null, cidade: null })} class:list={[CLASSE_FILTRO, !uf ? ATIVO : INATIVO]}>
              Todos
            </a>
            {estados.map((sigla) => (
              <a
                href={comFiltro({ uf: sigla, cidade: null })}
                aria-current={uf === sigla ? "page" : undefined}
                class:list={[CLASSE_FILTRO, uf === sigla ? ATIVO : INATIVO]}
              >
                {sigla}
              </a>
            ))}
          </nav>
        )
      }

      {
        cidades.length > 1 && (
          <nav aria-label="Filtrar por cidade" class="flex flex-wrap items-center gap-2">
            <span class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Cidade
            </span>
            <a href={comFiltro({ cidade: null })} class:list={[CLASSE_FILTRO, !cidade ? ATIVO : INATIVO]}>
              Todas
            </a>
            {cidades.map(([slug, nome]) => (
              <a
                href={comFiltro({ cidade: slug })}
                aria-current={cidade === slug ? "page" : undefined}
                class:list={[CLASSE_FILTRO, cidade === slug ? ATIVO : INATIVO]}
              >
                {nome}
              </a>
            ))}
          </nav>
        )
      }

      {
        estilosComJogo.size > 1 && (
          <nav aria-label="Filtrar por estilo" class="flex flex-wrap items-center gap-2">
            <span class="font-dado text-[0.6875rem] uppercase tracking-[0.14em] text-texto-2">
              Estilo
            </span>
            <a href={comFiltro({ estilo: null })} class:list={[CLASSE_FILTRO, !estilo ? ATIVO : INATIVO]}>
              Todos
            </a>
            {ESTILOS_OPERACAO.filter((e) => estilosComJogo.has(e.valor)).map((e) => (
              <a
                href={comFiltro({ estilo: e.valor })}
                aria-current={estilo === e.valor ? "page" : undefined}
                class:list={[CLASSE_FILTRO, estilo === e.valor ? ATIVO : INATIVO]}
              >
                {e.rotulo}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    {
      operacoes.length === 0 ? (
        <div class="mt-10 border border-borda bg-papel/60 px-5 py-10 sm:px-8">
          <p class="max-w-[54ch] text-[1.0625rem] leading-relaxed text-texto">
            {uf || cidade || estilo
              ? "Nenhuma operação aberta com esses filtros."
              : "Nenhuma operação aberta por enquanto."}
          </p>
          <p class="mt-3 max-w-[60ch] text-[0.9375rem] leading-relaxed text-texto-2">
            Organiza jogo? Abra a sua aqui: você manda o link no grupo uma vez e
            a lista se organiza sozinha — sem reenviar o texto a cada nome novo.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {(uf || cidade || estilo) && (
              <Botao href="/operacoes" variante="secundario">Ver todas</Botao>
            )}
            <Botao href="/conta/operacoes">Abrir uma operação</Botao>
          </div>
        </div>
      ) : (
        <div class="mt-10 space-y-10">
          {[...porData.entries()].map(([data, doDia]) => (
            <section>
              <h2 class="font-dado text-xs uppercase tracking-[0.18em] text-oliva-400">
                {dataPorExtenso(data)}
              </h2>

              <ul class="mt-4 grid gap-px border border-borda bg-borda">
                {doDia.map((operacao) => {
                  const lote = loteVigente(operacao);
                  const local = operacao.campo_nome ?? operacao.campo?.nome ?? operacao.local_avulso ?? "Local a definir";
                  const fechada = operacao.visibilidade === "fechada";

                  return (
                    <li class="bg-papel">
                      <a
                        href={`/operacoes/${operacao.slug}`}
                        class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 p-5 transition-colors duration-150 hover:bg-oliva-050"
                      >
                        <div class="min-w-0">
                          <p class="font-display text-xl font-bold uppercase leading-tight text-tinta">
                            {local}
                          </p>
                          <p class="mt-1.5 font-dado text-[0.75rem] uppercase tracking-[0.1em] text-texto-2">
                            {operacao.cidade ?? operacao.campo?.cidade ?? "—"}
                            {(operacao.uf ?? operacao.campo?.uf) && ` · ${operacao.uf ?? operacao.campo?.uf}`}
                            {operacao.inicio && (
                              <>
                                <span aria-hidden="true" class="px-1.5 text-borda-forte">/</span>
                                {hora(operacao.inicio)}
                              </>
                            )}
                          </p>
                        </div>

                        <div class="flex shrink-0 flex-wrap items-center gap-3">
                          {nomeDoEstilo(operacao.estilo) && (
                            <Etiqueta tom="info">{nomeDoEstilo(operacao.estilo)}</Etiqueta>
                          )}
                          {fechada ? (
                            <Etiqueta tom="alerta">Fechada</Etiqueta>
                          ) : (
                            <p class="font-dado text-[0.8125rem] text-texto-2">
                              <span class="text-[1.125rem] text-tinta">
                                {confirmados[operacao.id] ?? 0}
                              </span>{" "}
                              na lista
                            </p>
                          )}
                          {lote.valor !== null && <Etiqueta tom="neutro">{lote.rotulo}</Etiqueta>}
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </div>
</Base>
