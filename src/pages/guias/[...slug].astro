---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Trilha from "../../components/Trilha.astro";

export async function getStaticPaths() {
  const guias = await getCollection("guias", ({ data }) => !data.rascunho);
  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: { guia },
  }));
}

const { guia } = Astro.props;
const { Content } = await render(guia);
const d = guia.data;

const formatador = new Intl.DateTimeFormat("pt-BR", { dateStyle: "long" });

const artigo = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.titulo,
  description: d.resumo,
  datePublished: d.publicado_em.toISOString(),
  ...(d.atualizado_em ? { dateModified: d.atualizado_em.toISOString() } : {}),
  author: { "@type": "Organization", name: d.autor },
  publisher: { "@type": "Organization", name: "Comunidade Airsoft" },
  inLanguage: "pt-BR",
};

// FAQPage é o que rende trecho expandido no Google para dúvida de iniciante.
const faq =
  d.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: d.faq.map((item) => ({
          "@type": "Question",
          name: item.pergunta,
          acceptedAnswer: { "@type": "Answer", text: item.resposta },
        })),
      }
    : null;

const estruturados = faq ? [artigo, faq] : [artigo];
---

<Base
  titulo={d.titulo}
  descricao={d.resumo}
  dadosEstruturados={estruturados}
>
  <article class="mx-auto max-w-[1240px] px-5 py-8 md:px-12 md:py-12">
    <Trilha itens={[{ href: "/guias", texto: "Guias" }, { texto: d.titulo }]} />

    <header class="mx-auto mt-8 max-w-[68ch] border-b border-borda pb-8">
      <h1
        class="font-display text-4xl font-extrabold uppercase italic leading-[0.95] md:text-5xl"
      >
        {d.titulo}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-texto-2">{d.resumo}</p>
      <p class="mt-5 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400">
        Publicado em {formatador.format(d.publicado_em)}
        {d.atualizado_em && ` · Atualizado em ${formatador.format(d.atualizado_em)}`}
      </p>
    </header>

    <div class="conteudo mx-auto mt-8 max-w-[68ch]">
      <Content />
    </div>

    {
      d.faq.length > 0 && (
        <section class="mx-auto mt-12 max-w-[68ch] border-t border-borda pt-8">
          <h2 class="font-display text-2xl font-bold uppercase">
            Perguntas frequentes
          </h2>
          <dl class="mt-6 flex flex-col gap-6">
            {d.faq.map((item) => (
              <div>
                <dt class="font-display text-lg font-bold uppercase">
                  {item.pergunta}
                </dt>
                <dd class="mt-1 leading-relaxed text-texto-2">{item.resposta}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }
  </article>
</Base>

<style is:global>
  /* Tipografia de leitura longa — DS: mínimo de 15px, caixa alta só em título. */
  .conteudo h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    text-transform: uppercase;
    margin: 2.5rem 0 1rem;
  }
  .conteudo h3 {
    font-weight: 600;
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }
  .conteudo p {
    margin: 0 0 1.25rem;
    color: var(--color-texto);
  }
  .conteudo ul,
  .conteudo ol {
    margin: 0 0 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .conteudo ul {
    list-style: square;
  }
  .conteudo ol {
    list-style: decimal;
  }
  .conteudo a {
    color: var(--color-oliva-500);
    text-decoration: underline;
  }
  .conteudo strong {
    font-weight: 600;
  }
  .conteudo blockquote {
    border-left: 2px solid var(--color-oliva-300);
    padding-left: 1rem;
    margin: 0 0 1.25rem;
    color: var(--color-texto-2);
  }
</style>
