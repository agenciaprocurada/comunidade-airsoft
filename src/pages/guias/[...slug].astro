---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Trilha from "../../components/Trilha.astro";

export async function getStaticPaths() {
  const guias = await getCollection("guias", ({ data }) => !data.rascunho);

  // Os relacionados sao resolvidos aqui, no build: slug apontando para guia
  // inexistente some, em vez de virar link quebrado publicado.
  const porId = new Map(guias.map((g) => [g.id, g]));

  return guias.map((guia) => ({
    params: { slug: guia.id },
    props: {
      guia,
      relacionados: guia.data.relacionados
        .map((id) => porId.get(id))
        // O predicado de tipo e o que permite ler g.data logo abaixo:
        // um filter comum nao remove o undefined da assinatura.
        .filter((g): g is NonNullable<typeof g> => !!g && g.id !== guia.id)
        .map((g) => ({ id: g.id, titulo: g.data.titulo, resumo: g.data.resumo })),
    },
  }));
}

const { guia, relacionados } = Astro.props;
const { Content } = await render(guia);
const d = guia.data;

const formatador = new Intl.DateTimeFormat("pt-BR", { dateStyle: "long" });

const artigo = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.titulo,
  description: d.resumo,
  ...(d.imagem ? { image: new URL(d.imagem.src, Astro.site).href } : {}),
  datePublished: d.publicado_em.toISOString(),
  ...(d.atualizado_em ? { dateModified: d.atualizado_em.toISOString() } : {}),
  author: { "@type": "Organization", name: d.autor },
  publisher: { "@type": "Organization", name: "Comunidade Airsoft" },
  inLanguage: "pt-BR",
};

// FAQPage é o que rende trecho expandido no Google para dúvida de iniciante.
const faq =
  d.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: d.faq.map((item) => ({
          "@type": "Question",
          name: item.pergunta,
          acceptedAnswer: { "@type": "Answer", text: item.resposta },
        })),
      }
    : null;

// O BreadcrumbList e emitido pelo componente Trilha, nao aqui.
const estruturados = faq ? [artigo, faq] : [artigo];

const ROTULO_NIVEL = {
  iniciante: "Nível 1 · Iniciante",
  intermediario: "Nível 2 · Intermediário",
  avancado: "Nível 3 · Avançado",
};
const rotuloNivel = ROTULO_NIVEL[d.nivel];
---

<Base
  titulo={d.titulo}
  descricao={d.resumo}
  dadosEstruturados={estruturados}
>
  <article class="mx-auto max-w-[1240px] px-5 py-8 md:px-12 md:py-12">
    <Trilha itens={[{ href: "/guias", texto: "Guias" }, { texto: d.titulo }]} />

    <header class="mx-auto mt-8 max-w-[68ch] border-b border-borda pb-8">
      <h1
        class="font-display text-4xl font-extrabold uppercase italic leading-[0.95] md:text-5xl"
      >
        {d.titulo}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-texto-2">{d.resumo}</p>
      <p class="mt-5 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400">
        {rotuloNivel} · {d.categoria} · Publicado em {formatador.format(d.publicado_em)}
        {d.atualizado_em && ` · Atualizado em ${formatador.format(d.atualizado_em)}`}
      </p>
    </header>

    {
      d.imagem && (
        <figure class="mx-auto mt-8 max-w-[68ch]">
          <Image
            src={d.imagem}
            alt={d.imagem_alt ?? ""}
            widths={[420, 680, 1360]}
            sizes="(min-width: 768px) 68ch, 100vw"
            class="w-full border border-borda"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="conteudo mx-auto mt-8 max-w-[68ch]">
      <Content />
    </div>

    {
      d.faq.length > 0 && (
        <section class="mx-auto mt-12 max-w-[68ch] border-t border-borda pt-8">
          <h2 class="font-display text-2xl font-bold uppercase">
            Perguntas frequentes
          </h2>
          <dl class="mt-6 flex flex-col gap-6">
            {d.faq.map((item) => (
              <div>
                <dt class="font-display text-lg font-bold uppercase">
                  {item.pergunta}
                </dt>
                <dd class="mt-1 leading-relaxed text-texto-2">{item.resposta}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      relacionados.length > 0 && (
        <section class="mx-auto mt-12 max-w-[68ch] border-t border-borda pt-8">
          <h2 class="font-display text-2xl font-bold uppercase">
            Continue a leitura
          </h2>
          <ul class="mt-6 grid gap-4">
            {relacionados.map((outro) => (
              <li class="border border-borda bg-papel p-5 transition-colors hover:border-oliva-300">
                <h3 class="font-display text-lg font-bold uppercase leading-tight">
                  <a href={`/guias/${outro.id}`} class="hover:text-oliva-500">
                    {outro.titulo}
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-texto-2">
                  {outro.resumo}
                </p>
              </li>
            ))}
          </ul>
          <p class="mt-6 leading-relaxed text-texto-2">
            Ou volte para <a href="/guias" class="text-oliva-500 underline">todos os guias</a>,
            organizados por nível de conhecimento.
          </p>
        </section>
      )
    }
  </article>
</Base>

<style is:global>
  /* Tipografia de leitura longa — DS: mínimo de 15px, caixa alta só em título. */
  .conteudo h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    text-transform: uppercase;
    margin: 2.5rem 0 1rem;
  }
  .conteudo h3 {
    font-weight: 600;
    font-size: 1.25rem;
    margin: 2rem 0 0.75rem;
  }
  .conteudo p {
    margin: 0 0 1.25rem;
    color: var(--color-texto);
  }
  .conteudo ul,
  .conteudo ol {
    margin: 0 0 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .conteudo ul {
    list-style: square;
  }
  .conteudo ol {
    list-style: decimal;
  }
  .conteudo a {
    color: var(--color-oliva-500);
    text-decoration: underline;
  }
  .conteudo strong {
    font-weight: 600;
  }
  .conteudo blockquote {
    border-left: 2px solid var(--color-oliva-300);
    padding-left: 1rem;
    margin: 0 0 1.25rem;
    color: var(--color-texto-2);
  }
</style>
