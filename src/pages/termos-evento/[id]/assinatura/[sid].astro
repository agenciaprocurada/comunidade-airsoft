---
import Base from "../../../../layouts/Base.astro";
import { blocosDoTermo, dataBr, dataHoraBr, formatarCpf, formatarTelefone } from "../../../../lib/termo-evento";
import { dividirTermo, preencherTermo } from "../../../../lib/termo-variaveis";

export const prerender = false;

/**
 * Comprovante de UMA assinatura, pronto para imprimir ou salvar em PDF
 * (Ctrl+P). Folha clara de proposito: a assinatura e traco escuro sobre
 * fundo transparente e precisa ficar legivel no papel.
 */
const { supabase } = Astro.locals;
const { id, sid } = Astro.params;
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!id || !sid || !UUID.test(id) || !UUID.test(sid)) return Astro.rewrite("/404");

const { data: evento } = await supabase
  .from("termos_eventos")
  .select("nome, data_evento, horario, local_evento, organizador, texto, texto_hash")
  .eq("id", id)
  .maybeSingle();
const { data: a } = await supabase
  .from("termos_assinaturas")
  .select("nome, email, telefone, cpf, nascimento, equipe, assinatura, texto_hash, ip, user_agent, assinado_em")
  .eq("id", sid)
  .eq("evento_id", id)
  .maybeSingle();
if (!evento || !a) return Astro.rewrite("/404");

const dadosTermo = {
  nome: a.nome,
  cpf: a.cpf,
  nascimento: a.nascimento,
  telefone: a.telefone,
  email: a.email,
  equipe: a.equipe,
  assinadoEm: a.assinado_em,
};
const partes = dividirTermo(evento.texto as string);
const blocos = blocosDoTermo(preencherTermo(partes.tela, dadosTermo));
const blocosFecho = blocosDoTermo(preencherTermo(partes.depois, dadosTermo));
const confere = a.texto_hash === evento.texto_hash;
---

<Base
  titulo={`Assinatura — ${a.nome}`}
  descricao="Comprovante de assinatura de termo."
  semIndexar={true}
  semConviteWhatsApp={true}
>
  <div class="no-print mx-auto flex max-w-[48rem] items-center justify-between px-5 pt-8">
    <a href={`/termos-evento/${id}`} class="font-dado text-[11px] uppercase tracking-[0.18em] text-oliva-400">‹ Voltar</a>
    <button type="button" id="imprimir" class="border border-oliva-500 bg-oliva-500 px-5 py-2.5 font-display text-sm font-bold uppercase tracking-[0.06em] text-fundo">
      Imprimir / salvar PDF
    </button>
  </div>

  <article class="folha mx-auto my-6 max-w-[48rem] bg-white px-8 py-10 text-[#111] md:px-12">
    <p class="text-[11px] uppercase tracking-[0.18em] text-[#555]">Termo de consentimento assinado eletronicamente</p>
    <h1 class="mt-1 text-2xl font-bold leading-tight">{evento.nome}</h1>
    <p class="mt-1 text-sm text-[#333]">
      {[evento.data_evento && dataBr(evento.data_evento as string), evento.horario, evento.local_evento, evento.organizador].filter(Boolean).join(" · ")}
    </p>

    <div class="mt-6 text-sm leading-relaxed text-[#222]">
      {blocos.map((b) =>
        b.tipo === "titulo" ? (
          <h2 class="mt-4 text-base font-bold">{b.texto}</h2>
        ) : (
          <p class="mt-1 whitespace-pre-line">{b.texto}</p>
        ),
      )}
    </div>

    <section class="mt-8 border-t border-[#999] pt-5 text-sm">
      <h2 class="text-base font-bold">Assinante</h2>
      <dl class="mt-2 grid grid-cols-[8rem_1fr] gap-y-1">
        <dt class="text-[#555]">Nome</dt><dd>{a.nome}</dd>
        <dt class="text-[#555]">CPF</dt><dd>{formatarCpf(a.cpf as string)}</dd>
        <dt class="text-[#555]">Nascimento</dt><dd>{a.nascimento ? dataBr(a.nascimento as string) : "-"}</dd>
        <dt class="text-[#555]">Equipe</dt><dd>{a.equipe || "-"}</dd>
        <dt class="text-[#555]">E-mail</dt><dd>{a.email}</dd>
        <dt class="text-[#555]">Telefone</dt><dd>{formatarTelefone(a.telefone as string)}</dd>
        <dt class="text-[#555]">Assinado em</dt><dd>{dataHoraBr(a.assinado_em as string)} (Brasília)</dd>
      </dl>
      <div class="mt-4 inline-block border-b border-[#111] px-6">
        <img src={a.assinatura as string} alt={`Assinatura de ${a.nome}`} class="h-28 w-auto" />
      </div>
      <p class="mt-1 text-xs text-[#555]">{a.nome}</p>
    </section>

    {blocosFecho.length > 0 && (
      <div class="mt-6 text-sm leading-relaxed text-[#222]">
        {blocosFecho.map((b) =>
          b.tipo === "titulo" ? (
            <h2 class="mt-4 text-base font-bold">{b.texto}</h2>
          ) : (
            <p class="mt-1 whitespace-pre-line">{b.texto}</p>
          ),
        )}
      </div>
    )}

    <section class="mt-6 border-t border-[#ccc] pt-3 text-[11px] leading-snug text-[#555] break-all">
      <p>IP: {a.ip ?? "não registrado"}</p>
      <p>Navegador: {a.user_agent ?? "não registrado"}</p>
      <p>SHA-256 do texto aceito: {a.texto_hash}</p>
      <p>{confere ? "O texto do evento é idêntico ao texto aceito nesta assinatura." : "ATENÇÃO: o texto atual do evento difere do texto aceito nesta assinatura."}</p>
    </section>
  </article>
</Base>

<style is:global>
  @media print {
    header, footer, .no-print { display: none !important; }
    body { background: #fff !important; }
    .folha { margin: 0 !important; max-width: none !important; padding: 0 !important; }
  }
</style>

<script>
  document.getElementById("imprimir")?.addEventListener("click", () => window.print());
</script>
