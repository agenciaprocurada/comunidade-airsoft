---
import Etiqueta from "./Etiqueta.astro";
import { ROTULO_CATEGORIA_LOJA, ROTULO_TIPO_LOJA } from "../lib/uf";

interface Props {
  loja: {
    id: string;
    data: {
      nome: string;
      descricao: string;
      tipo: string;
      uf?: string;
      cidade?: string;
      categorias: string[];
      marcas: string[];
      cnpj?: string;
      entrega_nacional?: boolean;
      desconto_avista?: string;
      faz_manutencao: boolean;
      faz_customizacao: boolean;
      verificado: boolean;
    };
  };
}

const { loja } = Astro.props;
const d = loja.data;

/**
 * Loja online sem cidade não fica com o rodapé de localização vazio:
 * "Envia para todo o Brasil" é a informação equivalente para ela.
 */
const local = d.cidade && d.uf ? `${d.cidade} - ${d.uf}` : "Envia para todo o Brasil";
---

<!--
  O card inteiro e clicavel por "stretched link": o link do titulo estica um
  ::after por cima de todo o article. E a unica forma valida, porque <a> dentro
  de <a> nao existe em HTML, e de quebra deixa UM link por card no lugar dos
  tres que apontavam para a mesma ficha.
-->
<article
  class="moldura-tatica group relative isolate flex flex-col border border-borda bg-papel transition-colors focus-within:border-oliva-500 hover:border-oliva-500"
>
  <div class="flex items-start justify-between gap-3 p-5 pb-3">
    <h3 class="font-display text-xl font-bold uppercase leading-tight tracking-[0.02em]">
      <a
        href={`/lojas/${loja.id}`}
        class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-oliva-300"
      >
        {d.nome}
      </a>
    </h3>
    {d.verificado && <Etiqueta tom="ok" check>Verificado</Etiqueta>}
  </div>

  <p
    class="flex flex-wrap items-center gap-1.5 px-5 pb-4 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="h-3.5 w-3.5 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M3 9h18l-1.5-4.5A2 2 0 0 0 17.6 3H6.4a2 2 0 0 0-1.9 1.5Z" />
      <path d="M4 9v10a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V9" />
    </svg>
    {local}
    <span aria-hidden="true" class="text-borda-forte">·</span>
    {ROTULO_TIPO_LOJA[d.tipo] ?? d.tipo}
  </p>

  <p class="px-5 pb-5 leading-relaxed text-texto-2 line-clamp-3">
    {d.descricao}
  </p>

  <div class="mt-auto flex flex-wrap gap-2 border-t border-borda p-5">
    {
      d.categorias.slice(0, 3).map((c) => (
        <Etiqueta>{ROTULO_CATEGORIA_LOJA[c] ?? c}</Etiqueta>
      ))
    }
    {d.categorias.length > 3 && <Etiqueta>+{d.categorias.length - 3}</Etiqueta>}
    {(d.faz_manutencao || d.faz_customizacao) && <Etiqueta tom="info">Oficina</Etiqueta>}
    {d.desconto_avista && <Etiqueta tom="escassez">{d.desconto_avista}</Etiqueta>}
  </div>
</article>
