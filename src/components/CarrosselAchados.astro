---
/**
 * Carrossel dos últimos achados — a faixa de produtos nos guias e nas
 * fichas de campo, armeiro e equipe.
 *
 * Aparece três vezes por guia (início, meio e fim), sempre com os mesmos
 * produtos: os dados vêm do build (achados-build.ts), como na home.
 *
 * Visual de vitrine, como o carrossel de produtos do Mercado Livre: bloco
 * verde-claro (oliva-100, da paleta) com cards BRANCOS — de propósito um
 * corpo estranho na página escura, para o produto saltar. Embaixo, o
 * botão "Ver mais achadinhos" leva à vitrine.
 *
 * Rola na horizontal com scroll-snap, sem JavaScript. As setas são
 * enfeite para quem usa mouse — sem script elas nem aparecem; no
 * celular a pessoa arrasta com o dedo. Cada card leva direto ao link
 * de afiliado, pela oferta mais barata.
 *
 * Quantos cabem: depende da largura do CONTAINER, não da tela (container
 * query) — o mesmo componente vive numa coluna de 68ch nos guias, na
 * coluna da ficha de campo e na largura toda da ficha da equipe. Até
 * 384px: 2 e um pedaço; até 768px: 3 e um pedaço; acima: os 5. O
 * "pedaço" é o que avisa que dá para rolar.
 *
 * SORTEIO A CADA VISITA. `achados` é o LOTE do dia (até 20, ver
 * loteDoDia), não os 5 que aparecem. Todos entram no HTML; 5 sorteados
 * no servidor ficam visíveis e o resto vai com `hidden`. Um script
 * inline logo depois do trilho sorteia de novo no navegador — inline e
 * ali mesmo para rodar antes da primeira pintura, senão os cards
 * trocariam na frente da pessoa. Sem JavaScript, vale o sorteio do
 * servidor (que nas páginas estáticas é o do build).
 */
import {
  CARROSSEL_MOSTRA,
  EM_LOJA,
  embaralhar,
  formatarPreco,
  linkAfiliado,
  ordenarOfertas,
  type Achado,
} from "../lib/achados";

interface Props {
  achados: Achado[];
  /** Só para os ids serem únicos quando o carrossel repete na página. */
  posicao: string;
  /** Rótulo pequeno em cima dos cards. */
  titulo?: string;
}

const { achados, posicao, titulo = "Achados da comunidade" } = Astro.props;

const ofertaDestaque = (a: Achado) =>
  ordenarOfertas(a.achado_ofertas).reduce((m, o) =>
    o.preco != null && (m.preco == null || o.preco < m.preco) ? o : m,
  );

const idTitulo = `achados-${posicao}`;

/** Os que aparecem sem JavaScript. */
const visiveis = new Set(embaralhar(achados).slice(0, CARROSSEL_MOSTRA).map((a) => a.id));
---

{
  achados.length > 0 && (
    <aside
      class="carrossel-achados @container my-10 bg-oliva-100 px-4 py-5 text-[#1f2a19] sm:px-5"
      aria-labelledby={idTitulo}
    >
      <p id={idTitulo} class="font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-700">
        {titulo}
      </p>

      <div class="relative mt-3">
        <ul class="trilho flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1" data-trilho>
          {achados.map((a) => {
            const o = ofertaDestaque(a);
            const preco = formatarPreco(o.preco);
            const cheio = formatarPreco(o.preco_cheio);
            const desconto =
              o.preco != null && o.preco_cheio != null
                ? Math.round((1 - o.preco / o.preco_cheio) * 100)
                : 0;
            return (
              <li class="w-[42%] shrink-0 snap-start @sm:w-[30%] @3xl:w-[19%]" hidden={!visiveis.has(a.id)}>
                <a
                  {...linkAfiliado(o.url)}
                  class="group flex h-full flex-col bg-white !text-[#1f2a19] !no-underline shadow-[0_1px_2px_rgba(0,0,0,0.12)] transition-shadow hover:shadow-[0_6px_16px_rgba(0,0,0,0.18)]"
                >
                  <div class="relative aspect-square w-full overflow-hidden bg-white p-2">
                    <span
                      aria-hidden="true"
                      class="absolute inset-0 grid place-items-center p-3 text-center font-display text-[13px] font-bold uppercase leading-tight text-[#9aa58a]"
                    >
                      {a.nome}
                    </span>
                    {a.imagem_url && (
                      <img
                        src={a.imagem_url}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.remove()"
                        class="absolute inset-0 h-full w-full bg-white object-contain p-2 transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
                      />
                    )}
                  </div>
                  <div class="flex flex-1 flex-col border-t border-[#eef1e6] p-3">
                    <p class="line-clamp-2 text-[13px] leading-snug text-[#33402b] sm:text-[14px]">
                      {a.nome}
                    </p>
                    {cheio && <s class="mt-2 text-[11px] leading-none text-[#8a9480]">{cheio}</s>}
                    <p class="mt-1 flex flex-wrap items-baseline gap-x-2 leading-none">
                      <span class="text-[18px] font-semibold text-[#1f2a19]">{preco ?? "Ver preço"}</span>
                      {desconto > 0 && <span class="text-[12px] font-semibold text-[#3d7a2a]">{desconto}% OFF</span>}
                    </p>
                    <p class="mt-auto pt-2 text-[12px] text-[#6b7460]">{EM_LOJA[o.loja]}</p>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>

        {/*
          Sorteia os 5 desta visita. `is:inline` e repetido por carrossel
          de propósito: precisa rodar aqui, no meio do HTML, antes de o
          navegador pintar o bloco. A função é definida uma vez só.
        */}
        <script is:inline data-sorteio={CARROSSEL_MOSTRA}>
          (function () {
            var s = document.currentScript;
            var trilho = s.previousElementSibling;
            var n = Number(s.dataset.sorteio);
            var itens = Array.prototype.slice.call(trilho.children);
            for (var i = itens.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var t = itens[i]; itens[i] = itens[j]; itens[j] = t;
            }
            itens.forEach(function (li, k) {
              li.hidden = k >= n;
              // Reordena o DOM: os sorteados na frente, na ordem do sorteio.
              trilho.appendChild(li);
            });
          })();
        </script>

        {/* Setas: só com script, só em container de 384px+ (no celular é dedo). */}
        <button
          type="button"
          data-seta="-1"
          hidden
          aria-label="Produtos anteriores"
          class="absolute -left-2 top-[38%] hidden h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white text-[20px] text-[#1f2a19] shadow-[0_2px_6px_rgba(0,0,0,0.25)] hover:bg-[#f3f6ea] @sm:flex"
        >
          ‹
        </button>
        <button
          type="button"
          data-seta="1"
          hidden
          aria-label="Próximos produtos"
          class="absolute -right-2 top-[38%] hidden h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white text-[20px] text-[#1f2a19] shadow-[0_2px_6px_rgba(0,0,0,0.25)] hover:bg-[#f3f6ea] @sm:flex"
        >
          ›
        </button>
      </div>

      <div class="mt-4 @sm:text-center">
        <a
          href="/achados"
          class="flex w-full items-center justify-center gap-2 bg-[#27351e] px-4 py-3 font-display text-[15px] font-bold uppercase tracking-[0.06em] !text-[#eff3e6] !no-underline transition-colors hover:bg-[#3c512d] @sm:inline-flex @sm:w-auto @sm:px-8"
        >
          Ver mais achadinhos <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>
  )
}

<style>
  /*
   * Barra de rolagem some: o card cortado na borda já diz que rola.
   *
   * `width: 0; min-width: 100%`: um flex sem quebra "pede" a soma dos
   * cinco cards como largura mínima, e uma coluna de grade (as fichas
   * de campo e armeiro) obedece e estoura a tela no celular. Com a
   * largura intrínseca zerada o trilho ocupa a coluna que existir.
   */
  .trilho {
    width: 0;
    min-width: 100%;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .trilho::-webkit-scrollbar {
    display: none;
  }
  /* O `hidden` do HTML perde para o `@sm:flex` do Tailwind; aqui ele ganha. */
  .carrossel-achados button[hidden] {
    display: none;
  }
</style>

<script>
  /*
   * Setas do carrossel: rolam uma "tela" por clique e somem na ponta.
   * Roda para todos os carrosséis da página (são três por guia).
   */
  for (const caixa of document.querySelectorAll<HTMLElement>(".carrossel-achados")) {
    const trilho = caixa.querySelector<HTMLElement>("[data-trilho]");
    const setas = caixa.querySelectorAll<HTMLButtonElement>("[data-seta]");
    if (!trilho || setas.length === 0) continue;

    const atualizar = () => {
      const fim = trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 2;
      const rola = trilho.scrollWidth > trilho.clientWidth + 2;
      for (const seta of setas) {
        const sentido = Number(seta.dataset.seta);
        seta.hidden = !rola || (sentido < 0 ? trilho.scrollLeft <= 2 : fim);
      }
    };

    for (const seta of setas) {
      seta.addEventListener("click", () => {
        trilho.scrollBy({ left: Number(seta.dataset.seta) * trilho.clientWidth * 0.9, behavior: "smooth" });
      });
    }
    trilho.addEventListener("scroll", atualizar, { passive: true });
    window.addEventListener("resize", atualizar);
    atualizar();
  }
</script>
