---
/**
 * Mapa do local na ficha.
 *
 * Por que por endereco e nao por coordenada: a tabela `campos` nao tem lat/lng
 * — os 29 registros do levantamento trazem endereco completo (rua, numero,
 * bairro, cidade/UF e quase sempre CEP), e o Google resolve isso bem. Quando
 * as coordenadas existirem, este componente ja as prefere: e so passar `lat` e
 * `lng`, que sao mais precisas que qualquer texto.
 *
 * O embed usa `output=embed`, que dispensa chave de API. A contrapartida e que
 * ele nao aceita marcador customizado nem estilo — para uma ficha de diretorio,
 * mostrar o ponto certo e o que importa.
 *
 * O iframe so entra no DOM depois de um clique. Sao tres motivos:
 *   - performance: iframe de mapa e dos recursos mais pesados de uma pagina;
 *   - privacidade: o Google so recebe a visita de quem de fato quis o mapa;
 *   - sem JS o bloco continua util, virando link direto para o Maps.
 */
import { linkExterno } from "../lib/link-externo";

interface Props {
  nome: string;
  endereco?: string;
  bairro?: string;
  cidade: string;
  uf: string;
  lat?: number;
  lng?: number;
}

const { nome, endereco, bairro, cidade, uf, lat, lng } = Astro.props;

/** Coordenada e sempre mais confiavel que endereco escrito a mao. */
const consulta =
  lat != null && lng != null
    ? `${lat},${lng}`
    : [endereco, bairro, cidade, uf, "Brasil"].filter(Boolean).join(", ");

const alvo = encodeURIComponent(consulta);
const urlEmbed = `https://www.google.com/maps?q=${alvo}&output=embed`;
const urlMaps = `https://www.google.com/maps/search/?api=1&query=${alvo}`;
---

<div class="border-b border-borda p-5">
  <div class="rotulo mb-3">No mapa</div>

  <div
    data-mapa
    data-embed={urlEmbed}
    data-titulo={`Mapa de ${nome}`}
    class="grade-tatica relative aspect-[4/3] w-full overflow-hidden border border-borda bg-oliva-050"
  >
    <!--
      Cartaz que ocupa o lugar do mapa ate o clique. Sem JS ele permanece, e o
      link leva ao Maps numa aba nova — nada fica inacessivel.
    -->
    <div
      data-cartaz
      class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-8 w-8 text-oliva-400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
      >
        <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>

      <p class="font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400">
        {cidade} — {uf}
      </p>

      <button
        type="button"
        data-abrir-mapa
        hidden
        class="border border-borda-forte bg-papel px-5 py-2.5 font-display text-base font-bold uppercase tracking-[0.06em] text-oliva-500 transition-colors hover:border-oliva-500 hover:text-oliva-300"
      >
        Carregar mapa
      </button>

      <a
        data-link-maps
        class="font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-500 underline hover:text-oliva-300"
        {...linkExterno(urlMaps, "campo-mapa")}
      >
        Abrir no Google Maps
      </a>
    </div>
  </div>

  <p class="mt-3 text-sm leading-relaxed text-texto-2">
    Confirme o endereço com o campo antes de ir. A localização vem do
    levantamento e pode ter mudado.
  </p>
</div>

<script>
  // O botao so aparece onde ele funciona. Sem este script, o cartaz permanece
  // com o link para o Maps — que e o comportamento util sem JavaScript.
  for (const bloco of document.querySelectorAll<HTMLElement>("[data-mapa]")) {
    const botao = bloco.querySelector<HTMLButtonElement>("[data-abrir-mapa]");
    const cartaz = bloco.querySelector<HTMLElement>("[data-cartaz]");
    const embed = bloco.dataset.embed;
    if (!botao || !cartaz || !embed) continue;

    botao.hidden = false;

    botao.addEventListener(
      "click",
      () => {
        const iframe = document.createElement("iframe");
        iframe.src = embed;
        iframe.title = bloco.dataset.titulo ?? "Mapa do local";
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        iframe.className = "absolute inset-0 h-full w-full border-0";
        iframe.setAttribute("allowfullscreen", "");
        bloco.append(iframe);
        cartaz.remove();
      },
      { once: true },
    );
  }
</script>
