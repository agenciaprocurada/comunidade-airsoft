---
/**
 * Mapa do local na ficha.
 *
 * Por que por endereco e nao por coordenada: a tabela `campos` nao tem lat/lng
 * — os registros do levantamento trazem endereco completo (rua, numero, bairro,
 * cidade/UF e quase sempre CEP), e o Google resolve isso bem. Quando as
 * coordenadas existirem, este componente ja as prefere: e so passar `lat` e
 * `lng`, que sao mais precisas que qualquer texto.
 *
 * O embed usa `output=embed`, que dispensa chave de API. A contrapartida e que
 * ele NAO aceita estilo proprio: dar cor ao mapa pela via oficial exige a Maps
 * JavaScript API com chave paga. O que da para fazer sem chave e o filtro CSS
 * abaixo, que escurece o mapa e desloca o matiz para o verde do DS.
 *
 * O iframe carrega junto com a pagina, com `loading="lazy"` para nao disputar
 * banda com o conteudo principal — ele fica na coluna lateral, quase sempre
 * fora da primeira dobra.
 */
import { linkExterno } from "../lib/link-externo";

interface Props {
  nome: string;
  endereco?: string;
  bairro?: string;
  cidade: string;
  uf: string;
  lat?: number;
  lng?: number;
}

const { nome, endereco, bairro, cidade, uf, lat, lng } = Astro.props;

/** Coordenada e sempre mais confiavel que endereco escrito a mao. */
const consulta =
  lat != null && lng != null
    ? `${lat},${lng}`
    : [endereco, bairro, cidade, uf, "Brasil"].filter(Boolean).join(", ");

const alvo = encodeURIComponent(consulta);
const urlEmbed = `https://www.google.com/maps?q=${alvo}&output=embed`;
const urlMaps = `https://www.google.com/maps/search/?api=1&query=${alvo}`;
---

<div class="border-b border-borda p-5">
  <div class="rotulo mb-3">No mapa</div>

  <div class="mapa relative aspect-[4/3] w-full overflow-hidden border border-borda bg-papel-2">
    <iframe
      src={urlEmbed}
      title={`Mapa de ${nome}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      class="absolute inset-0 h-full w-full border-0"></iframe>
  </div>

  <div class="mt-3 flex items-baseline justify-between gap-3">
    <p class="text-sm leading-relaxed text-texto-2">
      Confirme o endereço com o campo antes de ir.
    </p>
    <a
      class="shrink-0 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-500 underline hover:text-oliva-300"
      {...linkExterno(urlMaps, "campo-mapa")}
    >
      Abrir no Maps
    </a>
  </div>
</div>

<style>
  /* ============================================================
     Tema escuro do mapa.

     O embed do Google nao aceita paleta propria, entao a cor vem de
     filtro sobre o iframe. A receita e sempre a mesma: `invert` vira o
     mapa claro em escuro e `hue-rotate(180deg)` desfaz a inversao de
     matiz que o invert causa — sem ele, o verde da vegetacao sairia
     roxo. Depois, sepia + hue-rotate(42deg) + saturate puxam o cinza
     resultante para o oliva do DS.

     Os numeros nao sao chute: seis variantes foram renderizadas lado a
     lado e comparadas. Inversao pura fica cinza-azulada, e vela de cor
     no modo `color` fica verde-limao ilegivel — esta foi a unica que
     pegou o oliva mantendo os rotulos das ruas legiveis.

     `invert(0.92)` em vez de 1 deixa um cinza fechado no lugar de um
     preto puro, o que mantem rua e rotulo legiveis sobre o fundo
     #0b0d09 da pagina.
     ============================================================ */
  .mapa iframe {
    filter: invert(0.92) hue-rotate(180deg) saturate(0.25) sepia(0.55)
      hue-rotate(42deg) saturate(2.2) brightness(0.82) contrast(1.1);
  }

  /* Vela de cor por cima, no matiz oliva do DS. `multiply` escurece sem
     lavar o mapa, e o ::after nao intercepta clique. */
  .mapa::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--color-oliva-500);
    mix-blend-mode: multiply;
    opacity: 0.15;
  }

  /* Quem pediu menos animacao/efeito costuma pedir tambem mais contraste:
     nesse caso o mapa fica no original, que e o mais legivel de todos. */
  @media (prefers-contrast: more) {
    .mapa iframe {
      filter: none;
    }
    .mapa::after {
      display: none;
    }
  }
</style>
