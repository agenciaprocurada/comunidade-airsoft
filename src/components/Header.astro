---
import Logo from "./Logo.astro";

interface Props {
  /**
   * Header flutuando por cima do hero (só a home). Sem fundo e sem
   * borda — o proprio escurecimento da arte do hero e que garante o
   * contraste do texto.
   */
  sobreposto?: boolean;
}

const { sobreposto = false } = Astro.props;

const links = [
  { href: "/campos", texto: "Campos" },
  // A URL continua /lojas (congelada no PLANO-DE-ACAO.md §3); só o rótulo
  // mudou — "Onde comprar" é como o jogador formula a pergunta.
  { href: "/lojas", texto: "Onde comprar" },
  { href: "/armeiros", texto: "Armeiros" },
  // /operacoes saiu do menu para dar lugar à calculadora; a agenda continua
  // acessível pelo rodapé e pela ficha dos campos.
  { href: "/criador-de-mapas", texto: "Criador de Mapas" },
  { href: "/calculadora-de-fps", texto: "Calculadora de FPS" },
  { href: "/guias", texto: "Guias" },
];

const atual = Astro.url.pathname;

/**
 * O link da conta é sempre o mesmo, logado ou não.
 *
 * O header aparece em páginas geradas no build, que não sabem quem
 * está acessando. Se o rótulo dependesse da sessão, ou o HTML viraria
 * dinâmico (adeus cache de CDN e Core Web Vitals) ou mostraria estado
 * errado. Quem não tem sessão cai em /conta e é mandado para /entrar
 * pelo middleware.
 */
const linkConta = { href: "/conta", texto: "Minha conta" };
---

<header
  class:list={[
    "z-30 w-full",
    sobreposto
      ? "absolute inset-x-0 top-0 bg-transparent"
      : "sticky top-0 border-b border-borda bg-fundo/92 backdrop-blur",
  ]}
>
  <div
    class="mx-auto flex max-w-[1240px] items-center justify-between gap-6 px-5 py-4 md:px-12 md:py-5 xl:gap-8"
  >
    <a href="/" class="shrink-0" aria-label="Comunidade Airsoft — página inicial">
      <Logo class="h-10 w-auto xl:h-14" />
    </a>

    {/*
      Barra horizontal só a partir de lg. Com seis links mais o logo e o
      botão da conta, 768px não comporta a linha — quebrava em duas.
    */}
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-5 xl:gap-8">
        {
          links.map((link) => {
            const ativo = atual === link.href || atual.startsWith(link.href + "/");
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={ativo ? "page" : undefined}
                  class:list={[
                    "block whitespace-nowrap border-b-2 pb-1 font-display text-base font-bold uppercase tracking-[0.06em] transition-colors xl:text-lg xl:tracking-[0.08em]",
                    ativo
                      ? "border-oliva-500 text-tinta"
                      : "border-transparent text-tinta/75 hover:border-oliva-500 hover:text-tinta",
                  ]}
                >
                  {link.texto}
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href={linkConta.href}
            aria-current={atual.startsWith("/conta") ? "page" : undefined}
            class="block whitespace-nowrap border border-borda-forte px-3 py-2 font-display text-[15px] font-bold uppercase tracking-[0.06em] text-oliva-300 xl:px-4 xl:text-base xl:tracking-[0.08em] transition-colors hover:border-oliva-500 hover:bg-oliva-050 hover:text-oliva-100"
          >
            {linkConta.texto}
          </a>
        </li>
      </ul>
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="cursor-pointer list-none border border-borda-forte bg-fundo/80 px-3 py-2 font-display text-base font-bold uppercase tracking-[0.08em] text-oliva-300"
      >
        Menu
      </summary>
      <nav
        aria-label="Principal"
        class="absolute right-0 z-40 mt-2 w-56 border border-borda-forte bg-papel"
      >
        <ul class="flex flex-col">
          {
            links.map((link) => (
              <li class="border-b border-borda last:border-b-0">
                <a
                  href={link.href}
                  class="block px-5 py-3 font-display text-lg font-bold uppercase tracking-[0.08em] text-tinta hover:bg-oliva-050 hover:text-oliva-300"
                >
                  {link.texto}
                </a>
              </li>
            ))
          }
          <li class="border-t border-borda-forte">
            <a
              href={linkConta.href}
              class="block px-5 py-3 font-display text-lg font-bold uppercase tracking-[0.08em] text-oliva-300 hover:bg-oliva-050 hover:text-oliva-100"
            >
              {linkConta.texto}
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
