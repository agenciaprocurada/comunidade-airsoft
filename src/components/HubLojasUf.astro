---
/**
 * Hub estadual de lojas — /lojas/[uf].
 *
 * Mesmo papel de SEO dos hubs de campo: captura "loja de airsoft em
 * [estado]". Vive em componente porque divide a rota /lojas/[slug]
 * com a ficha da loja.
 */
import Base from "../layouts/Base.astro";
import CardLoja from "./CardLoja.astro";
import Trilha from "./Trilha.astro";
import { NOME_UF } from "../lib/uf";

interface Props {
  sigla: string;
  lojas: any[];
}

const { sigla, lojas } = Astro.props;
const nomeUf = NOME_UF[sigla] ?? sigla;

const cidades = [...new Set(lojas.map((l) => l.data.cidade).filter(Boolean))].sort(
  (a, b) => a.localeCompare(b, "pt-BR"),
);

const presenciais = lojas.filter((l) => l.data.tipo !== "online").length;

const titulo = `Lojas de airsoft em ${nomeUf} (${sigla})`;
const descricao = `${lojas.length} ${
  lojas.length === 1 ? "loja de airsoft" : "lojas de airsoft"
} com sede em ${nomeUf}${
  cidades.length ? `: ${cidades.slice(0, 4).join(", ")}` : ""
}. Endereço, CNPJ, marcas trabalhadas e contato.`.slice(0, 160);
---

<Base titulo={titulo} descricao={descricao}>
  <div class="mx-auto max-w-[1240px] px-5 py-8 md:px-12 md:py-12">
    <Trilha itens={[{ href: "/lojas", texto: "Onde comprar" }, { texto: nomeUf }]} />

    <header class="mt-8 border-b border-borda pb-8">
      <h1
        class="font-display text-4xl font-extrabold uppercase italic leading-[0.95] md:text-6xl"
      >
        Lojas de airsoft<br />em {nomeUf}
      </h1>
      <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-texto-2">
        {descricao}
      </p>
      {
        presenciais > 0 && (
          <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-texto-2">
            {presenciais === 1
              ? "1 delas atende presencialmente."
              : `${presenciais} delas atendem presencialmente.`}
          </p>
        )
      }
    </header>

    <div class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {lojas.map((loja) => <CardLoja loja={loja} />)}
    </div>

    <p class="mt-10 border-t border-borda pt-6 text-base text-texto-2">
      Quase toda loja desta lista envia para o Brasil inteiro.
      <a href="/lojas" class="text-oliva-500 underline">Ver todas as lojas</a>.
    </p>
  </div>
</Base>
