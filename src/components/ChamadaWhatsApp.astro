---
/**
 * Convite flutuante para a comunidade oficial no WhatsApp.
 *
 * Desktop: cartão no canto inferior direito. Celular: barra fixa no
 * rodapé da tela. Renderizado pelo layout Base em toda página com a casca
 * do site — não aparece no editor de mapas (semCasca) nem em /conta, que
 * já convida na barra lateral.
 *
 * Regras de convivência, porque flutuante irrita fácil:
 *  - nasce escondido e só aparece depois de ~2 s, para não competir com o
 *    primeiro olhar na página;
 *  - o X fecha e a escolha fica em localStorage por 14 dias; clicar em
 *    "Entrar" some por 60 dias (quem entrou não precisa do convite);
 *  - sem JavaScript, nada aparece — é um lembrete, não conteúdo.
 *
 * O link é o mesmo de src/lib/entidade.ts (também no `sameAs` da
 * Organization). Mudou o grupo, muda lá.
 */
import { GRUPO_OFICIAL } from "../lib/entidade";

const ICONE =
  "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8zM8.9 7.3c-.2 0-.5 0-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.2 5 4.3 2.5 1 3 .8 3.5.7.5 0 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3l-2-1c-.3-.1-.5-.1-.7.1l-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.5z";
---

<aside
  data-chamada-whatsapp
  hidden
  aria-label="Convite para a comunidade no WhatsApp"
  class="chamada-wpp fixed inset-x-0 bottom-0 z-40 md:inset-x-auto md:bottom-6 md:right-6 md:w-[360px]"
>
  <div
    class="moldura-tatica relative flex items-center gap-3 border-t-4 border-oliva-300 bg-oliva-500 px-4 py-4 text-fundo shadow-[0_-10px_36px_rgba(0,0,0,0.65)] md:border md:border-borda-forte md:bg-papel/95 md:text-tinta md:flex-col md:items-stretch md:gap-4 md:p-5 md:shadow-[0_12px_40px_rgba(0,0,0,0.6)] md:backdrop-blur"
  >
    <button
      type="button"
      data-fechar
      aria-label="Fechar convite"
      class="absolute -top-4 right-3 inline-flex h-8 w-8 cursor-pointer items-center justify-center border border-oliva-300 bg-fundo text-tinta transition-colors hover:border-oliva-500 hover:text-oliva-300 md:-top-3 md:-right-3 md:h-7 md:w-7 md:border-borda-forte md:text-texto-2 md:hover:text-tinta"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    <div class="flex min-w-0 flex-1 items-center gap-3">
      <span
        data-icone
        class="inline-flex h-12 w-12 shrink-0 items-center justify-center border border-fundo/40 bg-fundo text-oliva-300 md:border-oliva-700 md:bg-fundo/70"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 md:h-6 md:w-6" fill="currentColor">
          <path d={ICONE}></path>
        </svg>
      </span>
      <div class="min-w-0">
        <p class="rotulo m-0 hidden md:block">Comunidade oficial</p>
        <p class="m-0 font-display text-base font-extrabold uppercase leading-[1.05] tracking-[0.03em] text-fundo md:mt-1 md:text-xl md:font-bold md:text-tinta">
          <span class="md:hidden">Grupo oficial no WhatsApp</span>
          <span class="hidden md:inline">Grupo da Comunidade Airsoft no WhatsApp</span>
        </p>
        <p class="m-0 mt-1 truncate text-[12px] font-semibold leading-tight text-fundo/85 md:hidden">
          Dúvidas, jogos e operações
        </p>
        <p class="m-0 hidden text-sm leading-relaxed text-texto-2 md:mt-1.5 md:block">
          Tire dúvida, ache jogo perto de você e saiba das operações antes de
          todo mundo. Grátis.
        </p>
      </div>
    </div>

    <a
      href={GRUPO_OFICIAL}
      target="_blank"
      rel="noopener"
      data-entrar
      class="chanfro inline-flex shrink-0 items-center justify-center gap-2 border border-fundo bg-fundo px-4 py-3 font-display text-base font-bold uppercase tracking-[0.06em] text-oliva-100 transition-colors hover:text-tinta md:border-oliva-500 md:bg-oliva-500 md:px-[22px] md:py-[12px] md:text-fundo md:hover:border-oliva-400 md:hover:bg-oliva-400"
    >
      Entrar
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-[1.1em] w-[1.1em]" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M7 17 17 7M9 7h8v8" stroke-linecap="square"></path>
      </svg>
      <span class="sr-only">no grupo (abre em nova aba)</span>
    </a>
  </div>
</aside>

<style>
  /* Entra deslizando de baixo. Nasce no lugar final: a animação só
     suaviza, e com reduced-motion nem roda. */
  .chamada-wpp:not([hidden]) {
    animation: chamada-wpp-entrada 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes chamada-wpp-entrada {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  /* No celular a entrada é de chamar atenção mesmo: a barra sobe de fora
     da tela com um leve "quique", o ícone do WhatsApp balança como um
     telefone tocando e o botão Entrar pulsa duas vezes. Tudo acaba em
     menos de 3 s e não se repete — depois disso a barra fica quieta. */
  @media (max-width: 767px) {
    .chamada-wpp:not([hidden]) {
      animation: chamada-wpp-sobe 620ms cubic-bezier(0.34, 1.4, 0.64, 1) both;
    }
    @keyframes chamada-wpp-sobe {
      from {
        transform: translateY(110%);
      }
    }

    .chamada-wpp:not([hidden]) [data-icone] {
      animation: chamada-wpp-toca 800ms ease-in-out 650ms 1 both;
      transform-origin: 50% 80%;
    }
    @keyframes chamada-wpp-toca {
      15%,
      55% {
        transform: rotate(-14deg);
      }
      35%,
      75% {
        transform: rotate(14deg);
      }
      100% {
        transform: rotate(0);
      }
    }

    .chamada-wpp:not([hidden]) [data-entrar] {
      animation: chamada-wpp-pulso 900ms ease-in-out 900ms 2;
    }
    @keyframes chamada-wpp-pulso {
      50% {
        transform: scale(1.07);
        box-shadow: 0 0 0 6px rgba(11, 13, 9, 0.28);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chamada-wpp:not([hidden]),
    .chamada-wpp:not([hidden]) [data-icone],
    .chamada-wpp:not([hidden]) [data-entrar] {
      animation: none;
    }
  }
</style>

<script>
  const CHAVE = "chamada-whatsapp-ate";
  const DIA = 24 * 60 * 60 * 1000;
  const ATRASO_MS = 2000;

  const caixa = document.querySelector<HTMLElement>("[data-chamada-whatsapp]");

  if (caixa) {
    const lerAte = (): number => {
      try {
        return Number(localStorage.getItem(CHAVE) ?? 0);
      } catch {
        return 0;
      }
    };

    const silenciar = (dias: number) => {
      try {
        localStorage.setItem(CHAVE, String(Date.now() + dias * DIA));
      } catch {
        /* sem armazenamento (modo privado): só fecha nesta página */
      }
    };

    const fechar = (dias: number) => {
      silenciar(dias);
      caixa.hidden = true;
      document.body.style.removeProperty("--chamada-wpp-altura");
      document.body.classList.remove("com-chamada-wpp");
    };

    if (lerAte() < Date.now()) {
      setTimeout(() => {
        caixa.hidden = false;
        /* No celular a barra cobre o pé da página: o body ganha um
           respiro do tamanho dela para o rodapé continuar alcançável. */
        document.body.classList.add("com-chamada-wpp");
        document.body.style.setProperty(
          "--chamada-wpp-altura",
          `${caixa.getBoundingClientRect().height}px`,
        );
      }, ATRASO_MS);
    }

    caixa.querySelector("[data-fechar]")?.addEventListener("click", () => fechar(14));
    caixa.querySelector("[data-entrar]")?.addEventListener("click", () => fechar(60));
  }
</script>
