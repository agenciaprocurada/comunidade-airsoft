---
import Base from "../layouts/Base.astro";
import Botao from "./Botao.astro";

/**
 * Placeholder para rotas já linkadas na navegação mas ainda não construídas.
 * Sempre noindex: página vazia indexada prejudica o domínio inteiro.
 */
interface Props {
  titulo: string;
  descricao: string;
  entrega?: string;
}

const { titulo, descricao, entrega } = Astro.props;
---

<Base titulo={titulo} descricao={descricao} semIndexar={true}>
  <div class="mx-auto max-w-[68ch] px-5 py-24 md:px-12">
    <p class="rotulo">Em construção</p>
    <h1
      class="mt-4 font-display text-4xl font-extrabold uppercase italic leading-[0.95] md:text-5xl"
    >
      {titulo}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-texto-2">{descricao}</p>
    {
      entrega && (
        <p class="mt-3 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400">
          Previsto para: {entrega}
        </p>
      )
    }
    <div class="mt-8 flex flex-wrap gap-3">
      <Botao href="/campos">Ver campos</Botao>
      <Botao href="/guias" variante="secundario">Ler os guias</Botao>
    </div>
  </div>
</Base>
