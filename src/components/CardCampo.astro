---
import Etiqueta from "./Etiqueta.astro";
import { ROTULO_TERRENO, ROTULO_MODALIDADE, faixaDeValor } from "../lib/uf";

interface Props {
  campo: {
    id: string;
    data: {
      nome: string;
      descricao: string;
      uf: string;
      cidade: string;
      cidade_slug: string;
      terreno: string[];
      valor_min?: number;
      valor_max?: number;
      aceita_iniciante?: boolean;
      tem_aluguel?: boolean;
      verificado: boolean;
      modalidade: string;
      precos?: string;
      google_nota?: number;
      google_avaliacoes?: number;
      fotos?: { src: string; alt: string }[];
    };
  };
}

const { campo } = Astro.props;
const d = campo.data;
const url = `/campos/${d.uf.toLowerCase()}/${d.cidade_slug}/${campo.id}`;
const capa = d.fotos?.[0];
---

<!--
  O card inteiro e clicavel por "stretched link": o link do titulo estica um
  ::after por cima de todo o article. E a unica forma valida, porque <a> dentro
  de <a> nao existe em HTML, e de quebra deixa UM link por card no lugar dos
  tres que apontavam para a mesma ficha.
-->
<article
  class="moldura-tatica group relative isolate flex flex-col border border-borda bg-papel transition-colors focus-within:border-oliva-500 hover:border-oliva-500"
>
  <div class="flex items-start justify-between gap-3 p-5 pb-3">
    <h3 class="font-display text-xl font-bold uppercase leading-tight tracking-[0.02em]">
      <a
        href={url}
        class="transition-colors after:absolute after:inset-0 after:content-[''] hover:text-oliva-300"
      >
        {d.nome}
      </a>
    </h3>
    {d.verificado && <Etiqueta tom="ok" check>Verificado</Etiqueta>}
  </div>

  <p
    class="flex items-center gap-1.5 px-5 pb-4 font-dado text-[11px] uppercase tracking-[0.16em] text-oliva-400"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="h-3.5 w-3.5 shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
      <circle cx="12" cy="10" r="2.5" />
    </svg>
    {d.cidade} - {d.uf}

    {
      d.google_nota != null && (
        <>
          <span aria-hidden="true" class="text-borda-forte">
            ·
          </span>
          <span
            class="flex items-center gap-1 text-latao"
            title="Avaliação pública no Google, não uma nota da Comunidade Airsoft"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="h-3 w-3 shrink-0"
              fill="currentColor"
            >
              <path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.2 3.3L7 14.3l-5-4.9 7-.9z" />
            </svg>
            <span class="sr-only">Nota no Google:</span>
            {d.google_nota.toFixed(1).replace(".", ",")}
            {d.google_avaliacoes != null && ` (${d.google_avaliacoes})`}
          </span>
        </>
      )
    }
  </p>

  <div class="block overflow-hidden border-y border-borda" aria-hidden="true">
    {
      capa ? (
        <img
          src={capa.src}
          alt=""
          loading="lazy"
          decoding="async"
          width="600"
          height="360"
          class="h-44 w-full object-cover opacity-85 transition duration-300 group-hover:scale-[1.03] group-hover:opacity-100"
        />
      ) : (
        /* Sem foto ainda: bloco curto e assumido, não um vazio. */
        <div class="grade-tatica flex h-24 w-full items-center justify-center gap-2 bg-oliva-050">
          <svg
            aria-hidden="true"
            viewBox="0 0 48 48"
            class="h-5 w-5 text-oliva-400/60"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <circle cx="24" cy="24" r="14" />
            <path d="M24 4v10M24 34v10M4 24h10M34 24h10" stroke-linecap="square" />
          </svg>
          <span class="font-dado text-[10px] uppercase tracking-[0.2em] text-oliva-400/80">
            Sem foto
          </span>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="line-clamp-3 text-base leading-relaxed text-texto-2">
      {d.descricao}
    </p>

    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      <Etiqueta tom={d.modalidade === "airsoft" ? "neutro" : "info"}>
        {ROTULO_MODALIDADE[d.modalidade] ?? d.modalidade}
      </Etiqueta>
      {d.terreno.map((t) => <Etiqueta>{ROTULO_TERRENO[t] ?? t}</Etiqueta>)}
      {d.aceita_iniciante && <Etiqueta tom="info">Aceita iniciante</Etiqueta>}
      {d.tem_aluguel && <Etiqueta tom="info">Tem aluguel</Etiqueta>}
    </div>
  </div>

  <div class="flex items-center justify-between border-t border-borda px-5 py-3">
    <span
      class="line-clamp-1 min-w-0 font-dado text-[13px] tracking-[0.14em] text-oliva-400"
      title={faixaDeValor(d.valor_min, d.valor_max, d.precos)}
    >
      {faixaDeValor(d.valor_min, d.valor_max, d.precos)}
    </span>
    <span
      aria-hidden="true"
      class="shrink-0 font-display text-base font-bold uppercase tracking-wide text-oliva-500 transition-colors group-hover:text-oliva-300"
    >
      Ver campo
    </span>
  </div>
</article>
