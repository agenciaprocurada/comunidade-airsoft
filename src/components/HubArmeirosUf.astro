---
/**
 * Hub estadual de armeiros — /armeiros/[uf].
 *
 * Mesmo papel de SEO dos hubs de campo e de loja: captura "armeiro de
 * airsoft em [estado]". Vive em componente porque divide a rota
 * /armeiros/[slug] com a ficha do armeiro.
 *
 * O bloco de "atendem por envio" no fim existe para o caso mais comum
 * deste diretório: o estado tem um ou dois armeiros e nenhum atende o
 * serviço que a pessoa precisa. Sem essa saída, o hub de um estado
 * vazio é um beco.
 */
import Base from "../layouts/Base.astro";
import CardArmeiro from "./CardArmeiro.astro";
import Trilha from "./Trilha.astro";
import { NOME_UF, noEstado } from "../lib/uf";

interface Props {
  sigla: string;
  armeiros: any[];
  /** Total nacional de armeiros que recebem réplica pelo correio. */
  totalEnvioNacional: number;
}

const { sigla, armeiros, totalEnvioNacional } = Astro.props;
const nomeUf = NOME_UF[sigla] ?? sigla;

const cidades = [...new Set(armeiros.map((a) => a.data.cidade).filter(Boolean))].sort(
  (a, b) => a.localeCompare(b, "pt-BR"),
);

const comEnvio = armeiros.filter((a) => a.data.atende_envio).length;

const titulo = `Armeiro de airsoft ${noEstado(sigla)} (${sigla})`;
const descricao = `${armeiros.length} ${
  armeiros.length === 1 ? "armeiro" : "armeiros"
} de airsoft ${noEstado(sigla)}${
  cidades.length ? `: ${cidades.slice(0, 4).join(", ")}` : ""
}. Manutenção, upgrade e conserto de réplica — com contato direto.`.slice(0, 160);
---

<Base titulo={titulo} descricao={descricao}>
  <div class="mx-auto max-w-[1240px] px-5 py-8 md:px-12 md:py-12">
    <Trilha itens={[{ href: "/armeiros", texto: "Armeiros" }, { texto: nomeUf }]} />

    <header class="mt-8 border-b border-borda pb-8">
      <h1
        class="font-display text-4xl font-extrabold uppercase italic leading-[0.95] md:text-6xl"
      >
        Armeiros de airsoft<br />{noEstado(sigla)}
      </h1>
      <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-texto-2">
        {descricao}
      </p>
      {
        comEnvio > 0 && (
          <p class="mt-3 max-w-[60ch] text-base leading-relaxed text-texto-2">
            {comEnvio === 1
              ? "1 deles também recebe réplica pelo correio."
              : `${comEnvio} deles também recebem réplica pelo correio.`}
          </p>
        )
      }
    </header>

    <div class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {armeiros.map((armeiro) => <CardArmeiro armeiro={armeiro} />)}
    </div>

    <section class="mt-12 border-t border-borda pt-8">
      <h2 class="mb-4 font-display text-2xl font-bold uppercase">
        Não achou quem mexe na sua réplica?
      </h2>
      <p class="max-w-[65ch] leading-relaxed text-texto-2">
        Boa parte do serviço de armeiro no Brasil é feita pelo correio: você
        manda a gearbox ou a réplica inteira e recebe de volta.
        {
          totalEnvioNacional > 0 && (
            <>
              {" "}
              Hoje {totalEnvioNacional}{" "}
              {totalEnvioNacional === 1
                ? "armeiro do diretório atende"
                : "armeiros do diretório atendem"}{" "}
              assim, de qualquer estado.
            </>
          )
        }
      </p>
      <p class="mt-5">
        <a
          href="/armeiros"
          class="inline-block border border-borda bg-papel px-4 py-2 text-base transition-colors hover:border-oliva-500 hover:text-oliva-500"
        >
          Ver todos os armeiros do Brasil
        </a>
      </p>
    </section>
  </div>
</Base>
