---
/**
 * Gaveta de criação — "cadastrar réplica", "abrir operação",
 * "criar equipe", "editar meus dados".
 *
 * Antes cada tela tinha a sua: umas com um `›` seguido de texto,
 * outras com hexágono e borda tracejada. A ação de criar é a mesma
 * em toda a área; agora tem uma forma só.
 *
 * `aberta` decide o estado inicial — abre sozinha quando a lista está
 * vazia ou quando o formulário voltou com erro, que é onde a pessoa
 * precisa estar.
 */
interface Props {
  titulo: string;
  descricao?: string;
  aberta?: boolean;
  /** Desenho do hexágono: `mais` para criar, `lapis` para editar. */
  icone?: "mais" | "lapis";
  id?: string;
  class?: string;
}

const {
  titulo,
  descricao,
  aberta = false,
  icone = "mais",
  id,
  class: classe,
} = Astro.props;

const MIOLO = {
  mais: "M12 8.5v7M8.5 12h7",
  lapis: "m9 15 1-3 5-5 2 2-5 5z",
} as const;
---

<details
  id={id}
  open={aberta}
  class:list={["gaveta border border-dashed border-borda-forte bg-papel/40", classe]}
>
  <summary
    class="flex cursor-pointer list-none items-center gap-4 px-5 py-4 transition-colors duration-150 hover:bg-hud/[0.04] focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-hud"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="h-9 w-9 shrink-0 text-hud"
    >
      <path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7z" stroke-linejoin="miter"></path>
      <path d={MIOLO[icone]} stroke-linecap="square" stroke-linejoin="miter"></path>
    </svg>

    <span class="min-w-0 flex-1">
      <span class="block text-[1.0625rem] font-semibold leading-tight text-tinta">
        {titulo}
      </span>
      {
        descricao && (
          <span class="mt-1 block text-[0.9375rem] leading-snug text-texto-2">
            {descricao}
          </span>
        )
      }
    </span>

    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class="chevron h-5 w-5 shrink-0 text-texto-2"
    >
      <path d="m6 9 6 6 6-6" stroke-linecap="square"></path>
    </svg>
  </summary>

  <div class="border-t border-borda px-5 py-6 sm:px-7">
    <slot />
  </div>
</details>
