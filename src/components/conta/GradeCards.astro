---
/**
 * Grade dos cards da área logada.
 *
 * `auto-fill` + `minmax` resolve a responsividade sem ponto de quebra:
 * o espaço disponível decide o número de colunas. A largura mínima é
 * a mesma em toda a área — é o que faz réplicas, operações, equipes e
 * páginas terem o mesmo ritmo.
 *
 * `auto-fill` e não `auto-fit`: com um item só, o `auto-fit` colapsa
 * as trilhas vazias e estica o card na largura inteira. Eventos,
 * equipes e páginas quase sempre têm um ou dois itens — o card tem
 * que manter o tamanho, não virar uma faixa.
 */
interface Props {
  /** Largura mínima do card. Só mude com motivo. */
  minimo?: string;
  class?: string;
}

const { minimo = "19rem", class: classe } = Astro.props;
---

<ul
  class:list={["grid gap-4", classe]}
  style={`grid-template-columns: repeat(auto-fill, minmax(${minimo}, 1fr));`}
>
  <slot />
</ul>
